#!/usr/bin/env bash
set -euo pipefail

# script/dbsc_probe — Device Bound Session Credentials (DBSC) HTTP-contract probe.
#
# This script confirms the *Rails-side* DBSC HTTP contract from a shell:
#   1. Does an authenticated edge response advertise `Secure-Session-Registration`?
#   2. Does the DBSC registration/refresh endpoint exist and react to the headers
#      Chromium is expected to send (`Secure-Session-Response`, `Sec-Secure-Session-Id`)?
#
# It deliberately CANNOT confirm that Chromium actually exercised DBSC: device key
# generation, TPM / Secure Enclave usage, and the browser-internal DBSC state machine
# are invisible from curl. Dummy JWT proofs here are expected to be REJECTED; a clean
# rejection still proves the endpoint is reachable and parses DBSC headers. To confirm
# the browser really used DBSC, watch the Rails log for `[dbsc] ...` lines emitted when
# a real Chrome sends `Secure-Session-Response` / `Sec-Secure-Session-Id`.
#
# Usage:
#   script/dbsc_probe https://id.umaxica.app
#   script/dbsc_probe http://localhost:3000
#
# The base URL is required and the surface host must match the route constraints
# (e.g. sign endpoints are constrained to id.umaxica.{app,org,com}).

base_url="${1:-}"

if [[ -z "${base_url}" ]]; then
  echo "usage: script/dbsc_probe BASE_URL" >&2
  exit 1
fi

if ! command -v curl >/dev/null 2>&1; then
  echo "curl is required" >&2
  exit 1
fi

base_url="${base_url%/}"
cookie_jar="$(mktemp)"
seed_body="$(mktemp)"
trap 'rm -f "${cookie_jar}" "${seed_body}"' EXIT

# Endpoints that advertise DBSC registration on authenticated responses
# (issue_dbsc_registration_header_for / issue_preference_dbsc_registration_header_for).
registration_issuer_paths=(
  "/edge/v0/token/check"
  "/edge/v0/cookie"
)

# DBSC registration / refresh endpoints (POST :create).
#   /edge/v0/token/dbsc — auth (sign + acme token DBSC)
#   /edge/v0/dbsc       — preference (acme + core preference DBSC)
dbsc_endpoint_paths=(
  "/edge/v0/token/dbsc"
  "/edge/v0/dbsc"
)

# Returns the leading header block of a response (stops at the first blank line).
fetch_header_block() {
  local path="$1"
  # Read the whole response (never close curl's pipe early — that would surface as a
  # curl write error under `set -o pipefail`) and print only the leading header block.
  curl -sS --max-time 15 --connect-timeout 5 --include \
    --cookie "${cookie_jar}" --cookie-jar "${cookie_jar}" \
    "${base_url}${path}" 2>/dev/null \
    | awk 'BEGIN { in_headers = 1 } in_headers { print } /^\r?$/ { in_headers = 0 }' || true
}

extract_csrf_token() {
  perl -ne 'if (m/<meta name="csrf-token" content="([^"]+)"/) { print "$1\n"; exit }' "$1" 2>/dev/null || true
}

check_registration_header() {
  local path="$1"
  local header_dump
  header_dump="$(fetch_header_block "${path}")"

  if [[ -z "${header_dump}" ]]; then
    echo "  ${path}: no response (host/route mismatch or server down)"
    return
  fi

  local status_line
  status_line="$(printf '%s\n' "${header_dump}" | head -n 1 | tr -d '\r')"
  echo "  ${path}: ${status_line}"

  if printf '%s\n' "${header_dump}" | grep -qi '^Secure-Session-Registration:'; then
    echo "    Secure-Session-Registration: PRESENT"
  else
    echo "    Secure-Session-Registration: missing (expected unless the request is authenticated)"
  fi
  if printf '%s\n' "${header_dump}" | grep -qiE '^Set-Cookie: .*(dbsc|Secure-Session)'; then
    echo "    Set-Cookie: DBSC cookie PRESENT"
  else
    echo "    Set-Cookie: no DBSC cookie"
  fi
}

# POST dummy DBSC headers and report status + any DBSC response headers.
post_dummy() {
  local label="$1"
  local path="$2"
  local csrf_token="$3"
  shift 3
  local -a extra_headers=("$@")
  local body_file
  body_file="$(mktemp)"
  local header_file
  header_file="$(mktemp)"

  local -a curl_args=(
    -sS --max-time 15 --connect-timeout 5 --include
    --cookie "${cookie_jar}" --cookie-jar "${cookie_jar}"
    -H "Content-Type: application/json"
  )
  if [[ -n "${csrf_token}" ]]; then
    curl_args+=(-H "X-CSRF-Token: ${csrf_token}" -H "Referer: ${base_url}/")
  fi
  curl_args+=("${extra_headers[@]}")
  curl_args+=(-d '{}' -D "${header_file}" -o "${body_file}" -w '%{http_code}' "${base_url}${path}")

  local code
  code="$(curl "${curl_args[@]}" 2>/dev/null || echo "000")"
  echo "  POST ${path} [${label}] -> HTTP ${code}"

  local dbsc_resp_headers
  dbsc_resp_headers="$(grep -iE '^(Secure-Session-Challenge|Sec-Secure-Session-Challenge|Sec-Session-Challenge|Secure-Session-Registration):' "${header_file}" | tr -d '\r' || true)"
  if [[ -n "${dbsc_resp_headers}" ]]; then
    printf '    %s\n' "${dbsc_resp_headers}"
  fi
  if [[ "${code}" == "000" ]]; then
    echo "    unreachable (host/route mismatch or server down)"
  elif [[ "${code}" == "404" ]]; then
    echo "    endpoint not mounted on this surface"
  fi

  rm -f "${body_file}" "${header_file}"
}

echo "== DBSC probe against ${base_url} =="
echo
echo "Note: curl confirms the Rails DBSC HTTP contract, NOT whether Chromium used"
echo "hardware-backed DBSC credentials. Dummy proofs below are expected to be rejected."
echo

# Seed cookies + CSRF from the home page.
curl -sS --max-time 15 --connect-timeout 5 --include \
  --cookie "${cookie_jar}" --cookie-jar "${cookie_jar}" "${base_url}/" \
  -o "${seed_body}" >/dev/null 2>&1 || true
csrf_token="$(extract_csrf_token "${seed_body}")"

echo "== A. Secure-Session-Registration advertisement (GET, auth-gated) =="
echo "The registration header is only emitted to authenticated, not-yet-DBSC-bound"
echo "sessions. Unauthenticated probes correctly report 'missing'."
check_registration_header "/"
for path in "${registration_issuer_paths[@]}"; do
  check_registration_header "${path}"
done
echo

echo "== B. Registration endpoint reachability (POST Secure-Session-Response) =="
for path in "${dbsc_endpoint_paths[@]}"; do
  post_dummy "registration" "${path}" "${csrf_token}" \
    -H 'Secure-Session-Response: dummy.registration.jwt' \
    -H 'Sec-Secure-Session-Response: dummy.registration.jwt'
done
echo

echo "== C. Refresh endpoint reachability (POST Sec-Secure-Session-Id) =="
echo "A bound-cookie refresh with no proof should answer 403 + Secure-Session-Challenge;"
echo "with a bad proof it should answer a deterministic 4xx rejection."
for path in "${dbsc_endpoint_paths[@]}"; do
  post_dummy "refresh-challenge" "${path}" "${csrf_token}" \
    -H 'Sec-Secure-Session-Id: dev-dbsc-session-1' \
    -H 'Secure-Session-Id: dev-dbsc-session-1'
  post_dummy "refresh-badproof" "${path}" "${csrf_token}" \
    -H 'Sec-Secure-Session-Id: dev-dbsc-session-1' \
    -H 'Secure-Session-Response: dummy.refresh.jwt'
done
echo

echo "== D. CSRF note =="
if [[ -n "${csrf_token}" ]]; then
  echo "A CSRF meta token was found on / and forwarded as X-CSRF-Token."
else
  echo "No CSRF meta token found on /. The edge JSON DBSC endpoints declare an open"
  echo "authentication mode and skip forgery protection for the DBSC ceremony, so this"
  echo "is expected; the probe does not attempt to bypass CSRF on protected endpoints."
fi
echo

echo "== How to confirm Chromium actually used DBSC =="
echo "Watch the Rails log while a real Chrome hits an authenticated edge endpoint:"
echo "  [dbsc] registration header issued path=/edge/v0/token/dbsc challenge=..."
echo "  [dbsc] POST /edge/v0/token/dbsc headers={\"Secure-Session-Response\"=>\"eyJ...\"}"
echo "  [dbsc] registration success path=/edge/v0/token/dbsc session_id=..."
echo "  [dbsc] challenge issued path=/edge/v0/token/dbsc session_id=..."
echo "Real Chrome request headers to look for: Secure-Session-Response,"
echo "Sec-Secure-Session-Id, Secure-Session-Id (and legacy Sec-Session-* aliases)."
echo
echo "Limit: shell dummy headers cannot prove device-key / TPM / Secure Enclave or the"
echo "Chrome-internal DBSC state machine actually ran. Only a real browser can."
