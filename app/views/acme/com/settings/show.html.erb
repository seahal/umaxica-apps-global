<% content_for :page_title, t("sign.app.settings.show.page_title") %>

<h1><%= t("sign.app.settings.show.page_title") %></h1>

<p><%= link_to "Identity", acme_com_identity_path(ri: params[:ri]) %></p>

<section>
  <h2><%= t("sign.app.settings.show.security_settings") %></h2>
  <ul>
    <%# Credential ceremony remains on sign/id. %>
    <li><%= link_to t("controller.sign.app.setting.index.passkey"), acme_com_settings_passkeys_path(ri: params[:ri]) %></li>
    <li><%= link_to t("controller.sign.app.setting.index.secret_credential"), acme_com_settings_secrets_path(ri: params[:ri]) %></li>
    <li><%= link_to t("sign.app.settings.show.mfa"), sign_com_settings_mfa_challenge_path(ri: params[:ri]) %></li>
  </ul>
</section>
<br />
<section>
  <h2><%= t("sign.app.settings.show.account_settings") %></h2>
  <ul>
    <%# Contact management belongs to acme/www; registration ceremonies remain on sign/id. %>
    <li><%= link_to t("controller.sign.app.setting.index.email"), acme_com_settings_emails_path(ri: params[:ri]) %></li>
    <li><%= link_to t("controller.sign.app.setting.index.telephone"), acme_com_settings_telephones_path(ri: params[:ri]) %></li>
    <li><%= link_to t("controller.sign.app.setting.index.birthdate"), sign_com_settings_birthdate_path(ri: params[:ri]) %></li>
    <li><%= link_to t("controller.sign.app.setting.index.session"), acme_com_settings_sessions_path %></li>
    <li><%= link_to t("sign.settings.connections.index.page_title"), acme_com_settings_connections_path(ri: params[:ri]) %></li>
    <li><%= link_to t("controller.sign.app.setting.index.activity"), acme_com_settings_activities_path %></li>
  </ul>
</section>
<br />
<section>
  <h2><%= t("sign.app.settings.show.others") %></h2>
  <ul>
    <li><%= link_to t("sign.app.settings.show.logout"), edit_acme_com_sign_out_path(ri: params[:ri]) %></li>
    <li><%= link_to t("sign.app.settings.show.withdrawal"), new_acme_com_settings_withdrawal_path %></li>
  </ul>
</section>
