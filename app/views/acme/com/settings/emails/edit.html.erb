<% content_for :page_title, t("sign.com.settings.email.edit.title") %>
<div>
  <div>
    <h1><%= t("sign.com.settings.email.edit.title") %></h1>
  </div>

  <div>
    <div>
      <p><%= @user_email.address %></p>
    </div>

    <%= form_with model: @user_email,
                  url: acme_com_settings_email_path(@user_email.public_id, ri: params[:ri]),
                  method: :patch,
                  scope: :visitor_email do |f| %>
      <div>
        <label>
          <%= t("sign.com.settings.email.edit.always_on") %>
        </label>
        <p><%= t("sign.com.settings.email.edit.always_on_description") %></p>
      </div>

      <div>
        <%= f.check_box :promotional %>
        <%= f.label :promotional, t("sign.com.settings.email.edit.promotional_label") %>
        <p><%= t("sign.com.settings.email.edit.promotional_description") %></p>
      </div>

      <div>
        <%= f.check_box :notifiable %>
        <%= f.label :notifiable, t("sign.com.settings.email.edit.notifiable_label") %>
        <p><%= t("sign.com.settings.email.edit.notifiable_description") %></p>
      </div>

      <div>
        <%= render "shared/cloudflare_turnstile_stealth" %>
      </div>

      <div>
        <%= f.submit t("sign.com.settings.email.edit.save") %>
      </div>
    <% end %>

    <div>
      <%= button_to t("sign.app.settings.email.index.delete"),
                    acme_com_settings_email_path(@user_email, ri: params[:ri]),
                    method: :delete,
                    data: { turbo_confirm: t("sign.app.settings.email.index.delete_confirm") } %>
    </div>
    <div>
      <%= link_to t("sign.app.common.cancel"), acme_com_settings_emails_path(ri: params[:ri]) %>
    </div>
  </div>
</div>
