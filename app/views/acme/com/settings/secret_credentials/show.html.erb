<% content_for :page_title, t("sign.app.settings.secret_credentials.show.title", default: "Secret") %>

<h3><%= @secret_credential.name %></h3>
<dl>
  <dt><%= t("activerecord.attributes.user_secret_credential.created_at") %></dt>
  <dd><%= l @secret_credential.created_at, format: :long %></dd>
  <dt><%= t("activerecord.attributes.user_secret_credential.last_used_at") %></dt>
  <dd><%= @secret_credential.last_used_at ? l(@secret_credential.last_used_at, format: :long) : t("defaults.never") %></dd>
</dl>

<%= link_to t("actions.back"), acme_com_settings_secret_credentials_path(ri: params[:ri]) %>
<%= link_to t("actions.edit"), edit_acme_com_settings_secret_credential_path(@secret_credential, ri: params[:ri]) %>
