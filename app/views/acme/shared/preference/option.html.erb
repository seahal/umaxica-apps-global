<% surface = controller_path.split("/").second %>
<% screen = @preference_screen.presence || params[:preference_screen].to_s %>
<% model = instance_variable_get("@preference_#{screen}") %>
<% option_class = model.class.reflect_on_association(:option)&.klass %>
<% option_type = screen.to_sym %>
<% title_text = t("acme.#{surface}.preference.#{screen}.edit.heading",
                  default: t("acme.#{surface}.preferences.#{screen}_settings", default: screen.titleize)) %>
<% content_for :page_title, title_text %>

<section>
  <div>
    <%= link_to t("acme.#{surface}.preferences.regions.back_link",
                  default: t("acme.#{surface}.preferences.back_to_settings")),
                (screen == "region" ? public_send("acme_#{surface}_preference_path", lx: params[:lx], ri: params[:ri]) : public_send("edit_acme_#{surface}_preference_region_path", lx: params[:lx], ri: params[:ri])) %>
  </div>

  <h1><%= title_text %></h1>
  <p><%= t("acme.#{surface}.preference.#{screen}.edit.description", default: "") %></p>

  <%= form_with model: model,
                scope: :"preference_#{screen}",
                url: public_send("acme_#{surface}_preference_#{screen}_path", ri: params[:ri]),
                method: :patch do |f| %>
    <div>
      <%= f.label :option_id,
                  t("acme.#{surface}.preference.#{screen}.edit.#{screen}_label", default: title_text) %>
      <div>
        <%= f.select :option_id,
                     options_for_select(
                       option_class.order(:id).filter_map { |option|
                         option_name = option.name.to_s
                         next if option_name.blank?

                         default_label = option_type == :region ? option_name.upcase : option_name.tr("_", " ").titleize
                         option_key = option_type == :timezone ? option_name.tr("/", "_").upcase : option_name
                         translation_key =
                           if option_type == :timezone
                             "acme.#{surface}.preference.locale.edit.timezone_options.#{option_key}"
                           else
                             "acme.#{surface}.preference.#{screen}.options.#{option_key}"
                           end
                         [t(translation_key,
                            default: default_label), option.id]
                       },
                       model.option_id,
                     ),
                     { include_blank: false },
                     {} %>
      </div>
    </div>

    <div>
      <%= f.submit t("acme.#{surface}.preferences.update_settings"),
                   data: { turbo_submits_with: t("acme.#{surface}.preferences.submitting") } %>
      <% unless screen == "region" %>
        <%= link_to t("acme.#{surface}.preferences.region_settings"),
                    public_send("edit_acme_#{surface}_preference_region_path", lx: params[:lx], ri: params[:ri]) %>
      <% end %>
    </div>
  <% end %>

  <% if screen == "region" %>
    <div>
      <% %i(timezone language currency calendar clock).each do |linked_screen| %>
        <%= link_to public_send("edit_acme_#{surface}_preference_#{linked_screen}_path", lx: params[:lx], ri: params[:ri]) do %>
          <div>
            <span><%= t("acme.#{surface}.preferences.region.#{linked_screen == :calendar ? :date_format : linked_screen == :clock ? :time_format : linked_screen}.link",
                        default: linked_screen.to_s.tr("_", " ").titleize) %></span>
          </div>
        <% end %>
      <% end %>
    </div>
  <% end %>
</section>
