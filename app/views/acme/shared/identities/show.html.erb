<% content_for :page_title, page_title %>

<h1><%= title page_title %></h1>

<p>Signed in</p>

<section>
  <h2>Account</h2>
  <ul>
    <% case surface %>
    <% when :app %>
      <li><%= link_to t("sign.app.settings.show.logout"), new_acme_app_sign_out_path(ri: params[:ri]) %></li>
    <% when :com %>
      <li><%= link_to t("sign.app.settings.show.logout"), new_acme_com_sign_out_path(ri: params[:ri]) %></li>
    <% when :org %>
      <li><%= link_to t("sign.app.settings.show.logout"), new_acme_org_sign_out_path(ri: params[:ri]) %></li>
    <% end %>
  </ul>
</section>
