<% content_for :page_title, page_title %>

<h1><%= title page_title %></h1>

<p>Signed in</p>

<section>
  <h2>Security</h2>
  <ul>
    <% case surface %>
    <% when :app %>
      <li><%= link_to t("controller.sign.app.setting.index.passkey"), acme_app_settings_passkeys_path(ri: params[:ri]) %></li>
      <li><%= link_to t("controller.sign.app.setting.index.totp"), acme_app_settings_totps_path(ri: params[:ri]) %></li>
      <li><%= link_to t("controller.sign.app.setting.index.secret_credential"), acme_app_settings_secrets_path(ri: params[:ri]) %></li>
    <% when :com %>
      <li><%= link_to t("controller.sign.app.setting.index.passkey"), acme_com_settings_passkeys_path(ri: params[:ri]) %></li>
      <li><%= link_to t("controller.sign.app.setting.index.secret_credential"), acme_com_settings_secrets_path(ri: params[:ri]) %></li>
    <% when :org %>
      <li><%= link_to t("controller.sign.app.setting.index.passkey"), acme_org_settings_passkeys_path(ri: params[:ri]) %></li>
      <li><%= link_to t("controller.sign.app.setting.index.secret_credential"), acme_org_settings_secrets_path(ri: params[:ri]) %></li>
    <% end %>
  </ul>
</section>

<section>
  <h2>Identity</h2>
  <ul>
    <% case surface %>
    <% when :app %>
      <li><%= link_to t("controller.sign.app.setting.index.email"), acme_app_settings_emails_path(ri: params[:ri]) %></li>
      <li><%= link_to t("controller.sign.app.setting.index.telephone"), acme_app_settings_telephones_path(ri: params[:ri]) %></li>
      <li><%= link_to t("controller.sign.app.setting.index.session"), acme_app_settings_sessions_path(ri: params[:ri]) %></li>
    <% when :com %>
      <li><%= link_to t("controller.sign.app.setting.index.email"), acme_com_settings_emails_path(ri: params[:ri]) %></li>
      <li><%= link_to t("controller.sign.app.setting.index.telephone"), acme_com_settings_telephones_path(ri: params[:ri]) %></li>
      <li><%= link_to t("controller.sign.app.setting.index.session"), acme_com_settings_sessions_path(ri: params[:ri]) %></li>
    <% when :org %>
      <li><%= link_to t("controller.sign.app.setting.index.email"), acme_org_settings_emails_path(ri: params[:ri]) %></li>
      <li><%= link_to t("controller.sign.app.setting.index.telephone"), acme_org_settings_telephones_path(ri: params[:ri]) %></li>
      <li><%= link_to t("controller.sign.app.setting.index.session"), acme_org_settings_sessions_path(ri: params[:ri]) %></li>
    <% end %>
  </ul>
</section>

<section>
  <h2>Account</h2>
  <ul>
    <% case surface %>
    <% when :app %>
      <li><%= link_to t("sign.app.settings.show.logout"), acme_app_sign_out_path(ri: params[:ri]) %></li>
      <li><%= link_to t("sign.app.settings.show.withdrawal"), new_acme_app_settings_withdrawal_path(ri: params[:ri]) %></li>
    <% when :com %>
      <li><%= link_to t("sign.app.settings.show.logout"), acme_com_sign_out_path(ri: params[:ri]) %></li>
      <li><%= link_to t("sign.app.settings.show.withdrawal"), new_acme_com_settings_withdrawal_path(ri: params[:ri]) %></li>
    <% when :org %>
      <li><%= link_to t("sign.app.settings.show.logout"), acme_org_sign_out_path(ri: params[:ri]) %></li>
      <li><%= link_to t("sign.org.settings.show.withdrawal"), acme_org_settings_withdrawal_path(ri: params[:ri]) %></li>
    <% end %>
  </ul>
</section>
