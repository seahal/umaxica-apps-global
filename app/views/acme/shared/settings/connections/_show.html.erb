<% content_for :page_title, @connection.rp_name %>
<%= link_to t("sign.settings.connections.actions.back"), connections_path %>

<h1><%= @connection.rp_name %></h1>

<dl>
  <dt><%= t("sign.settings.connections.detail.client_id") %></dt>
  <dd><%= @connection.client_id %></dd>

  <dt><%= t("sign.settings.connections.detail.status") %></dt>
  <dd><%= connection_status_label(@connection) %></dd>

  <dt><%= t("sign.settings.connections.detail.domains") %></dt>
  <dd><%= @connection.rp_domain_text %></dd>

  <dt><%= t("sign.settings.connections.detail.scope") %></dt>
  <dd><%= connection_scopes_text(@connection) %></dd>

  <dt><%= t("sign.settings.connections.detail.last_used_at") %></dt>
  <dd><%= connection_last_used_text(@connection) %></dd>

  <dt><%= t("sign.settings.connections.detail.connected_at") %></dt>
  <dd><%= l(@connection.connected_at, format: :long) %></dd>

  <dt><%= t("sign.settings.connections.detail.active_tokens") %></dt>
  <dd><%= @active_token_count %></dd>

  <% if @connection.rp_client %>
    <dt><%= t("sign.settings.connections.detail.resource_type") %></dt>
    <dd><%= @connection.rp_client.resource_type %></dd>

    <dt><%= t("sign.settings.connections.detail.audience") %></dt>
    <dd><%= @connection.rp_client.aud %></dd>

    <dt><%= t("sign.settings.connections.detail.redirect_uris") %></dt>
    <dd>
      <ul>
        <% @connection.rp_client.redirect_uris.each do |redirect_uri| %>
          <li><code><%= redirect_uri %></code></li>
        <% end %>
      </ul>
    </dd>
  <% end %>
</dl>

<% if @connection.active? %>
  <%= button_to t("sign.settings.connections.actions.revoke"),
                connection_path_for(@connection),
                method: :delete,
                data: { turbo_confirm: t("sign.settings.connections.actions.revoke_confirm") } %>
<% end %>
