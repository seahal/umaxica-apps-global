<% surface = controller.controller_path.split("/").second %>
<% settings_path = public_send("acme_#{surface}_settings_path", ri: params[:ri]) %>
<% sessions_path = public_send("acme_#{surface}_settings_sessions_path", ri: params[:ri]) %>
<% others_path = public_send("others_acme_#{surface}_settings_sessions_path", ri: params[:ri]) %>
<% revoke_all_path = public_send("revoke_all_acme_#{surface}_settings_sessions_path", ri: params[:ri]) %>

<% content_for :page_title, "Sessions" %>
<%= link_to t("sign.#{surface}.settings.show.back", default: t("sign.app.settings.show.back")), settings_path %>
<% has_other_sessions = @sessions.any? { |session| session.public_id != current_session_public_id } %>
<% if has_other_sessions %>
  <div>
    <%= button_to t("sign.#{surface}.settings.sessions.revoke.others_button",
                    default: t("sign.app.settings.sessions.revoke.others_button")),
                  others_path,
                  method: :delete,
                  data: {
                    confirm: t("sign.#{surface}.settings.sessions.revoke.others_confirm",
                               default: t("sign.app.settings.sessions.revoke.others_confirm")),
                  } %>
    <%= button_to t("sign.#{surface}.settings.sessions.revoke.all_button",
                    default: t("sign.app.settings.sessions.revoke.all_button")),
                  revoke_all_path,
                  method: :delete,
                  data: {
                    confirm: t("sign.#{surface}.settings.sessions.revoke.all_confirm",
                               default: t("sign.app.settings.sessions.revoke.all_confirm")),
                  } %>
  </div>
<% end %>

<% if @sessions.any? %>
  <div>
    <table>
      <thead>
      <tr>
        <th>Session</th>
        <th>Kind</th>
        <th>Binding</th>
        <th>Last activity</th>
        <th>Created</th>
        <th>Refresh expires</th>
        <th></th>
      </tr>
      </thead>
      <tbody>
      <% @sessions.each do |session| %>
        <% current_session = current_session_record?(session) %>
        <% session_path = public_send("acme_#{surface}_settings_session_path", session.public_id, ri: params[:ri]) %>
        <tr class="<%= "bg-slate-50 font-semibold" if current_session %>">
          <td>
            <div>
              <span><%= session.public_id %></span>
              <% if current_session %>
                <span>current</span>
              <% end %>
            </div>
            <p><%= session.try(:user_token_status_id) || session.try(:staff_token_status_id) || session.try(:visitor_token_status_id) %></p>
          </td>
          <td><%= session.try(:user_token_kind_id) || session.try(:staff_token_kind_id) || session.try(:visitor_token_kind_id) %></td>
          <td><%= session.dbsc_enabled? ? "DBSC" : "NORMAL" %></td>
          <td><%= l(session.last_used_at || session.created_at, format: :short) %></td>
          <td><%= l(session.created_at, format: :short) %></td>
          <td><%= l(session.discarded_at, format: :short) %></td>
          <td>
            <% unless current_session %>
              <%= button_to "Revoke",
                            session_path,
                            method: :delete,
                            data: { confirm: "Revoke this session?" } %>
            <% end %>
          </td>
        </tr>
      <% end %>
      </tbody>
    </table>
  </div>
<% else %>
  <p>No active sessions were found.</p>
<% end %>
