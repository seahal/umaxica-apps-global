<% page_title t("acme.org.preferences.footer.home") %>
<section>
  <h1>
    Welcome to <%= ENV["BRAND_NAME"] %> (org)
  </h1>
  <p>
    <%= t("views.acme.org.roots.index.redirect_prompt", preference: t("acme.org.preferences.footer.preference")) %>
  </p>

  <ul>
    <li>
      <a
        href="https://<%= ENV['EDGE_STAFF_URL'] %>"
        data-turbo-frame="_top">
        <%= t("acme.org.preferences.footer.home") %>
      </a>
    </li>
    <li>
      <%= link_to t("acme.org.preferences.footer.preference"), acme_org_preference_path,
                  data: { turbo_frame: "_top" } %>
    </li>
  </ul>
</section>
