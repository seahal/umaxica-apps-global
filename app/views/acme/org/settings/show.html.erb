<% content_for :page_title, t("sign.org.settings.show.page_title") %>

<h1><%= t("sign.org.settings.show.page_title") %></h1>
<p><%= t("sign.org.settings.show.description") %></p>
<p><%= link_to "Identity", acme_org_identity_path(ri: params[:ri]) %></p>

<section>
  <h2><%= t("sign.app.settings.show.security_settings") %></h2>
  <ul>
    <%# Credential ceremony remains on sign/id. %>
    <li><%= link_to t("controller.sign.app.setting.index.passkey"), acme_org_settings_passkeys_path(ri: params[:ri]) %></li>
    <li><%= link_to t("controller.sign.app.setting.index.secret_credential"), acme_org_settings_secrets_path(ri: params[:ri]) %></li>
  </ul>
</section>

<section>
  <h2><%= t("sign.app.settings.show.account_settings") %></h2>
  <ul>
    <%# Contact management belongs to acme/www; registration ceremonies remain on sign/id. %>
    <li><%= link_to t("controller.sign.app.setting.index.email"), acme_org_settings_emails_path(ri: params[:ri]) %></li>
    <li><%= link_to t("controller.sign.app.setting.index.telephone"), acme_org_settings_telephones_path(ri: params[:ri]) %></li>
    <li><%= link_to t("controller.sign.app.setting.index.birthdate"), sign_org_settings_birthdate_path(ri: params[:ri]) %></li>
    <li><%= link_to t("controller.sign.app.setting.index.session"), acme_org_settings_sessions_path %></li>
    <li><%= link_to t("controller.sign.app.setting.index.activity"), acme_org_settings_activities_path %></li>
  </ul>
</section>

<section>
  <h2><%= t("sign.app.settings.show.others") %></h2>
  <ul>
    <li><%= link_to t("sign.app.settings.show.logout"), edit_acme_org_sign_out_path(ri: params[:ri]) %></li>
    <li><%= link_to t("sign.org.settings.show.withdrawal"), acme_org_settings_withdrawal_path %></li>
    <li>
      <%# Operator lifecycle requests remain out of scope for this settings shell cleanup. %>
      <%= link_to t("sign.org.settings.show.operator_lifecycle_requests"),
                  sign_org_settings_operator_lifecycle_requests_path %>
    </li>
  </ul>
</section>
