<% content_for :page_title, "Acme App" %>
<!doctype html>
<html lang="<%= I18n.locale %>">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Acme App</title>
    <style>
      :root {
        color-scheme: light dark;
        font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        line-height: 1.5;
      }

      body {
        margin: 0;
        min-height: 100vh;
        color: #111827;
        background: #f7f8f7;
      }

      main {
        display: grid;
        min-height: 100vh;
        place-items: center;
        padding: 2rem;
      }

      section {
        width: min(100%, 42rem);
      }

      h1 {
        margin: 0 0 0.75rem;
        color: #0f172a;
        font-size: clamp(2rem, 5vw, 4rem);
        font-weight: 700;
        letter-spacing: 0;
        line-height: 1;
      }

      p {
        margin: 0;
        color: #374151;
        font-size: 1rem;
      }
    </style>
  </head>
  <body>
    <main>
      <section aria-labelledby="acme-app-root-title">
        <h1 id="acme-app-root-title">Acme App</h1>
        <p>Thin landing endpoint.</p>
        <p><a href="<%= acme_app_oidc_authorization_url(ri: params[:ri]) %>">Sign in</a></p>
      </section>
    </main>
  </body>
</html>
