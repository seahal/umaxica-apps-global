<% content_for :page_title, "Session limit" %>

<main>
  <h1>Session limit</h1>

  <p>
    Your credential was verified, but this account already has the maximum number of live sessions.
    Revoke one existing session to continue signing in.
  </p>

  <% if @form_error.present? %>
    <p role="alert"><%= @form_error %></p>
  <% end %>

  <% if @form_notice.present? %>
    <p><%= @form_notice %></p>
  <% end %>

  <%= form_with url: acme_app_session_limit_resolution_path,
                method: :patch,
                data: { turbo: false } do |form| %>
    <%= hidden_field_tag :resolution_challenge, @resolution_challenge %>

    <ul>
      <% @sessions.each do |session_record| %>
        <li>
          <p>
            Session
            <% if session_record.restricted? %>
              <span>Restricted</span>
            <% else %>
              <span>Normal</span>
            <% end %>
          </p>
          <p>Created <%= l(session_record.created_at, format: :short) %></p>
          <% if session_record.last_used_at.present? %>
            <p>Last used <%= l(session_record.last_used_at, format: :short) %></p>
          <% end %>
          <label>
            <%= radio_button_tag :session_ref, SessionLimitResolutionTokenRef.issue(session_record), false %>
            Revoke this session
          </label>
        </li>
      <% end %>
    </ul>

    <%= form.submit "Revoke and continue" %>
  <% end %>

  <%= button_to "Cancel sign-in",
                acme_app_session_limit_resolution_path(resolution_challenge: @resolution_challenge),
                method: :delete,
                form: { data: { turbo: false } } %>
</main>
