<% content_for :page_title, "Passkeys" %>
<%= link_to t("sign.app.settings.show.back"), acme_app_settings_path(ri: params[:ri]) %>

<div>
  <%= button_to t("controller.sign.app.v1.passkey.new"),
                enrollment_acme_app_settings_passkeys_path(ri: params[:ri]),
                method: :post %>
</div>

<table>
  <thead>
  <tr>
    <th scope="col"><%= t("activerecord.attributes.user_passkey.description") %></th>
    <th scope="col"><%= t("activerecord.attributes.user_passkey.created_at") %></th>
    <th scope="col"><%= t("activerecord.attributes.user_passkey.last_used_at") %></th>
    <th scope="col"><%= t("views.sign.app.settings.passkeys.index.actions") %></th>
  </tr>
  </thead>
  <tbody>
  <% @passkeys.each do |passkey| %>
    <tr>
      <td><%= passkey.description %></td>
      <td><%= l(passkey.created_at, format: :short) %></td>
      <td><%= passkey.respond_to?(:last_used_at) && passkey.last_used_at ? l(passkey.last_used_at, format: :short) : "-" %></td>
      <td>
        <%= link_to t("actions.edit"), edit_acme_app_settings_passkey_path(passkey, ri: params[:ri]) %>
        <%= form_with url: acme_app_settings_passkey_path(passkey, ri: params[:ri]),
                      method: :delete,
                      data: { turbo_confirm: t("messages.confirm_destroy") } do |form| %>
          <%= render "shared/cloudflare_turnstile_stealth" %>
          <%= form.submit t("actions.destroy") %>
        <% end %>
      </td>
    </tr>
  <% end %>
  <% if @passkeys.empty? %>
    <tr>
      <td colspan="4"><%= t("views.sign.app.settings.passkeys.index.empty") %></td>
    </tr>
  <% end %>
  </tbody>
</table>
