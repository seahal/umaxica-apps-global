<% content_for :page_title, "Totps" %>
<%= link_to t("sign.app.settings.show.back"), acme_app_settings_path(ri: params[:ri]) %>

<div>
  <%= button_to t("sign.app.settings.totp.index.new_link"),
                enrollment_acme_app_settings_totps_path(ri: params[:ri]),
                method: :post %>
</div>

<table>
  <thead>
  <tr>
    <th scope="col"><%= t("activerecord.attributes.user_totp_credential.title") %></th>
    <th scope="col"><%= t("activerecord.attributes.user_totp_credential.last_otp_at") %></th>
    <th scope="col"><%= t("actions.actions") %></th>
  </tr>
  </thead>
  <tbody>
  <% @totps.each do |credential| %>
    <tr>
      <td><%= credential.title.presence %></td>
      <td><%= (credential.last_otp_at.is_a?(Time) || credential.last_otp_at.is_a?(ActiveSupport::TimeWithZone)) && credential.last_otp_at > Time.zone.at(0) ? l(credential.last_otp_at, format: :short) : "-" %></td>
      <td><%= link_to t("actions.edit"), edit_acme_app_settings_totp_path(credential.public_id, ri: params[:ri]) %></td>
    </tr>
  <% end %>
  <% if @totps.empty? %>
    <tr>
      <td colspan="3"><%= t("messages.no_totp_found") %></td>
    </tr>
  <% end %>
  </tbody>
</table>
