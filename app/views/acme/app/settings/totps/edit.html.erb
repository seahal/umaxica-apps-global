<%= link_to t("sign.app.settings.show.back"), acme_app_settings_totps_path(ri: params[:ri]) %>

<% content_for :page_title, t("sign.app.setting.totp.edit.title") %>
<h3><%= t("sign.app.setting.totp.edit.title") %></h3>

<%= form_with model: @totp,
              scope: :user_totp_credential,
              url: acme_app_settings_totp_path(@totp.public_id, ri: params[:ri]),
              method: :patch do |form| %>
  <% if @totp.errors.any? %>
    <ul>
      <% @totp.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  <% end %>

  <%= form.label :title, t("activerecord.attributes.user_totp_credential.title") %>
  <%= form.text_field :title, maxlength: 32, placeholder: t("messages.totp_title_placeholder") %>
  <%= form.submit t("actions.save") %>
  <%= link_to t("actions.cancel"), acme_app_settings_totps_path(ri: params[:ri]) %>
<% end %>

<%= button_to t("actions.delete"),
              acme_app_settings_totp_path(@totp.public_id, ri: params[:ri]),
              method: :delete,
              form: { data: { turbo_confirm: t("messages.confirm_delete_totp") } } %>
