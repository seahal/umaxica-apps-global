<% content_for :page_title, t("sign.app.settings.show.page_title") %>

<h1><%= t("sign.app.settings.show.page_title") %></h1>

<p><%= link_to "Identity", acme_app_identity_path(ri: params[:ri]) %></p>

<section>
  <h2><%= t("sign.app.settings.show.security_settings") %></h2>
  <ul>
    <%# Credential ceremony remains on sign/id. %>
    <li><%= link_to t("controller.sign.app.setting.index.totp"), acme_app_settings_totps_path(ri: params[:ri]) %></li>
    <li><%= link_to t("controller.sign.app.setting.index.passkey"), acme_app_settings_passkeys_path(ri: params[:ri]) %></li>
    <li><%= link_to t("controller.sign.app.setting.index.secret_credential"), acme_app_settings_secret_credentials_path(ri: params[:ri]) %></li>
    <li><%= link_to t("sign.app.settings.show.mfa"), sign_app_settings_mfa_challenge_path %></li>
    <li><%= link_to t("sign.app.settings.show.mfa_reset"), sign_app_settings_mfa_reset_path(ri: params[:ri]) %></li>
  </ul>
</section>
<br />
<section>
  <h2><%= t("sign.app.settings.show.account_settings") %></h2>
  <ul>
    <%# Contact management belongs to acme/www; registration ceremonies remain on sign/id. %>
    <li><%= link_to t("controller.sign.app.setting.index.email"), acme_app_settings_emails_path(ri: params[:ri]) %></li>
    <li><%= link_to t("controller.sign.app.setting.index.telephone"), acme_app_settings_telephones_path(ri: params[:ri]) %></li>
    <li><%= link_to t("controller.sign.app.setting.index.birthdate"), sign_app_settings_birthdate_path(ri: params[:ri]) %></li>
    <li><%= link_to t("controller.sign.app.setting.index.session"), acme_app_settings_sessions_path %></li>
    <li><%= link_to t("sign.settings.connections.index.page_title"), acme_app_settings_connections_path(ri: params[:ri]) %></li>
    <li><%= link_to t("controller.sign.app.setting.index.activity"), acme_app_settings_activities_path %></li>
  </ul>
</section>
<br />
<section>
  <h2><%= t("sign.app.settings.show.external_services") %></h2>
  <ul>
    <%# Social connection settings remain on sign/id until the social callback boundary is split. %>
    <li><%= link_to t("controller.sign.app.setting.index.google"), sign_app_settings_google_path %></li>
    <li><%= link_to t("controller.sign.app.setting.index.apple"), sign_app_settings_apple_path %></li>
  </ul>
</section>
<br />
<section>
  <h2><%= t("sign.app.settings.show.others") %></h2>
  <ul>
    <li><%= link_to t("sign.app.settings.show.logout"), edit_acme_app_sign_out_path(ri: params[:ri]) %></li>
    <li><%= link_to t("sign.app.settings.show.withdrawal"), new_acme_app_settings_withdrawal_path %></li>
  </ul>
</section>
