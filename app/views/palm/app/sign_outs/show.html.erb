<% content_for :page_title, "Signed out" %>
<% content_for :head do %>
  <meta name="robots" content="noindex, nofollow">
  <style>
    :root {
      color-scheme: light dark;
      font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      line-height: 1.5;
    }

    body {
      margin: 0;
      min-height: 100vh;
      color: #111827;
      background: #f4f7fb;
    }

    main {
      display: grid;
      min-height: 100vh;
      place-items: center;
      padding: 2rem;
    }

    section {
      width: min(100%, 42rem);
    }

    h1 {
      margin: 0 0 0.75rem;
      color: #0f172a;
      font-size: clamp(2rem, 5vw, 4rem);
      line-height: 1;
    }

    p {
      margin: 0.5rem 0;
      color: #334155;
    }

    code {
      padding: 0.125rem 0.25rem;
      border-radius: 0.25rem;
      background: #e2e8f0;
    }
  </style>
<% end %>

<%# The palm layout already provides the <main> landmark. %>
<section aria-labelledby="palm-sign-out-title">
  <h1 id="palm-sign-out-title">Signed out</h1>
  <% if @logout_transaction.present? %>
    <p>Your Palm session was revoked and the browser logout flow completed.</p>
    <% if params[:state].present? %>
      <p>State <code><%= params[:state] %></code> was validated.</p>
    <% end %>
  <% else %>
    <p>There is no active Palm logout transaction to display.</p>
  <% end %>
</section>
