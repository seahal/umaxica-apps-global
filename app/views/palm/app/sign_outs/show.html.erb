<% content_for :page_title, "Sign out" %>

<div>
  <h1><%= title "Sign out" %></h1>
  <p>This surface uses bearer tokens. Sign out clears the local browser session only.</p>
  <%= button_to "Sign out", palm_app_sign_out_path, method: :post, form: { data: { turbo: false } } %>
  <p><%= link_to "Home", palm_app_root_path %></p>
</div>
