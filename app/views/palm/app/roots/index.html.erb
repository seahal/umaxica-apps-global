<!doctype html>
<html lang="<%= I18n.locale %>">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Palm App</title>
    <style>
      :root {
        color-scheme: light dark;
        font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        line-height: 1.5;
      }

      body {
        margin: 0;
        min-height: 100vh;
        color: #111827;
        background: #f6f8f7;
      }

      main {
        display: grid;
        min-height: 100vh;
        place-items: center;
        padding: 2rem;
      }

      section {
        width: min(100%, 42rem);
      }

      p {
        margin: 0;
        color: #374151;
        font-size: 1rem;
      }

      h1 {
        margin: 0 0 0.75rem;
        color: #0f172a;
        font-size: clamp(2rem, 5vw, 4rem);
        font-weight: 700;
        letter-spacing: 0;
        line-height: 1;
      }
    </style>
  </head>
  <body>
    <main>
      <section aria-labelledby="palm-app-title">
        <h1 id="palm-app-title">Palm App</h1>
        <p><%= t("palm.app.roots.message") %></p>
        <p><%= link_to "Sign up on iOS", palm_app_oidc_authorization_path(client_id: "app-ios-rp") %></p>
        <p><%= link_to "Sign up on Android", palm_app_oidc_authorization_path(client_id: "app-android-rp") %></p>
      </section>
    </main>
  </body>
</html>
