<section class="animate-fade-in-up">
  <div>
    <div>
      <div>
        <div>
          <h1>
            <%= title t("apex.app.preferences.title") %>
          </h1>
          <p>
            <%= t("apex.app.preferences.description") %>
          </p>
        </div>
      </div>
    </div>

    <div>
      <!-- Region -->
      <%= link_to "#" do %>
        <div>
          <span><%= t("apex.app.preferences.region_settings") %></span>
        </div>
      <% end %>

      <!-- Timezone -->
      <%= link_to "#" do %>
        <div>
          <span><%= t("apex.app.preferences.timezone_settings") %></span>
        </div>
      <% end %>

      <!-- Language -->
      <%= link_to "#" do %>
        <div>
          <span><%= t("apex.app.preferences.language_settings") %></span>
        </div>
      <% end %>

      <!-- Theme -->
      <%= link_to "#" do %>
        <div>
          <span><%= t("apex.app.preferences.theme_settings") %></span>
        </div>
      <% end %>

      <!-- Cookie -->
      <%= link_to "#" do %>
        <div>
          <span><%= t("apex.app.preferences.cookie_settings") %></span>
        </div>
      <% end %>

      <!-- Reset -->
      <%= link_to "#" do %>
        <div>
          <span><%= t("apex.app.preferences.reset_settings") %></span>
        </div>
      <% end %>
    </div>
  </div>

  <div>
    <%= link_to "#" do %>
      <span><%= t("apex.app.preferences.up_link") %></span>
    <% end %>
  </div>
</section>
