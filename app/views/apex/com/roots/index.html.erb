<% page_title t("apex.com.preferences.footer.home") %>

<section>
  <h1>
    Welcome to <%= ENV["BRAND_NAME"] %> (com)
  </h1>
  <p>
    <%= t("views.apex.com.roots.index.redirect_prompt", preference: t("apex.com.preferences.footer.preference")) %>
  </p>

  <ul>
    <li>
      <a
        href="https://<%= ENV['EDGE_CORPORATE_URL'] %>"
        data-turbo-frame="_top">
        <%= t("apex.com.preferences.footer.home") %>
      </a>
    </li>
    <li>
      <%= link_to t("apex.com.preferences.footer.preference"), sign_com_preference_url,
                  data: { turbo_frame: "_top" } %>
    </li>
  </ul>
</section>
