<%#
  Provider sign-in button.

  Posts to the surface ceremony endpoint, which prepares the ceremony and hands
  this same POST to the OmniAuth request phase with a 307. The form carries a
  global authenticity token rather than a per-form one, because the token is
  verified twice: once here and once at the OmniAuth request phase, which sits
  at a different path.

  Turbo is disabled so the browser performs a native submission and can follow
  the 307 and then the cross-origin redirect to the provider.

  The artwork and wording are constrained by
  docs/reference/third-party-sign-in-button-requirements.md. Do not substitute a
  custom design, custom wording, or redrawn logo artwork.

  Google renders the official button artwork, which carries its own English
  "Sign in with Google" wording, so the accessible name matches the artwork
  rather than the locale.

  Apple has no official whole-button artwork for the web, so this is a custom
  button built to the constraints in the Human Interface Guidelines. The logo
  is rendered only when the official artwork is in the repository; the
  guidelines forbid redrawing it, so until then the button carries the title
  alone.

  Any other provider renders a title-only button. "entra" (org surface) uses
  that branch: its endpoint renders a connection cushion page before the
  OmniAuth request phase, because the Entra tenant is resolved per organization.

  Locals:
    url      - ceremony endpoint to post to
    label    - button text, from the provider's permitted call-to-action list
    provider - "google", "apple", or "entra"
%>
<%= form_with url: url, method: :post, local: true, authenticity_token: false, data: { turbo: false }, html: { class: "social-provider-form" } do %>
  <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
  <% if provider == "google" %>
    <%= button_tag type: :submit,
                   class: "social-provider-button social-provider-button--google",
                   aria: { label: "Sign in with Google" } do %>
      <%#
        Served straight from public/ rather than through the asset pipeline:
        the pipeline resolves from a precompiled manifest, which CI does not
        build, and this artwork is stable enough not to need fingerprinting.
      %>
      <%= image_tag "/images/social/google_sign_in_light.svg",
                    alt: "",
                    width: 180,
                    height: 40,
                    class: "social-provider-button__art social-provider-button__art--light" %>
      <%= image_tag "/images/social/google_sign_in_dark.svg",
                    alt: "",
                    width: 180,
                    height: 40,
                    class: "social-provider-button__art social-provider-button__art--dark" %>
    <% end %>
  <% elsif provider == "apple" %>
    <% logos = apple_sign_in_logo_paths %>
    <%= button_tag type: :submit, class: "social-provider-button social-provider-button--apple" do %>
      <% if logos %>
        <%= image_tag logos[:white],
                      alt: "",
                      width: 28,
                      height: 40,
                      class: "social-provider-button__apple-logo social-provider-button__apple-logo--white" %>
        <%= image_tag logos[:black],
                      alt: "",
                      width: 28,
                      height: 40,
                      class: "social-provider-button__apple-logo social-provider-button__apple-logo--black" %>
      <% end %>
      <span class="social-provider-button__apple-title"><%= label %></span>
    <% end %>
  <% else %>
    <%= submit_tag label, class: "social-provider-button social-provider-button--#{provider}" %>
  <% end %>
<% end %>
