<% type = @preference_option_type %>
<% surface = @preference_surface_key %>
<%# Selectable screens read from the base.* tree, the same one BasePreferenceScreenPage renders. %>
<% title_text = t("base.#{surface}.preference.#{type}.edit.heading") %>
<% content_for :page_title, title_text %>

<section>
  <div>
    <%= link_to t("base.#{surface}.preferences.regions.back_link"),
                @preference_option_back_url %>
  </div>

  <h1>
    <%= title_text %>
  </h1>
  <p>
    <%= t("base.#{surface}.preference.#{type}.edit.description") %>
  </p>

  <%= form_with model: @preference_option,
                scope: @preference_option_scope,
                url: @preference_option_update_url,
                method: :patch do |f| %>
    <div>
      <%= f.label :option_id,
                  t("base.#{surface}.preference.#{type}.edit.option_label") %>
      <div>
        <%= f.select :option_id,
                     options_for_select(@preference_option_choices, @preference_option.option_id),
                     { include_blank: false },
                     {} %>
      </div>
    </div>

    <div>
      <%= f.submit t("base.#{surface}.preferences.update_settings"),
                   data: { turbo_submits_with: t("base.#{surface}.preferences.submitting") } %>
    </div>
  <% end %>
</section>
