<% type = @preference_option_type %>
<% surface = @preference_surface_key %>
<% title_text = t("acme.#{surface}.preference.#{type}.edit.heading", default: type.to_s.tr("_", " ").titleize) %>
<% content_for :page_title, title_text %>

<section>
  <div>
    <%= link_to t("acme.#{surface}.preferences.regions.back_link",
                  default: t("acme.#{surface}.preferences.back_to_settings")),
                @preference_option_back_url %>
  </div>

  <h1>
    <%= title_text %>
  </h1>
  <p>
    <%= t("acme.#{surface}.preference.#{type}.edit.description", default: "") %>
  </p>

  <%= form_with model: @preference_option,
                scope: @preference_option_scope,
                url: @preference_option_update_url,
                method: :patch do |f| %>
    <div>
      <%= f.label :option_id,
                  t("acme.#{surface}.preference.#{type}.edit.option_label", default: title_text) %>
      <div>
        <%= f.select :option_id,
                     options_for_select(@preference_option_choices, @preference_option.option_id),
                     { include_blank: false },
                     {} %>
      </div>
    </div>

    <div>
      <%= f.submit t("acme.#{surface}.preferences.update_settings"),
                   data: { turbo_submits_with: t("acme.#{surface}.preferences.submitting") } %>
    </div>
  <% end %>
</section>
