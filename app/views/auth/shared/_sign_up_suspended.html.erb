<%#
  Rendered by the sign-up entry templates when `sign_up_suspended_{surface}` is
  enabled. The notice is inline in the response rather than a flash so it cannot
  survive into an unrelated later request.
%>
<div role="alert" data-test-id="sign-up-suspended">
  <p><%= t("errors.messages.sign_up_suspended") %></p>
</div>
