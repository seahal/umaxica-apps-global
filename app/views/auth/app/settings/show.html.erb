<% content_for :page_title, t("sign.app.settings.show.page_title") %>

<h1><%= t("sign.app.settings.show.page_title") %></h1>

<section>
  <h2><%= t("sign.app.settings.show.security_settings") %></h2>
  <ul>
    <li><%= link_to t("controller.sign.app.setting.index.totp"), auth_app_settings_totps_path %></li>
    <li><%= link_to t("controller.sign.app.setting.index.passkey"), auth_app_settings_passkeys_path %></li>
    <li><%= link_to t("controller.sign.app.setting.index.secret_credential"), base_app_identity_secrets_url(ri: params[:ri], host: base_authority_host) %></li>
  </ul>
</section>
<br />
<section>
  <h2><%= t("sign.app.settings.show.account_settings") %></h2>
  <ul>
    <li><%= link_to t("controller.sign.app.setting.index.email"), base_app_identity_emails_url(ri: params[:ri], host: base_authority_host) %></li>
    <li><%= link_to t("controller.sign.app.setting.index.telephone"), base_app_identity_telephones_url(ri: params[:ri], host: base_authority_host) %></li>
    <li><%= link_to t("controller.sign.app.setting.index.birthdate"), base_app_identity_birthdate_url(ri: params[:ri], host: base_authority_host) %></li>
    <li><%= link_to t("controller.sign.app.setting.index.session"), base_app_identity_sessions_url(ri: params[:ri], host: base_authority_host) %></li>
    <li><%= link_to t("controller.sign.app.setting.index.activity"), base_app_identity_activities_url(ri: params[:ri], host: base_authority_host) %></li>
  </ul>
</section>
<br />
<section>
  <h2><%= t("sign.app.settings.show.external_services") %></h2>
  <ul>
    <li><%= link_to t("controller.sign.app.setting.index.google"), auth_app_settings_google_path %></li>
    <li><%= link_to t("controller.sign.app.setting.index.apple"), auth_app_settings_apple_path %></li>
  </ul>
</section>
<br />
<section>
  <h2><%= t("sign.app.settings.show.others") %></h2>
  <ul>
    <li><%= link_to t("sign.app.settings.show.logout"), new_auth_app_sign_out_path(ri: params[:ri]) %></li>
    <li><%= link_to t("sign.app.settings.show.withdrawal"), new_base_app_identity_withdrawal_url(ri: params[:ri], host: base_authority_host) %></li>
  </ul>
</section>
