<% content_for :page_title, t("sign.app.settings.passkeys.edit.title") %>
<%= link_to t("sign.app.settings.show.back"), auth_app_settings_passkeys_path(ri: params[:ri]) %>

<div>
  <div>
    <h1><%= t("sign.app.settings.passkeys.edit.title") %></h1>
    <p><%= t("sign.app.settings.passkeys.edit.description") %></p>
  </div>

  <%= form_with model: @passkey, url: auth_app_settings_passkey_path(@passkey.public_id, ri: params[:ri]), method: :patch do |form| %>
    <% if @passkey.errors.any? %>
      <div>
        <div>
          <div>
            <h3>
              <%= t('errors.messages.validation_errors', count: @passkey.errors.count) %>
            </h3>
            <div>
              <ul>
                <% @passkey.errors.full_messages.each do |message| %>
                  <li><%= message %></li>
                <% end %>
              </ul>
            </div>
          </div>
        </div>
      </div>
    <% end %>

    <div>
      <%= form.label :description, t('activerecord.attributes.user_passkey.description') %>
      <%= form.text_field :description,
                          maxlength: 100 %>
    </div>

    <%= render "shared/cloudflare_turnstile_stealth" %>

    <div>
      <%= form.submit t('actions.save') %>
      <%= link_to t('sign.common.cancel'), auth_app_settings_passkeys_path %>
    </div>
  <% end %>

  <div>
    <%= form_with url: auth_app_settings_passkey_path(@passkey.public_id, ri: params[:ri]),
                  method: :delete,
                  data: { turbo_confirm: t('messages.confirm_destroy') } do |form| %>
      <%= render "shared/cloudflare_turnstile_stealth" %>
      <%= form.submit t('actions.delete') %>
    <% end %>
  </div>
</div>
