<% title t("sign.app.registration.new.page_title") %>

<h1><%= t("sign.app.registration.new.page_title") %></h1>

<ul>
  <li data-test-id="registration-method">
    <%= link_to t("sign.app.registration.new.methods.email.cta"),
                new_auth_app_sign_up_email_path(ri: params[:ri]) %>
  </li>
  <li data-test-id="registration-method">
    <%= link_to t("sign.app.registration.new.methods.telephone.cta"),
                new_auth_app_sign_up_telephone_path(ri: params[:ri]) %>
  </li>
</ul>

<%#
  Provider buttons post directly: the press supplies the CSRF token the
  OmniAuth request phase requires, so no cushion page is involved. Button
  labels and artwork are governed by
  docs/reference/third-party-sign-in-button-requirements.md.
%>
<ul class="social-provider-buttons">
  <li data-test-id="registration-method">
    <%= render "auth/shared/social_provider_button",
               url: auth_app_social_google_registration_path,
               label: t("sign.app.registration.new.social.buttons.google"),
               provider: "google" %>
  </li>
  <li data-test-id="registration-method">
    <%= render "auth/shared/social_provider_button",
               url: auth_app_social_apple_registration_path,
               label: t("sign.app.registration.new.social.buttons.apple"),
               provider: "apple" %>
  </li>
</ul>

<%= link_to t("sign.app.registration.new.links.sign_in"), auth_app_sign_in_path %>
