<% content_for :page_title, t("sign.app.authentication.new.page_title") %>
<% pt = signed_pt_param %>
<h1><%= t("sign.app.authentication.new.page_title") %></h1>
<p><%= t("sign.app.authentication.new.description") %></p>

<ul>
  <li><%= link_to t("sign.app.authentication.new.links.email"), new_auth_app_sign_in_email_path(pt: pt) %></li>
  <li><%= link_to t("sign.app.authentication.new.links.passkey"), new_auth_app_sign_in_passkey_path(pt: pt) %>
  </li>
  <li><%= link_to t("sign.app.authentication.new.links.secret_credential"), new_auth_app_sign_in_secret_path(pt: pt) %>
  </li>
</ul>

<%#
  Provider buttons post directly: the press supplies the CSRF token the
  OmniAuth request phase requires, so no cushion page is involved. Button
  labels and artwork are governed by
  docs/reference/third-party-sign-in-button-requirements.md.
%>
<ul class="social-provider-buttons">
  <li>
    <%= render "auth/shared/social_provider_button",
               url: auth_app_social_google_session_path,
               label: t("sign.app.authentication.new.links.google"),
               provider: "google" %>
  </li>
  <li>
    <%= render "auth/shared/social_provider_button",
               url: auth_app_social_apple_session_path,
               label: t("sign.app.authentication.new.links.apple"),
               provider: "apple" %>
  </li>
</ul>

<%= link_to auth_app_sign_up_path(ri: params[:ri], pt: signed_pt_param) do %>
  <%= t("sign.app.authentication.new.links.registration") %>
<% end %>
