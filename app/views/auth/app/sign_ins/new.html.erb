<% content_for :page_title, t("sign.app.authentication.new.page_title") %>
<% pt = signed_pt_param %>
<h1><%= t("sign.app.authentication.new.page_title") %></h1>
<p><%= t("sign.app.authentication.new.description") %></p>

<ul>
  <li><%= link_to t("sign.app.authentication.new.links.email"), new_sign_app_sign_in_email_path(pt: pt) %></li>
  <li><%= link_to t("sign.app.authentication.new.links.passkey"), new_sign_app_sign_in_passkey_path(pt: pt) %>
  </li>
  <li><%= link_to t("sign.app.authentication.new.links.secret_credential"), new_sign_app_sign_in_secret_credential_path(pt: pt) %>
  </li>
</ul>

<ul>
  <li>
    <%= link_to sign_app_social_google_sign_in_path,
                data: { turbo: false } do %>
      <%= t("sign.app.authentication.new.links.google") %>
    <% end %>
  </li>
  <li>
    <%= link_to sign_app_social_apple_sign_in_path,
                data: { turbo: false } do %>
      <%= t("sign.app.authentication.new.links.apple") %>
    <% end %>
  </li>
</ul>

<%= link_to sign_app_sign_up_path(ri: params[:ri], pt: signed_pt_param) do %>
  <%= t("sign.app.authentication.new.links.registration") %>
<% end %>
