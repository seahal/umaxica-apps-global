<% content_for :page_title, t("sign.app.verification.index.title") %>
<% title t("sign.app.verification.index.title") %>
<% verification_method_params = { ri: params[:ri] } %>
<% verification_method_params[:scope] = current_step_up_scope if current_step_up_scope.present? %>
<% verification_method_params[:pt] = current_step_up_pt_param if current_step_up_pt_param.present? %>

<div>
  <div>
    <h1><%= t("sign.app.verification.index.title") %></h1>
  </div>

    <div>
      <h2><%= t("sign.app.verification.new.title") %></h2>
      <p><%= t("sign.app.verification.new.description") %></p>

    <% if @available_methods.blank? %>
      <p><%= t("views.sign.app.verifications.show.no_methods") %></p>
    <% else %>
      <div>
        <% if @available_methods.include?(:passkey) %>
          <div>
            <%= link_to t("sign.app.verification.new.methods.passkey"),
                        new_auth_app_verification_passkey_path(verification_method_params) %>
          </div>
        <% end %>

        <% if @available_methods.include?(:totp) %>
          <div>
            <%= link_to t("sign.app.verification.new.methods.totp"),
                        new_auth_app_verification_totp_path(verification_method_params) %>
          </div>
        <% end %>

        <% if @available_methods.include?(:email_otp) %>
          <div>
            <%= link_to t("sign.app.verification.new.methods.email_otp"),
                        new_auth_app_verification_email_path(verification_method_params) %>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
