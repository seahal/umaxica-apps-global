<% content_for :page_title, "Microsoft Entra ID" %>

<%= link_to t("sign.app.settings.show.back"), auth_org_settings_entra_path(ri: params[:ri]) %>

<div>
  <h3>Microsoft Entra ID</h3>

  <% if @entra_identity.present? %>
    <p>Connected</p>
    <p>Disconnecting Microsoft Entra ID from settings is not available until the operator lifecycle owner is defined.</p>
  <% elsif @entra_connections.any? %>
    <% @entra_connections.each do |connection| %>
      <%= button_to "Connect",
                    auth_org_settings_entra_path(ri: params[:ri]),
                    method: :post,
                    params: { entra: { connection_public_id: connection.public_id } },
                    form: { data: { turbo: false } } %>
    <% end %>
  <% else %>
    <p>No active Microsoft Entra ID connection is available.</p>
  <% end %>
</div>
