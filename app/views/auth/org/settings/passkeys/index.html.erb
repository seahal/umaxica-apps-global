<% content_for :page_title, t('sign.org.settings.passkeys.index.title') %>
<div>
  <div>
    <div>
      <h1><%= t('sign.org.settings.passkeys.index.title') %></h1>
      <p><%= t('sign.org.settings.passkeys.index.description') %></p>
    </div>
    <div>
      <%= link_to t('sign.org.settings.passkeys.index.add'), new_auth_org_settings_passkey_path(ri: params[:ri]) %>
    </div>
  </div>

  <div>
    <div>
      <div>
        <div>
          <table>
            <thead>
            <tr>
              <th scope="col"><%= t('activerecord.attributes.staff_passkey.description') %></th>
              <th scope="col"><%= t('activerecord.attributes.staff_passkey.created_at') %></th>
              <th scope="col">
                <span><%= t('actions.actions') %></span>
              </th>
            </tr>
            </thead>
            <tbody>
            <% @passkeys.each do |passkey| %>
              <tr>
                <td><%= passkey.description %></td>
                <td><%= l(passkey.created_at, format: :short) %></td>
                <td>
                  <%= link_to t('actions.edit'), edit_auth_org_settings_passkey_path(passkey, ri: params[:ri]) %>
                  <%= form_with url: auth_org_settings_passkey_path(passkey, ri: params[:ri]),
                                method: :delete,
                                data: { turbo_confirm: t('messages.confirm_destroy') } do |form| %>
                    <%= render "shared/cloudflare_turnstile_stealth" %>
                    <%= form.submit t('actions.destroy') %>
                  <% end %>
                </td>
              </tr>
            <% end %>
            <% if @passkeys.empty? %>
              <tr>
                <td colspan="3" class="italic">
                  <%= t('sign.org.settings.passkeys.index.empty') %>
                </td>
              </tr>
            <% end %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>

  <div>
    <%= link_to t('sign.org.settings.passkeys.index.back'), auth_org_settings_path %>
  </div>
</div>
