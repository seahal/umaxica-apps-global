<% content_for :page_title, t('sign.org.settings.passkeys.show.title') %>
<%= link_to t('sign.org.settings.passkeys.show.back'), auth_org_settings_passkeys_path(ri: params[:ri]) %>

<div>
  <div>
    <div>
      <h3><%= t('sign.org.settings.passkeys.show.title') %></h3>
    </div>
    <div>
      <dl>
        <div>
          <dt><%= t('activerecord.attributes.staff_passkey.description') %></dt>
          <dd><%= @passkey.description %></dd>
        </div>
        <div>
          <dt><%= t('activerecord.attributes.staff_passkey.provider_name') %></dt>
          <dd><%= @passkey.provider_name.presence || t('sign.unknown_authenticator') %></dd>
        </div>
        <div>
          <dt><%= t('activerecord.attributes.staff_passkey.created_at') %></dt>
          <dd><%= l(@passkey.created_at, format: :long) %></dd>
        </div>
        <div>
          <dt><%= t('activerecord.attributes.staff_passkey.sign_count') %></dt>
          <dd><%= @passkey.sign_count %></dd>
        </div>
      </dl>
    </div>
  </div>

  <div>
    <div>
      <%= link_to t('actions.edit'), edit_auth_org_settings_passkey_path(@passkey, ri: params[:ri]) %>
      <%= form_with url: auth_org_settings_passkey_path(@passkey, ri: params[:ri]),
                    method: :delete,
                    data: { turbo_confirm: t('messages.confirm_destroy') } do |form| %>
        <%= render "shared/cloudflare_turnstile_stealth" %>
        <%= form.submit t('actions.destroy') %>
      <% end %>
    </div>
  </div>
</div>
