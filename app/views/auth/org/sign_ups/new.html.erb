<% content_for :page_title, t("sign.org.ups.new.heading") %>
<div class="animate-fade-in-up">
  <div>
    <h1>
      <%= t("sign.org.ups.new.heading") %>
    </h1>
    <p>
      <%= t("sign.org.ups.new.description") %>
    </p>
  </div>

  <div>
    <div>
      <p>
        <%= t("sign.org.ups.new.recruit_prompt") %>
      </p>
      <%= sign_org_recruit_contact_link %>
    </div>

    <%#
      Direct entry only. An RP-initiated ceremony asked for a sign-up, so the
      page must not offer a detour into sign-in; the same rule governs the
      reciprocal link on auth/org/sign_ins/new.
    %>
    <% if @oidc_authorization_intent.blank? %>
      <div>
        <%= link_to t("sign.org.ups.new.links.sign_in"),
                    auth_org_sign_in_path(pt: signed_pt_param, ri: params[:ri]) %>
      </div>
    <% end %>

    <div>
      <%= link_to auth_org_root_path do %>
        <span><%= t("sign.org.ups.new.back_to_root") %></span>
      <% end %>
    </div>
  </div>
</div>
