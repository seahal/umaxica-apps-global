<% content_for :page_title, t("sign.org.ups.new.heading") %>
<div class="animate-fade-in-up">
  <div>
    <h1>
      <%= t("sign.org.ups.new.heading") %>
    </h1>
    <p>
      <%= t("sign.org.ups.new.description") %>
    </p>
  </div>

  <div>
    <div>
      <p>
        <%= t("sign.org.ups.new.recruit_prompt") %>
      </p>
      <%= auth_org_recruit_contact_link %>
    </div>

    <div>
      <%= link_to auth_org_root_path do %>
        <span><%= t("sign.org.ups.new.back_to_root") %></span>
      <% end %>
    </div>
  </div>
</div>
