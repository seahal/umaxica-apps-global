<% content_for :page_title, t("sign.org.authentication.entra.new.page_title") %>

<div class="animate-fade-in-up">
  <div>
    <h1><%= t("sign.org.authentication.entra.new.page_title") %></h1>
  </div>

  <% if !@provider_available %>
    <div role="alert">
      <p><%= t("sign.org.authentication.entra.errors.provider_unavailable") %></p>
    </div>
  <% else %>
    <%#
      Posts straight to the OmniAuth request phase, like the app surface's
      Google and Apple buttons. The tenant is fixed in configuration, so there
      is nothing for the operator to choose.
    %>
    <%= form_with url: "/social/entra", method: :post, data: { turbo: false } do %>
      <div>
        <%= submit_tag t("sign.org.authentication.entra.new.submit"), class: "btn-entra" %>
      </div>
    <% end %>
  <% end %>
</div>
