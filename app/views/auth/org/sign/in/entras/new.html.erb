<% content_for :page_title, t("sign.org.authentication.entra.new.page_title") %>
<% pt = signed_pt_param %>

<div class="animate-fade-in-up">
  <div>
    <h1><%= t("sign.org.authentication.entra.new.page_title") %></h1>
  </div>

  <% if @error_reason.present? %>
    <div role="alert">
      <p><%= t("sign.org.authentication.entra.errors.#{@error_reason}", default: t("sign.org.authentication.entra.errors.generic")) %></p>
    </div>
  <% end %>

  <% if @connection.present? %>
    <%= form_with url: authorization_auth_org_sign_in_entra_path,
                  method: :post,
                  data: { turbo: false } do |f| %>
      <%= hidden_field_tag :pt, pt if pt.present? %>
      <%= hidden_field_tag "entra[connection_public_id]", @connection.public_id %>

      <div>
        <%= f.submit t("sign.org.authentication.entra.new.submit"), class: "btn-entra" %>
      </div>
    <% end %>
  <% else %>
    <div role="alert">
      <p><%= t("sign.org.authentication.entra.new.connection_unavailable") %></p>
    </div>
  <% end %>
</div>
