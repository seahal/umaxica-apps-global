<%#
  Split out of `auth/app/sign/up/checkpoints/age_restricted` when the app surface moved to an
  Inertia page. The copy is verbatim, including the `sign.app.*` keys the com surface has always
  rendered here, so this change is a relocation and not a change of what com shows. The message
  itself already comes from the surface-specific key that
  `SignUpSequenceControllerSupport::AGE_RESTRICTED_I18N_KEYS` picks.
%>
<% content_for :page_title, t("sign.app.registration.checkpoint.age_restricted") %>

<h1><%= t("sign.app.registration.checkpoint.age_restricted") %></h1>
<p><%= @sign_up_age_restricted_message %></p>
<p><%= t("sign.app.registration.checkpoint.age_restricted_retry") %></p>

<%= button_to t("actions.back"), @sign_up_age_restricted_restart_path, method: :get, form: { data: { turbo: false } } %>
