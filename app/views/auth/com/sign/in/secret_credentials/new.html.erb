<% title t("sign.app.authentication.secret_credential.new.page_title") %>
<% pt = signed_pt_param %>
<% ri = current_region_identifier %>

<h1><%= t("sign.app.authentication.secret_credential.new.page_title") %></h1>

<%= form_with model: @secret_credential_form,
              url: sign_com_sign_in_secret_credential_path,
              data: { turbo: false } do |f| %>

  <% if @secret_credential_form.errors.any? %>
    <div>
      <h2><%= t("errors.messages.validation_failed") %></h2>
      <ul>
        <% @secret_credential_form.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= hidden_field_tag :pt, pt if pt.present? %>
  <%= hidden_field_tag :ri, ri %>

  <div>
    <%= f.label :identifier,
                t("sign.app.authentication.secret_credential.new.pii_label") %>
    <%= f.text_field :identifier,
                     placeholder: t("sign.app.authentication.secret_credential.new.pii_placeholder"),
                     autocomplete: "username" %>
  </div>

  <div>
    <%= f.label :secret_credential_value,
                t("sign.app.authentication.secret_credential.new.secret_credential_label") %>
    <%= f.password_field :secret_credential_value,
                         placeholder: "****************",
                         autocomplete: "current-password" %>
  </div>

  <%= render "shared/cloudflare_turnstile_visible" %>

  <div>
    <%= f.submit t("actions.submit") %>
    <%= link_to sign_com_sign_in_path(pt: pt, ri: ri) do %>
      <%= t("sign.app.authentication.new.back") %>
    <% end %>
  </div>
<% end %>
