<% title t("sign.org.settings.passkeys.new.page_title") %>

<div>
  <div>
    <h1><%= t("sign.org.settings.passkeys.new.page_title") %></h1>
    <p><%= t("sign.org.settings.passkeys.new.description") %></p>
  </div>

  <div
    data-controller="passkey-registration"
    data-passkey-registration-options-url-value="<%= auth_com_settings_passkeys_options_path(ri: params[:ri]) %>"
    data-passkey-registration-verification-url-value="<%= auth_com_settings_passkeys_verification_path(ri: params[:ri]) %>"
    data-passkey-registration-turnstile-site-key-value="<%= JitSecurityTurnstileConfig.stealth_site_key.to_s %>"
    data-passkey-registration-turnstile-error-message-value="<%= t("turnstile_error") %>">

    <div>
      <label for="description">
        <%= t("sign.org.settings.passkeys.new.description_label") %>
      </label>
      <input type="text"
             id="description"
             autocomplete="off"
             data-passkey-registration-target="description"
             placeholder="<%= t("sign.org.settings.passkeys.new.description_placeholder") %>"
             maxlength="100">
    </div>

    <p data-passkey-registration-target="error" class="hidden"></p>
    <p data-passkey-registration-target="status" class="hidden"></p>
    <input type="hidden" data-passkey-registration-target="turnstileResponse" autocomplete="off">

    <div>
      <button type="button"
              data-action="click->passkey-registration#register">
        <%= t("sign.org.settings.passkeys.new.submit") %>
      </button>
      <%= link_to t("sign.common.cancel"), auth_com_settings_passkeys_path(ri: params[:ri]) %>
    </div>
  </div>
</div>
