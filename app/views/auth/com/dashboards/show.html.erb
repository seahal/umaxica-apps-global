<h1><%= title "Dashboard" %></h1>

<p>Sign com signed-in landing.</p>

<section>
  <h2>Primary links</h2>
  <ul>
    <li><%= link_to "Root", auth_com_root_path(ri: params[:ri]) %></li>
    <li><%= link_to "Sign in", auth_com_sign_in_path(ri: params[:ri]) %></li>
    <li><%= link_to "Sign up", auth_com_sign_up_path(ri: params[:ri]) %></li>
    <li><%= link_to "Settings", auth_com_settings_path(ri: params[:ri]) %></li>
    <li><%= link_to "Logout", new_auth_com_sign_out_path(ri: params[:ri]) %></li>
  </ul>
</section>

<section>
  <h2>Ceremony links</h2>
  <ul>
    <li><%= link_to "Sign-in guard", auth_com_sign_in_guard_path(ri: params[:ri]) %></li>
    <li><%= link_to "Sign-in check", auth_com_sign_in_check_path(ri: params[:ri]) %></li>
    <li><%= link_to "Sign-in challenge", auth_com_sign_in_challenge_path(ri: params[:ri]) %></li>
    <li>Selector: handled by the sign-in guard sequence, no direct dashboard route</li>
  </ul>
</section>
