<% content_for :page_title, "Switcher" %>

<h1><%= title "Switcher" %></h1>

<p>Signed in</p>

<section>
  <h2>Current context</h2>
  <% current = @switcher&.fetch(:current, nil) %>
  <% if current %>
    <dl>
      <dt>Account</dt><dd><%= current[:account_public_id] %></dd>
      <dt>Organization</dt><dd><%= current[:organization_public_id] %></dd>
      <dt>Organization unit</dt><dd><%= current[:organization_unit_public_id] %></dd>
      <dt>Avatar</dt><dd><%= current[:avatar_public_id] %></dd>
    </dl>
  <% else %>
    <p>No current context.</p>
  <% end %>
</section>

<section>
  <h2>Available contexts</h2>
  <ul>
    <% Array(@switcher&.fetch(:candidates, [])).each do |candidate| %>
      <li>
        account=<%= candidate[:public_id] %>
        organization=<%= candidate.dig(:organization, :public_id) %>
        avatar=<%= candidate.dig(:avatar, :public_id) %>
      </li>
    <% end %>
  </ul>
</section>
