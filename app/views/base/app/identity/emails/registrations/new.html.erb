<% content_for :page_title, t("sign.app.settings.email.new.page_title") %>

<% acme_host = ENV.fetch("PRIVATE_BASE_SERVICE_URL") %>
<%= link_to t('sign.app.settings.show.back'), "https://#{acme_host}/preference?ri=#{params[:ri]}" %>

<h1><%= t("sign.app.settings.email.new.page_title") %></h1>

<%= form_with model: @user_email,
              url: base_app_identity_emails_registration_path,
              scope: :user_email,
              data: { turbo: false } do |form| %>
  <% if @user_email.errors.any? %>
    <div>
      <ul role="list">
        <% @user_email.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :address %>
    <div>
      <%= form.email_field :address, autocomplete: "email", required: true %>
    </div>
  </div>

  <div>
    <%= form.check_box :promotional %>
    <%= form.label :promotional, t("sign.app.settings.email.edit.promotional_label") %>
    <p><%= t("sign.app.settings.email.edit.promotional_description") %></p>
  </div>

  <div>
    <%= form.check_box :notifiable %>
    <%= form.label :notifiable, t("sign.app.settings.email.edit.notifiable_label") %>
    <p><%= t("sign.app.settings.email.edit.notifiable_description") %></p>
  </div>

  <div>
    <%= render "shared/cloudflare_turnstile_stealth" %>
  </div>

  <div>
    <%= form.submit %>
  </div>
  <div>
    <%= link_to t("actions.cancel"), "https://#{acme_host}/preference?ri=#{params[:ri]}" %>
  </div>
<% end %>
