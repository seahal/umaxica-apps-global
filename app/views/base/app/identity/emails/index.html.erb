<% content_for :page_title, 'Emails' %>
<%= link_to t('sign.app.settings.show.back'), auth_app_settings_path %>

<div>
  <div>
    <%= link_to t('sign.app.settings.email.index.new_link'), new_base_app_identity_emails_registration_path(ri: params[:ri]) %>
  </div>
</div>

<div>
  <div>
    <div>
      <div>
        <table>
          <thead>
          <tr>
            <th scope="col">
              <%= t('activerecord.attributes.user_email.address') %>
            </th>
            <th scope="col">
              <%= t('activerecord.attributes.user_email.status') %>
            </th>
            <th scope="col">
              <span>Actions</span>
            </th>
          </tr>
          </thead>
          <tbody>
          <% @client_emails.each do |email| %>
            <tr>
              <td>
                <%= email.address %>
              </td>
              <td>
                <% if [ClientEmailStatus::VERIFIED, ClientEmailStatus::VERIFIED_WITH_SIGN_UP].include?(email.user_email_status_id) %>
                      <span>
                        <%= t("views.sign.app.settings.emails.index.verified") %>
                      </span>
                <% else %>
                      <span>
                        <%= t("views.sign.app.settings.emails.index.unverified") %>
                      </span>
                <% end %>
              </td>
              <td>
                <%= link_to t("sign.app.settings.email.index.edit"),
                            edit_base_app_identity_email_path(email.public_id, ri: params[:ri]) %>
              </td>
            </tr>
          <% end %>
          <% if @client_emails.empty? %>
            <tr>
              <td colspan="3">
                <div>
                  <p><%= t("views.sign.app.settings.emails.index.empty") %></p>
                </div>
              </td>
            </tr>
          <% end %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>
