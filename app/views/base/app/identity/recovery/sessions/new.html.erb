<% content_for :page_title, "Account recovery" %>

<h1>Account recovery</h1>
<p>If an eligible account is found, a verification code will be sent.</p>

<%= form_with url: base_app_identity_recovery_session_path, scope: :recovery_reentry do |form| %>
  <%= form.label :address, "Email address" %>
  <%= form.email_field :address, value: @email_record.address, autocomplete: "email" %>
  <%= form.submit "Send verification code" %>
<% end %>

<% if @reentry_state.present? %>
  <%= form_with url: base_app_identity_recovery_session_path do |form| %>
    <%= form.label :pass_code, "Verification code" %>
    <%= form.text_field :pass_code, inputmode: "numeric", autocomplete: "one-time-code" %>
    <%= form.submit "Continue" %>
  <% end %>
<% end %>
