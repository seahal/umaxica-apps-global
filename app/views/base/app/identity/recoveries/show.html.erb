<% content_for :page_title, "Account recovery" %>

<h1>Account recovery</h1>
<p>Complete verification to restore access.</p>
<% if @appeal_error.present? %>
  <p><%= @appeal_error %></p>
<% end %>
<% @enforcement_cases.each do |enforcement_case| %>
  <p><%= enforcement_case.kind.humanize %></p>
  <%= form_with url: base_app_identity_recovery_completion_path do |form| %>
    <%= hidden_field_tag :enforcement_case_id, enforcement_case.public_id %>
    <%= form.submit "Restore access" %>
  <% end %>
  <% unless enforcement_case.kind == "method_protection" || enforcement_case.appeal.present? %>
    <%= form_with url: base_app_identity_recovery_appeals_path, scope: :appeal do |form| %>
      <%= form.hidden_field :enforcement_case_id, value: enforcement_case.public_id %>
      <%= form.label :reason_code, "Appeal reason" %>
      <%= form.select :reason_code, EnforcementAppeal::REASON_CODES %>
      <%= form.label :statement, "Appeal statement" %>
      <%= form.text_area :statement, maxlength: EnforcementAppeal::MAXIMUM_STATEMENT_LENGTH %>
      <%= form.submit "Submit appeal" %>
    <% end %>
  <% end %>
<% end %>
<% end %>
