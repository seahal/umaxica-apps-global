<% content_for :page_title, "Avatar" %>

<h1>Avatar</h1>

<%= form_with model: @avatar, url: base_app_avatar_path(@avatar.public_id, ri: params[:ri]), method: :patch do |form| %>
  <div>
    <%= form.label :moniker, "Name" %>
    <%= form.text_field :moniker, required: true, maxlength: 120 %>
  </div>

  <%= form.submit "Update Avatar" %>
<% end %>
