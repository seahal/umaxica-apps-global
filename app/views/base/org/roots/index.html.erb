<!doctype html>
<html lang="<%= I18n.locale %>">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Base Org</title>
    <style>
      :root {
        color-scheme: light dark;
        font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        line-height: 1.5;
      }

      body {
        margin: 0;
        min-height: 100vh;
        color: #111827;
        background: #f7f7f4;
      }

      main {
        display: grid;
        min-height: 100vh;
        place-items: center;
        padding: 2rem;
      }

      section {
        width: min(100%, 42rem);
      }

      p {
        margin: 0;
        color: #374151;
        font-size: 1rem;
      }

      h1 {
        margin: 0 0 0.75rem;
        color: #0f172a;
        font-size: clamp(2rem, 5vw, 4rem);
        font-weight: 700;
        letter-spacing: 0;
        line-height: 1;
      }

      a {
        color: #0f766e;
        font-weight: 600;
      }
    </style>
  </head>
  <body>
    <main>
      <section aria-labelledby="base-org-title">
        <h1 id="base-org-title">Base Org</h1>
        <p><%= t("base.org.roots.message") %></p>
        <p><%= link_to "Settings", base_org_settings_path(ri: params[:ri]) %></p>
      </section>
    </main>
  </body>
</html>
