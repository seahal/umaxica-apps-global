<% content_for :page_title, "Account Standing" %>

<h1>Account Standing</h1>
<p>Current status: <%= @standing.level.to_s.humanize %></p>

<% @standing.decisions.each do |decision| %>
  <section id="standing-decision-<%= decision.fetch(:public_id) %>">
    <h2><%= decision.fetch(:kind).humanize %></h2>
    <p><%= decision.fetch(:reason_code).humanize %></p>
    <% if decision.fetch(:expires_at).present? %>
      <p>Ends: <%= l(decision.fetch(:expires_at)) %></p>
    <% end %>
  </section>
<% end %>
