<% surface = controller_path.split("/").second %>
<% root_path = public_send("base_#{surface}_root_path", ri: params[:ri]) %>
<% dashboard_path = public_send("base_#{surface}_dashboard_path", ri: params[:ri]) %>
<% settings_path = public_send("base_#{surface}_settings_path", ri: params[:ri]) %>
<% sign_out_confirmation_path = public_send("new_base_#{surface}_sign_out_path", ri: params[:ri]) %>
<% authorization_path = public_send("base_#{surface}_oidc_authorization_path", ri: params[:ri]) %>

<h1><%= title "Dashboard" %></h1>

<p>Base <%= surface %> signed-in landing.</p>

<section>
  <h2>Primary links</h2>
  <ul>
    <li><%= link_to "Root", root_path %></li>
    <li><%= link_to "Dashboard", dashboard_path %></li>
    <li><%= link_to "Settings", settings_path %></li>
    <li><%= link_to "Sign out", sign_out_confirmation_path %></li>
  </ul>
</section>

<section>
  <h2>Protocol links</h2>
  <ul>
    <li><%= link_to "Authorize", authorization_path %></li>
  </ul>
</section>
