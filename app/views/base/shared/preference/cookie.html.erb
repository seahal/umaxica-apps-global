<% surface = controller_path.split("/").second %>
<% content_for :page_title, t(preference_acme_i18n_key(:preferences, :cookie_settings)) %>

<section data-controller="cookie-toggle">
  <div>
    <%= link_to t("actions.back"), public_send("base_#{surface}_preference_path", lx: params[:lx], ri: params[:ri]) %>
  </div>

  <h1><%= t(preference_acme_i18n_key(:preference, :cookie, :edit, :h1)) %></h1>
  <p><%= t(preference_acme_i18n_key(:preference, :cookie, :edit, :description)) %></p>

  <div data-cookie-toggle-target="status"></div>

  <%= form_with model: @preference_cookie,
                scope: :preference_cookie,
                url: public_send("base_#{surface}_preference_cookie_path", ri: params[:ri]),
                method: :patch do |f| %>
    <div>
      <div>
        <%= check_box_tag :accept_necessary_cookies, "1", true, disabled: true %>
        <%= label_tag :accept_necessary_cookies, t(preference_acme_i18n_key(:preference, :cookie, :edit, :accept_necessary_cookies)) %>
      </div>

      <% { functional: "accept_functional_cookies", performant: "accept_performance_cookies", targetable: "accept_targeting_cookies", consented: "accept_consent_cookies" }.each do |field, label_key| %>
        <div>
          <%= f.check_box field, { data: { cookie_toggle_target: "checkbox", action: "change->cookie-toggle#toggle" } } %>
          <%= f.label field, t(preference_acme_i18n_key(:preference, :cookie, :edit, label_key)) %>
        </div>
      <% end %>
    </div>

    <div>
      <%= f.submit t(preference_acme_i18n_key(:preferences, :update_settings)),
                   data: { turbo_submits_with: t(preference_acme_i18n_key(:preferences, :submitting)) } %>
    </div>
  <% end %>
</section>
