<section aria-labelledby="apple-only-credential-warning">
  <h2 id="apple-only-credential-warning">Add another sign-in method</h2>
  <p>Adding another sign-in method helps you access your account if Apple sign-in is unavailable.</p>
  <ul>
    <li>
      <%= link_to(
        "Add a passkey",
        new_auth_app_settings_passkey_url(
          ri: params[:ri],
          host: ENV.fetch("PUBLIC_AUTH_SERVICE_URL"),
          protocol: "https",
        ),
      ) %>
    </li>
    <li>
      <%= link_to(
        "Link Google",
        edit_auth_app_settings_google_url(
          ri: params[:ri],
          host: ENV.fetch("PUBLIC_AUTH_SERVICE_URL"),
          protocol: "https",
        ),
      ) %>
    </li>
  </ul>
</section>
