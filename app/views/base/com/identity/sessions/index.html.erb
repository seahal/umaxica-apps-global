<% content_for :page_title, 'Sessions' %>
<%= link_to 'Back', base_com_identity_path(ri: params[:ri]) %>
<% has_other_sessions = @sessions.any? { |session| session.public_id != current_session_public_id } %>
<% if has_other_sessions %>
  <div>
    <%= button_to 'Revoke other sessions',
                  base_com_identity_other_sessions_path(ri: params[:ri]),
                  method: :delete,
                  data: { confirm: 'Revoke other sessions?' } %>
    <%= button_to 'Revoke all sessions',
                  base_com_identity_session_set_path(ri: params[:ri]),
                  method: :delete,
                  data: { confirm: 'Revoke all sessions?' } %>
  </div>
<% end %>

<% if @sessions.any? %>
  <div>
    <table>
      <thead>
      <tr>
        <th>Session</th>
        <th>Kind</th>
        <th>Binding</th>
        <th>Last activity</th>
        <th>Created</th>
        <th>Refresh expires</th>
        <th></th>
      </tr>
      </thead>
      <tbody>
      <% @sessions.each do |session| %>
        <% current_session = current_session_record?(session) %>
        <tr class="<%= 'bg-slate-50 font-semibold' if current_session %>">
          <td>
            <div>
              <span><%= session.public_id %></span>
              <% if current_session %>
                <span>current</span>
              <% end %>
            </div>
            <p><%= session.visitor_token_status_id %></p>
          </td>
          <td><%= session.visitor_token_kind_id %></td>
          <td><%= session.dbsc_enabled? ? "DBSC" : "NORMAL" %></td>
          <td><%= l(session.last_used_at || session.created_at, format: :short) %></td>
          <td><%= l(session.created_at, format: :short) %></td>
          <td><%= l(session.discarded_at, format: :short) %></td>
          <td>
            <% unless current_session %>
              <%= button_to 'Revoke',
                            base_com_identity_session_path(session.public_id, ri: params[:ri]),
                            method: :delete,
                            data: { confirm: 'Revoke this session?' } %>
            <% end %>
          </td>
        </tr>
      <% end %>
      </tbody>
    </table>
  </div>
<% else %>
  <p>No active sessions were found.</p>
<% end %>
