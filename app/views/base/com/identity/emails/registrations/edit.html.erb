<% content_for :page_title, t("sign.app.authentication.email.edit.page_title") %>
<h1><%= t("sign.app.authentication.email.edit.page_title") %></h1>
<p><%= t("sign.app.authentication.email.edit.description") %></p>

<%= form_with model: @user_email, url: base_com_identity_emails_registration_path, method: :patch, scope: :visitor_email do |f| %>
  <%= render "auth/app/emails/registrations/verification_fields", form: f, user_email: @user_email, verification_token: @verification_token %>
<% end %>

<div>
  <%= link_to t("sign.app.common.cancel"), base_com_identity_emails_path(ri: params[:ri]) %>
</div>
