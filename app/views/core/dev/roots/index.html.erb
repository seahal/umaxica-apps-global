<!doctype html>
<html lang="<%= I18n.locale %>">
  <head>
    <meta charset="utf-8">
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1">
    <%= display_meta_tags site: "#{ENV.fetch("BRAND_NAME").upcase} (DEV)", separator: "—", reverse: true %>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= vite_client_tag nonce: true %>
    <%= vite_react_refresh_tag nonce: true %>
    <%= vite_stylesheet_tag "~/styles/surfaces/core_dev.css", nonce: true %>
    <%= vite_typescript_tag "entrypoints/core/dev", nonce: content_security_policy_nonce, "data-turbo-eval": "false" %>
  </head>
  <body>
    <div
      data-react-component="ReactAriaProbe"></div>
  </body>
</html>
