<!doctype html>
<html lang="en" data-theme="light" data-edition="net">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>UMAXICA EID</title>
    <meta name="description" content="UMAXICA Entity Identifier service">
    <%= vite_stylesheet_tag "~/styles/surfaces/eid_net.css", nonce: true %>
  </head>
  <body>
    <main class="grid min-h-screen place-items-center p-8">
      <section aria-labelledby="eid-title" class="w-full max-w-2xl">
        <p class="mb-2 text-sm font-semibold tracking-wide text-fg-muted uppercase">Entity Identifier</p>
        <h1 id="eid-title" class="mb-4 text-4xl leading-none font-bold text-fg sm:text-5xl">UMAXICA EID</h1>
        <p class="text-lg text-fg-muted">
          An EID identifies one entity or resource within the UMAXICA ecosystem.
        </p>
      </section>
    </main>
  </body>
</html>
