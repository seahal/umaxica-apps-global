<% title t("sign.app.verification.edit.title") %>
<% verification_scope = params.dig(:verification, :scope).presence || params[:scope] %>
<% verification_pt = params.dig(:verification, :pt).presence || params[:pt] %>

<div>
  <h1><%= t("sign.app.verification.edit.title") %></h1>
  <p><%= t("sign.app.verification.edit.description") %></p>

  <% if @verification_errors&.any? %>
    <div>
      <%= @verification_errors.to_sentence %>
    </div>
  <% end %>

  <%= form_with url: sign_app_verification_passkey_path(ri: params[:ri]), method: :post, data: { turbo: false } do |f| %>
    <% options_json = @passkey_request_options ? json_escape(@passkey_request_options.to_json) : "" %>
    <%= f.hidden_field :scope, value: verification_scope, name: "verification[scope]" %>
    <%= f.hidden_field :pt, value: verification_pt, name: "verification[pt]" %>
    <div
      data-controller="step_up-passkey"
      data-step_up-passkey-options-value="<%= options_json %>"
      data-step_up-passkey-challenge-id-value="<%= @passkey_challenge_id.to_s %>">

      <%= f.hidden_field :challenge_id, value: @passkey_challenge_id.to_s, data: { "step_up-passkey-target": "challengeId" }, name: "verification[challenge_id]" %>
      <%= f.hidden_field :credential_json, value: "", data: { "step_up-passkey-target": "credentialJson" }, name: "verification[credential_json]" %>

      <button type="button"
              data-action="click->step_up-passkey#authenticate">
        <%= t("sign.app.verification.edit.authenticate_with_passkey") %>
      </button>
      <p data-step_up-passkey-target="error" class="hidden"></p>
      <p data-step_up-passkey-target="status" class="hidden"></p>
    </div>
  <% end %>

  <div>
    <%= link_to t("sign.app.verification.edit.back"),
                sign_app_verification_path(
                  ri: params[:ri],
                  scope: verification_scope,
                  pt: verification_pt
                ) %>
  </div>
</div>
