<% title t("sign.app.verification.edit.title") %>
<% verification_scope = params.dig(:verification, :scope).presence || params[:scope] %>
<% verification_return_to = params.dig(:verification, :return_to).presence || params.dig(:verification, :rt).presence || params[:return_to].presence || params[:rt] %>

<div>
  <h1><%= t("sign.app.verification.edit.title") %></h1>
  <p><%= t("sign.app.verification.edit.description") %></p>

  <% if @verification_errors&.any? %>
    <div>
      <%= @verification_errors.to_sentence %>
    </div>
  <% end %>

  <%= form_with url: sign_app_verification_totp_path(ri: params[:ri]), method: :post, data: { turbo: false } do |f| %>
    <%= f.hidden_field :scope, value: verification_scope, name: "verification[scope]" %>
    <%= f.hidden_field :return_to, value: verification_return_to, name: "verification[return_to]" %>
    <div>
      <%= f.label :code, t("sign.app.verification.edit.code_label") %>
      <%= f.text_field :code, inputmode: "numeric", autocomplete: "one-time-code", placeholder: t("sign.app.verification.edit.code_placeholder"), name: "verification[code]" %>
    </div>

    <%= render "shared/cloudflare_turnstile_stealth" %>

    <div>
      <%= f.submit t("sign.app.verification.edit.submit") %>
    </div>
  <% end %>

  <div>
    <%= link_to t("sign.app.verification.edit.back"),
                sign_app_verification_path(
                  ri: params[:ri],
                  scope: verification_scope,
                  return_to: verification_return_to
                ) %>
  </div>
</div>
