<% content_for :page_title, t("sign.app.authentication.new.page_title") %>
<% pt = params[:pt].presence %>
<h1><%= t("sign.app.authentication.new.page_title") %></h1>
<p><%= t("sign.app.authentication.new.description") %></p>

<ul>
  <li><%= link_to t("sign.app.authentication.new.links.email"), new_sign_app_in_email_path(pt: pt) %></li>
  <li><%= link_to t("sign.app.authentication.new.links.passkey"), new_sign_app_in_passkey_path(pt: pt) %>
  </li>
  <li><%= link_to t("sign.app.authentication.new.links.secret"), new_sign_app_in_secret_path(pt: pt) %>
  </li>
</ul>

<%= button_to continue_sign_app_social_authentication_path(provider: "google_app", ri: params[:ri]),
              method: :post,
              data: { turbo: false } do %>
  <%= t("sign.app.authentication.new.links.google") %>
<% end %>

<%= button_to continue_sign_app_social_authentication_path(provider: "apple", ri: params[:ri]),
              method: :post,
              data: { turbo: false } do %>
  <%= t("sign.app.authentication.new.links.apple") %>
<% end %>

<%= link_to new_sign_app_up_path(ri: params[:ri], pt: params[:pt]) do %>
  <%= t("sign.app.authentication.new.links.registration") %>
<% end %>
