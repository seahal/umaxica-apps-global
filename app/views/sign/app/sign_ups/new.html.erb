<% title t("sign.app.registration.new.page_title") %>

<h1><%= t("sign.app.registration.new.page_title") %></h1>

<ul>
  <li data-test-id="registration-method">
    <%= link_to t("sign.app.registration.new.methods.email.cta"),
                new_sign_app_up_email_path(ri: params[:ri]) %>
  </li>
  <li data-test-id="registration-method">
    <%= link_to t("sign.app.registration.new.methods.telephone.cta"),
                new_sign_app_up_telephone_path(ri: params[:ri]) %>
  </li>
</ul>

<div data-test-id="registration-method">
  <%= button_to continue_sign_app_social_authentication_path(provider: "google_app", ri: params[:ri], entry: "sign_up"),
                method: :post,
                form: { data: { turbo: false } } do %>
    <%= t("sign.app.registration.new.social.buttons.google") %>
  <% end %>
</div>

<div data-test-id="registration-method">
  <%= button_to continue_sign_app_social_authentication_path(provider: "apple", ri: params[:ri], entry: "sign_up"),
                method: :post,
                form: { data: { turbo: false } } do %>
    <%= t("sign.app.registration.new.social.buttons.apple") %>
  <% end %>
</div>

<%= link_to t("sign.app.registration.new.links.sign_in"), sign_app_sign_in_entrance_path %>
