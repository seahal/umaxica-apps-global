<% content_for :page_title, t("acme.app.preferences.language_settings") %>

<section>
  <div>
    <%= link_to t("acme.app.preferences.regions.back_link"),
                edit_sign_app_preference_region_path(lx: params[:lx], ri: params[:ri]) %>
  </div>

  <h1>
      <%= t("acme.app.preference.language.edit.heading") %>
  </h1>
  <p>
      <%= t("acme.app.preference.language.edit.description") %>
  </p>
  <%= form_with model: @preference_language, scope: :preference_language, url: sign_app_preference_language_path, method: :patch do |f| %>
    <div>
      <%= f.label :option_id,
                  t("acme.app.preference.language.edit.language_label") %>
      <div>
        <%= f.select :option_id,
                     options_for_select(
                       preference_language_options(AppPreferenceLanguageOption),
                       preference_language_selected(@preference_language.option_id, AppPreferenceLanguageOption),
                     ),
                     { include_blank: false },
                     {} %>
      </div>
    </div>

    <div>
      <%= f.submit t("acme.app.preferences.update_settings"),
                   data: { turbo_submits_with: t("acme.app.preferences.submitting") } %>
      <%= link_to t("acme.app.preferences.region_settings"), edit_sign_app_preference_region_path %>
    </div>
  <% end %>
</section>
