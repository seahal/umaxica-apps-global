<% content_for :page_title, t('apex.app.preferences.regions.title') %>

<section>
  <div>
    <div>
      <%= link_to t("apex.app.preferences.regions.back_link"),
                  sign_app_preference_path(lx: params[:lx], ri: params[:ri]) %>
    </div>

    <div></div>

    <div>
      <h1>
        <%= t("apex.app.preferences.regions.title") %>
      </h1>
      <p>
        <%= t("apex.app.preferences.regions.select_region_prompt") %>
      </p>
    </div>

    <%= form_with model: @preference_region, scope: :preference_region, url: sign_app_preference_region_url, method: :patch,
                  data: { controller: "unsaved-changes",
                          unsaved_changes_message_value: t("common.unsaved_changes") } do |f| %>

      <div>
        <h2>
          <%= t("apex.app.preferences.regions.region_section") %>
        </h2>

        <div>
          <%= f.label :option_id, t("apex.app.preferences.regions.select_region") %>
          <div>
            <%= f.select :option_id,
                         options_for_select(
                           AppPreferenceRegionOption.all.order(:id).filter_map do |o|
                             next if o.name.blank?

                             [t("apex.app.preferences.regions.select_region_selector.#{o.name}"), o.id]
                           end,
                           @preference_region.option_id
                          ),
                         { prompt: t("apex.app.preferences.regions.select_region_prompt") } %>
          </div>
        </div>
      </div>

      <div>
        <%= f.submit t("apex.app.preferences.update_settings"),
                     data: { turbo_submits_with: t("apex.app.preferences.submitting") } %>
      </div>
    <% end %>

    <div>
      <div>
        <%= link_to edit_sign_app_preference_region_timezone_path(lx: params[:lx], ri: params[:ri]) do %>
          <div>
            <span><%= t("apex.app.preferences.region.timezone.link") %></span>
          </div>
        <% end %>

        <%= link_to edit_sign_app_preference_region_language_path(lx: params[:lx], ri: params[:ri]) do %>
          <div>
            <span><%= t("apex.app.preferences.region.language.link") %></span>
          </div>
        <% end %>

        <%= link_to edit_sign_app_preference_region_currency_path(lx: params[:lx], ri: params[:ri]) do %>
          <div>
            <span><%= t("apex.app.preferences.region.currency.link", default: "Currency") %></span>
          </div>
        <% end %>

        <%= link_to edit_sign_app_preference_region_date_format_path(lx: params[:lx], ri: params[:ri]) do %>
          <div>
            <span><%= t("apex.app.preferences.region.date_format.link", default: "Date format") %></span>
          </div>
        <% end %>

        <%= link_to edit_sign_app_preference_region_time_format_path(lx: params[:lx], ri: params[:ri]) do %>
          <div>
            <span><%= t("apex.app.preferences.region.time_format.link", default: "Time format") %></span>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</section>
