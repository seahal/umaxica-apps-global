<h1><%= title "Dashboard" %></h1>

<p>Sign app signed-in landing.</p>

<section>
  <h2>Primary links</h2>
  <ul>
    <li><%= link_to "Root", sign_app_root_path(ri: params[:ri]) %></li>
    <li><%= link_to "Sign in", sign_app_sign_in_path(ri: params[:ri]) %></li>
    <li><%= link_to "Sign up", sign_app_sign_up_path(ri: params[:ri]) %></li>
    <li><%= link_to "Settings", sign_app_settings_path(ri: params[:ri]) %></li>
    <li><%= link_to "Logout", new_sign_app_sign_out_path(ri: params[:ri]) %></li>
  </ul>
</section>

<section>
  <h2>Ceremony links</h2>
  <ul>
    <li><%= link_to "Sign-in guard", sign_app_sign_in_guard_path(ri: params[:ri]) %></li>
    <li><%= link_to "Sign-in check", sign_app_sign_in_check_path(ri: params[:ri]) %></li>
    <li><%= link_to "Sign-in challenge", sign_app_sign_in_challenge_path(ri: params[:ri]) %></li>
    <li><%= link_to "Sign-in TOTP", new_sign_app_sign_in_challenge_totp_path(ri: params[:ri]) %></li>
    <li><%= link_to "Verification", sign_app_verification_path(ri: params[:ri]) %></li>
    <li><%= link_to "Verification TOTP", new_sign_app_verification_totp_path(ri: params[:ri]) %></li>
    <li>Selector: handled by the sign-in guard sequence, no direct dashboard route</li>
  </ul>
</section>
