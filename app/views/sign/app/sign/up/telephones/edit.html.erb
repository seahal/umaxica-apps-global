<% content_for :page_title, t("sign.app.registration.telephone.edit.page_title") %>
<% content_for :title, t("sign.app.registration.telephone.edit.page_title") %>

<div>
  <h1><%= t("sign.app.registration.telephone.edit.page_title") %></h1>
  <p><%= t("sign.app.registration.telephone.create.verification_code_sent") %></p>

  <%= form_with model: @user_telephone, url: sign_app_sign_up_check_telephone_otp_path(ri: params[:ri]), method: :patch, data: { turbo: false } do |form| %>

    <% if @user_telephone.errors.any? %>
      <div id="error_explanation">
        <h2><%= pluralize(@user_telephone.errors.count, "error") %> prohibited this sample from being saved:</h2>

        <ul>
          <% @user_telephone.errors.each do |error| %>
            <li><%= error.full_message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div>
      <%= form.label :pass_code, t("sign.app.registration.telephone.edit.code_label") %>
      <%= form.text_field :pass_code,
                          placeholder: t("sign.app.registration.telephone.edit.code_placeholder"),
                          autofocus: true,
                          autocomplete: "one-time-code",
                          inputmode: "numeric",
                          pattern: "[0-9]*" %>
    </div>

    <%= form.submit t("sign.app.registration.telephone.edit.submit") %>
  <% end %>

  <p><%= t("sign.app.registration.telephone.edit.delivery_help") %></p>

  <div>
    <%= button_to t("sign.app.registration.telephone.edit.resend_code"),
                  sign_app_sign_up_check_telephone_otp_path(ri: params[:ri]),
                  method: :post %>
  </div>

  <div>
    <%= link_to t("controller.sign.app.registration.telephone.edit.return_page"), sign_app_sign_up_path %>
  </div>

</div>
