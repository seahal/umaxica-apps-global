<% content_for :page_title, t("sign.app.authentication.email.edit.page_title") %>
<% content_for :title, t("sign.app.authentication.email.edit.page_title") %>

<div>
  <div>
    <div>
      <div>
        <h1><%= t("sign.app.authentication.email.edit.page_title") %></h1>
        <p>
          <%= t("sign.app.registration.email.create.verification_code_sent") %>
        </p>
      </div>

      <%= form_with model: @user_email, url: sign_app_sign_up_check_email_otp_path(ri: params[:ri]), method: :patch, data: { turbo: false } do |form| %>
        <% pt = signed_pt_param %>
        <%= hidden_field_tag :pt, pt if pt.present? %>

        <% if @user_email.errors.any? %>
          <div>
            <ul>
              <% @user_email.errors.each do |error| %>
                <li><%= error.full_message %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <div>
          <%= form.label :pass_code, t("sign.app.authentication.email.edit.code_label") %>
          <%= form.text_field :pass_code,
                              placeholder: t("sign.app.authentication.email.edit.code_placeholder"),
                              autofocus: true,
                              autocomplete: "one-time-code",
                              inputmode: "numeric",
                              pattern: "[0-9]*" %>
        </div>

        <%= form.submit t("sign.app.authentication.email.edit.submit") %>
      <% end %>

      <p><%= t("sign.app.authentication.email.edit.delivery_help") %></p>

      <div>
        <%= link_to t("sign.app.registration.email.edit.return_page"), sign_app_sign_up_path %>
      </div>
    </div>
  </div>
</div>
