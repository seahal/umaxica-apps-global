<% content_for :page_title, t('sign.app.registration.email.new.page_title') %>
<div>
  <div>
    <h2><%= t('sign.app.registration.email.new.page_title') %></h2>
  </div>

  <div>
    <%= form_with model: @user_email,
                  url: sign_app_sign_up_email_path,
                  method: "post",
                  data: { turbo: false } do |form| %>
      <% pt = signed_pt_param %>
      <%= hidden_field_tag :pt, pt if pt.present? %>

      <% if @user_email.errors.any? %>
        <div>
          <div>
            <div>
              <h3><%= t("sign.app.registration.email.new.error_summary") %></h3>
              <div>
                <ul role="list">
                  <% @user_email.errors.each do |error| %>
                    <li><%= error.full_message %></li>
                  <% end %>
                </ul>
              </div>
            </div>
          </div>
        </div>
      <% end %>

      <div>
        <%= form.label :raw_address, ClientEmail.human_attribute_name(:address) %>
        <div>
          <%= form.email_field :raw_address, autocomplete: "email", required: true %>
        </div>
      </div>

      <div>
        <div>
          <%= form.check_box :confirm_policy %>
        </div>
        <div>
          <%= form.label :confirm_policy, t("views.sign.app.up.emails.new.confirm_policy_label") %>
        </div>
      </div>

      <div>
        <%= form.check_box :promotional %>
        <%= form.label :promotional, t("sign.app.settings.email.edit.promotional_label") %>
        <p><%= t("sign.app.settings.email.edit.promotional_description") %></p>
      </div>

      <div>
        <%= form.check_box :notifiable %>
        <%= form.label :notifiable, t("sign.app.settings.email.edit.notifiable_label") %>
        <p><%= t("sign.app.settings.email.edit.notifiable_description") %></p>
      </div>

      <div>
        <%= render "shared/cloudflare_turnstile_visible" %>
      </div>

      <div>
        <%= form.submit %>
      </div>
    <% end %>

    <div>
      <div>
        <div>
          <%= link_to t("sign.app.registration.new.page_title"), sign_app_sign_up_path %>
        </div>
        <div>
          <%= link_to t('sign.app.registration.email.new.link_to_sign_in'), new_sign_app_sign_in_email_path %>
        </div>
      </div>
    </div>
  </div>
</div>
