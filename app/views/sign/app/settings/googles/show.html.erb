<% content_for :page_title, t("controller.sign.app.setting.index.google") %>

<%= link_to t("sign.app.settings.show.back"), sign_app_settings_path %>

<div>
  <h3><%= t("controller.sign.app.setting.index.google") %></h3>
  <p><%= t("views.sign.app.settings.googles.show.description") %></p>
  <p>
    <% if current_client.active_social_provider?("google") %>
      <%= t("views.sign.app.settings.googles.show.linked") %>
    <% else %>
      <%= t("views.sign.app.settings.googles.show.unlinked") %>
    <% end %>
  </p>
  <%= link_to t("actions.edit"), edit_sign_app_settings_google_path(ri: params[:ri]) %>
</div>
