<% content_for :page_title, t("controller.sign.app.setting.index.google") %>

<%= link_to t("sign.app.settings.show.back"), sign_app_settings_google_path(ri: params[:ri]) %>

<div>
  <h3><%= t("controller.sign.app.setting.index.google") %></h3>
  <p><%= t("views.sign.app.settings.googles.show.description") %></p>

  <% if current_client.active_social_provider?("google") %>
    <% unlink_allowed = current_client.social_unlink_methods_remaining?(excluding_provider: "google") %>
    <%= form_with url: sign_app_settings_google_path(ri: params[:ri]), method: :delete do |f| %>
      <%= render "shared/cloudflare_turnstile_stealth" if unlink_allowed %>
      <%= f.submit t("actions.disconnect"), disabled: !unlink_allowed %>
    <% end %>
    <% unless unlink_allowed %>
      <p><%= t("errors.social_auth.insufficient_login_methods") %></p>
    <% end %>
  <% else %>
    <%= button_to t("actions.connect"),
                  sign_app_settings_google_path(ri: params[:ri]),
                  method: :patch,
                  form: { data: { turbo: false } },
                  params: { intent: "link" } %>
  <% end %>
</div>
