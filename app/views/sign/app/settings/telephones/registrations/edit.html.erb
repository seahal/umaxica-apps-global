<% content_for :page_title, t("views.sign.app.settings.telephones.registrations.edit.page_title") %>
<div>
  <div>
    <h1><%= t("views.sign.app.settings.telephones.registrations.edit.heading") %></h1>
    <p><%= t("views.sign.app.settings.telephones.registrations.edit.description") %></p>
  </div>

  <div>
    <%= form_with model: @user_telephone,
                  url: sign_app_settings_telephones_registration_path,
                  method: :patch do |form| %>
      <% if @user_telephone.errors.any? %>
        <div>
          <h2><%= pluralize(@user_telephone.errors.count, "error") %></h2>
          <ul>
            <% @user_telephone.errors.each do |error| %>
              <li><%= error.full_message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div>
        <%= form.label :pass_code %>
        <%= form.text_field :pass_code %>
      </div>

      <div>
        <%= render "shared/cloudflare_turnstile_stealth" %>
      </div>

      <div>
        <%= form.submit t("actions.submit") %>
      </div>
    <% end %>

    <div>
      <%= link_to t("actions.cancel"), sign_app_settings_telephones_path %>
    </div>
  </div>
</div>
