<% content_for :page_title, t("sign.app.authentication.email.edit.page_title") %>
<h1><%= t("sign.app.authentication.email.edit.page_title") %></h1>
<p><%= t("sign.app.authentication.email.edit.description") %></p>

<%= form_with model: @user_email, url: sign_app_settings_emails_registration_path, method: :patch, scope: :user_email do |f| %>
  <%= render "sign/app/emails/registrations/verification_fields", form: f, user_email: @user_email, verification_token: @verification_token %>
<% end %>

<% acme_host = ENV.fetch("ACME_SERVICE_URL", "www.app.localhost") %>
<div>
  <%= button_to t("otp.resend.button"),
                sign_app_settings_emails_registration_redelivery_path(ri: params[:ri], pt: signed_pt_param),
                method: :post %>
</div>

<div>
  <%= link_to t("sign.app.common.cancel"), "https://#{acme_host}/settings/emails?ri=#{params[:ri]}" %>
</div>
