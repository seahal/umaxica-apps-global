<% content_for :page_title, 'Telephones' %>
<%= link_to t('sign.app.configuration.show.back'), sign_app_configuration_path %>

<div>
  <div>
    <%= link_to t('sign.app.configuration.telephone.index.new_link'),
                new_sign_app_configuration_telephones_registration_path %>
  </div>
</div>

<div>
  <div>
    <div>
      <div>
        <table>
          <thead>
          <tr>
            <th scope="col"><%= t('activerecord.attributes.user_telephone.number') %></th>
            <th scope="col"><%= t('activerecord.attributes.user_telephone.status') %></th>
            <th scope="col">
              <span><%= t("views.sign.app.configuration.telephones.index.actions") %></span>
            </th>
          </tr>
          </thead>
          <tbody>
          <% @user_telephones.each do |telephone| %>
            <tr>
              <td><%= telephone.number %></td>
              <td>
                <% if [UserTelephoneStatus::VERIFIED, UserTelephoneStatus::VERIFIED_WITH_SIGN_UP].include?(telephone.user_telephone_status_id) %>
                      <span>
                        <%= t("views.sign.app.configuration.telephones.index.verified") %>
                      </span>
                <% else %>
                      <span>
                        <%= t("views.sign.app.configuration.telephones.index.unverified") %>
                      </span>
                <% end %>
              </td>
              <td>
                <%= link_to t("sign.app.configuration.telephone.index.edit"),
                            edit_sign_app_configuration_telephone_path(telephone) %>
              </td>
            </tr>
          <% end %>
          <% if @user_telephones.empty? %>
            <tr>
              <td colspan="3" class="italic">
                <%= t("views.sign.app.configuration.telephones.index.empty") %>
              </td>
            </tr>
          <% end %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>
