<%= link_to t('sign.app.configuration.show.back'), sign_app_configuration_totps_path(ri: params[:ri]) %>

<% content_for :page_title, t('sign.app.configuration.totp.new.page_title') %>
<div>
  <div>
    <div>
      <div>
        <h3>
          <%= t('sign.app.configuration.totp.new.page_title') %>
        </h3>
        <p>
          <%= t('sign.app.configuration.totp.new.description') %>
        </p>
      </div>
    </div>

    <div>
      <%= form_with model: @totp,
                    scope: :user_totp_credential,
                    url: sign_app_configuration_totps_path(ri: params[:ri]) do |form| %>
        <div>
          <% if @totp.errors.any? %>
            <div>
              <div>
                <div>
                  <h3>
                    <%= t('errors.template.header', model: @totp.model_name.human, count: @totp.errors.count) %>
                  </h3>
                  <div>
                    <ul role="list">
                      <% @totp.errors.full_messages.each do |message| %>
                        <li><%= message %></li>
                      <% end %>
                    </ul>
                  </div>
                </div>
              </div>
            </div>
          <% end %>

          <div>
            <!-- QR Code container explicitly white for readability -->
            <div>
              <%= image_tag "data:image/png;base64, #{Base64.strict_encode64(@png.to_s)}", alt: "QR Code" %>
            </div>
            <p>
              <%= t("views.sign.app.configuration.totps.new.qr_fallback") %>
            </p>
          </div>

          <div>
            <div>
              <%= form.label :title, t('activerecord.attributes.user_totp_credential.title') %>
              <div>
                <%= form.text_field :title, maxlength: 32, placeholder: t('messages.totp_title_placeholder') %>
              </div>
              <p>
                <%= t('sign.app.configuration.totp.new.title_hint') %>
              </p>
            </div>

            <div>
              <%= form.label :first_token, t("views.sign.app.configuration.totps.new.first_token_label") %>
              <div>
                <%= form.text_field :first_token, placeholder: "000000", maxlength: 16, inputmode: "numeric", autocomplete: "one-time-code" %>
              </div>
              <p><%= t("views.sign.app.configuration.totps.new.first_token_help") %></p>
            </div>

            <%= render "shared/cloudflare_turnstile_stealth" %>
          </div>
        </div>

        <div>
          <%= link_to t('actions.cancel'), sign_app_configuration_totps_path(ri: params[:ri]) %>
          <%= form.submit t('actions.save') %>
        </div>
      <% end %>
    </div>
  </div>
</div>
