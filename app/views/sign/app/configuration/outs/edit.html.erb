<% content_for :page_title, 'Edit Out' %>
<%= link_to t('sign.app.configuration.show.back'), sign_app_configuration_path %>

<div>
  <div>
    <div>

      <%= form_with url: sign_app_configuration_out_path, method: :delete do |form| %>

        <div>
          <div>
            <%= form.check_box :confirm, required: true %>
          </div>
          <div>
            <%= form.label :confirm, t("views.sign.app.configuration.outs.edit.confirm_label") %>
            <p>
              <%= t("views.sign.app.configuration.outs.edit.confirm_description") %>
            </p>
          </div>
        </div>

        <%= form.submit t("sign.shared.sign_out.button") %>
      <% end %>

    </div>
  </div>
</div>
