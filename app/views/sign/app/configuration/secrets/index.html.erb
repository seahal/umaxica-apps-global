<% content_for :page_title, 'Secrets' %>
<%= link_to t('sign.app.configuration.show.back'), sign_app_configuration_path %>

<div>
  <div>
    <%= link_to t('.new'), new_sign_app_configuration_secret_path %>
  </div>
</div>
<div>
  <div>
    <div>
      <div>
        <table>
          <thead>
          <tr>
            <th scope="col"><%= t('activerecord.attributes.user_secret.name') %></th>
            <th scope="col"><%= t('activerecord.attributes.user_secret.created_at') %></th>
            <th scope="col"><%= t('activerecord.attributes.user_secret.last_used_at') %></th>
            <th scope="col">
              <span>Actions</span>
            </th>
          </tr>
          </thead>
          <tbody>
          <% @secrets.each do |secret| %>
            <tr>
              <td><%= secret.name %></td>
              <td><%= l(secret.created_at, format: :short) %></td>
              <td><%= secret.last_used_at ? l(secret.last_used_at, format: :short) : '-' %></td>
              <td>
                <%= link_to t('actions.edit'), edit_sign_app_configuration_secret_path(secret, ri: params[:ri]) %>
                <%= button_to t('actions.destroy'),
                              sign_app_configuration_secret_path(secret, ri: params[:ri]),
                              method: :delete,
                              data: { turbo_confirm: t('messages.confirm_destroy') } %>
              </td>
            </tr>
          <% end %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>
</div>
