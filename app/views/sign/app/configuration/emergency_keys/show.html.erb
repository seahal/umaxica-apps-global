<% content_for :page_title, t("sign.app.configuration.emergency_key.show.title") %>

<h1><%= t("sign.app.configuration.emergency_key.show.title") %></h1>

<% if @raw_secret_credential.present? %>
  <p><%= t("sign.app.configuration.emergency_key.show.description") %></p>
  <p><%= t("sign.app.configuration.emergency_key.show.one_time_notice") %></p>
  <pre><code><%= @raw_secret_credential %></code></pre>
<% else %>
  <p><%= t("sign.app.configuration.emergency_key.missing") %></p>
<% end %>

<%= link_to t("sign.app.configuration.emergency_key.show.back_to_settings"),
            sign_app_configuration_path(ri: params[:ri]) %>
