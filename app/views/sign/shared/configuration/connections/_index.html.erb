<% content_for :page_title, t("sign.configuration.connections.index.page_title") %>
<%= link_to t("sign.app.configuration.show.back"), configuration_path %>

<h1><%= t("sign.configuration.connections.index.page_title") %></h1>
<p><%= t("sign.configuration.connections.index.description") %></p>

<% if @connections.any? %>
  <table>
    <thead>
    <tr>
      <th><%= t("sign.configuration.connections.table.rp_name") %></th>
      <th><%= t("sign.configuration.connections.table.domain") %></th>
      <th><%= t("sign.configuration.connections.table.status") %></th>
      <th><%= t("sign.configuration.connections.table.last_used_at") %></th>
      <th><%= t("sign.configuration.connections.table.scope") %></th>
      <th><%= t("sign.configuration.connections.table.actions") %></th>
    </tr>
    </thead>
    <tbody>
    <% @connections.each do |connection| %>
      <tr>
        <td><%= connection.rp_name %></td>
        <td><%= connection.rp_domain_text %></td>
        <td><%= connection_status_label(connection) %></td>
        <td><%= connection_last_used_text(connection) %></td>
        <td><%= connection_scopes_text(connection) %></td>
        <td>
          <%= link_to t("sign.configuration.connections.actions.detail"), connection_path_for(connection) %>
          <% if connection.active? %>
            <%= button_to t("sign.configuration.connections.actions.revoke"),
                          connection_path_for(connection),
                          method: :delete,
                          data: { turbo_confirm: t("sign.configuration.connections.actions.revoke_confirm") } %>
          <% end %>
        </td>
      </tr>
    <% end %>
    </tbody>
  </table>
<% else %>
  <p><%= t("sign.configuration.connections.index.empty") %></p>
<% end %>
