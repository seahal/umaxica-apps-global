<% content_for :page_title, t("sign.shared.sign_out.title") %>

<div>
  <h1><%= title t("sign.shared.sign_out.title") %></h1>

  <% if sign_out_active_context_present? %>
    <p><%= t("sign.shared.sign_out.confirm_description") %></p>
    <%= button_to t("sign.shared.sign_out.button"),
                  sign_out_confirmation_form_path,
                  form: { data: { turbo: false } } %>
  <% else %>
    <p><%= t("sign.shared.sign_out.already_signed_out") %></p>
  <% end %>

  <p><%= link_to t("sign.shared.sign_out.home_link"), sign_out_home_path %></p>
</div>
