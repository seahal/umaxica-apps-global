<% content_for :page_title, I18n.t("sign.app.registration.checkpoint.show.page_title") %>

<%= form_with url: completion_url, method: :post, local: true, authenticity_token: false, data: { turbo: false }, html: { id: "email-signup-completion-form" } do %>
  <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
  <%= hidden_field_tag :completion_token, completion_token %>
  <%= hidden_field_tag :completion_actor_token, completion_actor_token %>
  <%= hidden_field_tag :completion_email_token, completion_email_token %>
  <%= hidden_field_tag :ri, ri if ri.present? %>
  <%= hidden_field_tag :pt, pt if pt.present? %>
  <noscript>
    <%= submit_tag I18n.t("sign.app.registration.checkpoint.show.complete", default: "Continue") %>
  </noscript>
<% end %>

<script nonce="<%= content_security_policy_nonce %>">
  document.getElementById("email-signup-completion-form").submit();
</script>
