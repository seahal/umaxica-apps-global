<% content_for :page_title, t("sign.app.configuration.telephone.new.title") %>
<div>
  <div>
    <div>
      <div>
        <h3><%= t("sign.app.configuration.telephone.new.title") %></h3>
        <p>
          <%= t("views.sign.com.configuration.telephones.registrations.new.description") %>
        </p>
      </div>
    </div>

    <div>
      <%= form_with(model: @user_telephone,
                    url: sign_com_configuration_telephones_registration_path(ri: params[:ri])) do |form| %>
        <div>
          <div>
            <div>
              <%= form.label :raw_number, VisitorTelephone.human_attribute_name(:number) %>
              <div>
                <%= form.telephone_field :raw_number, placeholder: "+819012345678" %>
              </div>
              <p><%= t("views.sign.com.configuration.telephones.registrations.new.help_text") %></p>
            </div>
          </div>
        </div>
        <div>
          <%= render "shared/cloudflare_turnstile_stealth" %>
        </div>
        <div>
          <%= link_to t("actions.cancel"), sign_com_configuration_telephones_path(ri: params[:ri]) %>
          <%= form.submit t("actions.submit") %>
        </div>
      <% end %>
    </div>
  </div>
</div>
