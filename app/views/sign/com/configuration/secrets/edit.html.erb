<% content_for :page_title, t("sign.app.configuration.secrets.edit.title") %>
<div>
  <div>
    <div>
      <div>
        <h3><%= t("sign.app.configuration.secrets.edit.title") %></h3>
        <p><%= t("sign.app.configuration.secrets.edit.description") %></p>
      </div>
    </div>
    <div>
      <%= form_with(model: @secret, url: sign_com_configuration_secret_path(@secret, ri: params[:ri]), method: :patch) do |form| %>
        <div>
          <% if @secret.errors.any? %>
            <div>
              <div>
                <div>
                  <h3><%= t('errors.template.header', model: @secret.model_name.human, count: @secret.errors.count) %></h3>
                  <div>
                    <ul role="list">
                      <% @secret.errors.full_messages.each do |message| %>
                        <li><%= message %></li>
                      <% end %>
                    </ul>
                  </div>
                </div>
              </div>
            </div>
          <% end %>

          <div>
            <div>
              <%= form.label :name %>
              <div>
                <%= form.text_field :name %>
              </div>
            </div>
          </div>
          <div>
            <%= form.check_box :enabled, {}, "1", "0" %>
            <%= form.label :enabled %>
          </div>

          <%= render "shared/cloudflare_turnstile_stealth" %>
        </div>
        <div>
          <%= link_to t('actions.cancel'), sign_com_configuration_secrets_path(ri: params[:ri]) %>
          <%= form.submit t('actions.update') %>
        </div>
      <% end %>
    </div>
  </div>
</div>
