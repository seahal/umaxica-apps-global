<% content_for :page_title, t("sign.app.registration.telephone.new.page_title") %>

<div>
  <div>
    <h2><%= t("sign.app.registration.telephone.new.page_title") %></h2>
  </div>

  <div>
    <%= form_with model: @visitor_telephone, url: sign_com_up_telephone_path(ri: params[:ri]), method: :post, data: { turbo: false } do |form| %>
      <% if @visitor_telephone.errors.any? %>
        <div>
          <ul role="list">
            <% @visitor_telephone.errors.each do |error| %>
              <li><%= error.full_message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div>
        <%= form.label :raw_number, VisitorTelephone.human_attribute_name(:number) %>
        <%= form.text_field :raw_number, autocomplete: "tel", required: true %>
      </div>

      <div>
        <%= form.check_box :confirm_policy %>
        <%= form.label :confirm_policy, t("views.sign.com.up.telephones.new.confirm_policy_label") %>
      </div>

      <div>
        <%= form.check_box :confirm_using_mfa %>
        <%= form.label :confirm_using_mfa, t("views.sign.com.up.telephones.new.confirm_using_mfa_label") %>
      </div>

      <div>
        <%= render "shared/cloudflare_turnstile_visible" %>
      </div>

      <div>
        <%= form.submit %>
      </div>
    <% end %>

    <div>
      <%= link_to t("sign.app.registration.telephone.new.link_to_other_methods"), new_sign_com_up_path(ri: params[:ri]) %>
    </div>
    <div>
      <%= link_to t("sign.app.registration.telephone.new.link_to_sign_in"), new_sign_com_in_path(ri: params[:ri]) %>
    </div>
  </div>
</div>
