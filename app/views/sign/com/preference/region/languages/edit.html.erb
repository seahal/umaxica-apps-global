<% content_for :page_title, t('apex.com.preferences.language_settings') %>

<section>
  <div>
    <%= link_to t("apex.com.preferences.regions.back_link"),
                edit_sign_com_preference_region_path(lx: params[:lx], ri: params[:ri]) %>
  </div>

  <h1>
      <%= t("apex.com.preference.language.edit.heading") %>
  </h1>
  <p>
      <%= t("apex.com.preference.language.edit.description") %>
  </p>

  <%= form_with model: @preference_language, scope: :preference_language, url: sign_com_preference_region_language_path, method: :patch do |f| %>
    <div>
      <%= f.label :option_id,
                  t("apex.com.preference.language.edit.language_label") %>
      <div>
        <%= f.select :option_id,
                     options_for_select(
                       preference_language_options(ComPreferenceLanguageOption),
                       preference_language_selected(@preference_language.option_id, ComPreferenceLanguageOption),
                     ),
                     { include_blank: false },
                     {} %>
      </div>
    </div>

    <div>
      <%= f.submit t('apex.com.preferences.update_settings'),
                   data: { turbo_submits_with: t("apex.com.preferences.submitting") } %>
      <%= link_to t('apex.com.preferences.region_settings'), edit_sign_com_preference_region_path %>
    </div>
  <% end %>
</section>
