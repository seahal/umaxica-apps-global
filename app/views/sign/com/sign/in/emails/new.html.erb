<% title t("sign.app.authentication.email.new.page_title") %>
<% pt = signed_pt_param %>

<div>
  <div>
    <div>
      <div>
        <h1>
          <%= t("sign.app.authentication.email.new.page_title") %>
        </h1>
        <p>
          <%= t("sign.app.registration.new.social.disclaimer", product: "UMAXICA") %>
        </p>
      </div>

      <%= form_with model: @user_email,
                    scope: :user_email,
                    url: sign_com_sign_in_email_path,
                    data: { turbo: false } do |form| %>
        <%= hidden_field_tag :pt, pt if pt.present? %>

        <% if @user_email.errors.any? %>
          <div class="animate-shake">
            <ul>
              <% @user_email.errors.each do |error| %>
                <li>
                  <span><%= error.full_message %></span>
                </li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <div>
          <%= form.label :address %>
          <div>
            <%= form.email_field :address,
                                 placeholder: "name@example.com",
                                 required: true %>
            <div></div>
          </div>
        </div>

        <div>
          <%= render "shared/cloudflare_turnstile_visible" %>
        </div>

        <div>
          <%= form.submit t("actions.submit") %>
        </div>
      <% end %>

      <div>
        <%= link_to sign_com_sign_in_entrance_path(pt: pt) do %>
          <span><%= t("sign.app.authentication.new.back") %></span>
        <% end %>
      </div>
    </div>
  </div>
</div>
