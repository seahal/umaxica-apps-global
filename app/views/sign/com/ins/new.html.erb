<% content_for :page_title, t("sign.com.authentication.new.page_title") %>
<% pt = params[:pt].presence %>
<h1><%= t("sign.com.authentication.new.page_title") %></h1>
<p><%= t("sign.com.authentication.new.description") %></p>

<ul>
  <li><%= link_to t("sign.com.authentication.new.links.email"), new_sign_com_in_email_path(pt: pt) %></li>
  <li><%= link_to t("sign.com.authentication.new.links.passkey"), new_sign_com_in_passkey_path(pt: pt) %>
  </li>
  <li><%= link_to t("sign.com.authentication.new.links.secret"), new_sign_com_in_secret_path(pt: pt) %>
  </li>
</ul>

<%= link_to new_sign_com_up_path(ri: params[:ri], pt: params[:pt]) do %>
  <%= t("sign.com.authentication.new.links.registration") %>
<% end %>
