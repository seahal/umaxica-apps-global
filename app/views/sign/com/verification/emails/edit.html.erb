<% title t("sign.app.verification.edit.title") %>
<% verification_scope = @verification_scope %>
<% verification_pt = @verification_pt %>

<div>
  <h1><%= t("sign.app.verification.edit.title") %></h1>
  <p><%= t("sign.app.verification.edit.email_description") %></p>

  <% if @verification_errors&.any? %>
    <div>
      <%= @verification_errors.to_sentence %>
    </div>
  <% end %>

  <%= form_with url: sign_com_verification_email_path(params[:id], ri: params[:ri]), method: :patch, data: { turbo: false } do |f| %>
    <%= f.hidden_field :scope, value: verification_scope, name: "verification[scope]" %>
    <%= f.hidden_field :pt, value: verification_pt, name: "verification[pt]" %>
    <div>
      <%= f.label :code, t("sign.app.verification.edit.code_label") %>
      <%= f.text_field :code, inputmode: "numeric", autocomplete: "one-time-code", placeholder: t("sign.app.verification.edit.code_placeholder"), name: "verification[code]" %>
    </div>

    <div>
      <%= f.submit t("sign.app.verification.edit.submit") %>
    </div>
  <% end %>

  <div>
    <%= button_to t("otp.resend.button"),
                  resend_sign_com_verification_email_path(
                    params[:id],
                    ri: params[:ri],
                    scope: verification_scope,
                    pt: verification_pt
                  ),
                  method: :post %>
  </div>

  <div>
    <%= link_to t("sign.app.verification.edit.back"),
                sign_com_verification_path(
                  ri: params[:ri],
                  scope: verification_scope,
                  pt: verification_pt
                ) %>
  </div>
</div>
