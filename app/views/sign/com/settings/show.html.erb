<% content_for :page_title, t("sign.app.settings.show.page_title") %>

<h1><%= t("sign.app.settings.show.page_title") %></h1>

<section>
  <h2><%= t("sign.app.settings.show.security_settings") %></h2>
  <ul>
    <li><%= link_to t("controller.sign.app.setting.index.passkey"), sign_com_settings_passkeys_path %></li>
    <li><%= link_to t("controller.sign.app.setting.index.secret_credential"), sign_com_settings_secret_credentials_path %></li>
    <li><%= link_to t("sign.app.settings.show.mfa"), sign_com_settings_mfa_challenge_path(ri: params[:ri]) %></li>
  </ul>
</section>
<br />
<section>
  <h2><%= t("sign.app.settings.show.account_settings") %></h2>
  <ul>
    <li><%= link_to t("controller.sign.app.setting.index.email"), sign_com_settings_emails_path %></li>
    <li><%= link_to t("controller.sign.app.setting.index.telephone"), sign_com_settings_telephones_path(ri: params[:ri]) %></li>
    <li><%= link_to t("controller.sign.app.setting.index.birthdate"), sign_com_settings_birthdate_path(ri: params[:ri]) %></li>
    <li><%= link_to t("controller.sign.app.setting.index.session"), sign_com_settings_sessions_path %></li>
    <li><%= link_to t("controller.sign.app.setting.index.activity"), sign_com_settings_activities_path %></li>
  </ul>
</section>
<br />
<section>
  <h2><%= t("sign.app.settings.show.others") %></h2>
  <ul>
    <li><%= link_to t("sign.app.settings.show.logout"), sign_com_sign_out_url(ri: params[:ri]) %></li>
    <li><%= link_to t("sign.app.settings.show.withdrawal"), new_sign_com_settings_withdrawal_path %></li>
  </ul>
</section>
