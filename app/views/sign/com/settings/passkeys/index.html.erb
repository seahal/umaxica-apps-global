<% content_for :page_title, t('sign.org.settings.passkeys.index.title') %>

<div>
  <div>
    <h1><%= t('sign.org.settings.passkeys.index.title') %></h1>
    <%= link_to t('sign.org.settings.passkeys.index.add'), new_sign_com_settings_passkey_path(ri: params[:ri]) %>
  </div>

  <table>
    <thead>
    <tr>
      <th scope="col"><%= t('activerecord.attributes.staff_passkey.description') %></th>
      <th scope="col"><%= t('activerecord.attributes.staff_passkey.created_at') %></th>
      <th scope="col"><%= t('actions.actions') %></th>
    </tr>
    </thead>
    <tbody>
    <% @passkeys.each do |passkey| %>
      <tr>
        <td><%= passkey.description %></td>
        <td><%= l(passkey.created_at, format: :short) %></td>
        <td>
          <%= link_to t('actions.edit'), edit_sign_com_settings_passkey_path(passkey, ri: params[:ri]) %>
          <%= form_with url: sign_com_settings_passkey_path(passkey, ri: params[:ri]),
                        method: :delete,
                        data: { turbo_confirm: t('messages.confirm_destroy') } do |form| %>
            <%= render "shared/cloudflare_turnstile_stealth" %>
            <%= form.submit t('actions.destroy') %>
          <% end %>
        </td>
      </tr>
    <% end %>
    <% if @passkeys.empty? %>
      <tr>
        <td colspan="3"><%= t('sign.org.settings.passkeys.index.empty') %></td>
      </tr>
    <% end %>
    </tbody>
  </table>

  <%= link_to t('sign.org.settings.passkeys.index.back'), sign_com_settings_path(ri: params[:ri]) %>
</div>
