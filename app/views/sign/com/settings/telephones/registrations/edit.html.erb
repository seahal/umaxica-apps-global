<% content_for :page_title, t("sign.app.registration.telephone.edit.page_title") %>
<div>
  <div>
    <h1><%= t("sign.app.registration.telephone.edit.page_title") %></h1>
    <p><%= t("sign.app.registration.telephone.create.verification_code_sent") %></p>
  </div>

  <div>
    <%= form_with model: @user_telephone,
                  url: sign_com_settings_telephones_registration_path(ri: params[:ri]),
                  method: :patch do |form| %>
      <% if @user_telephone.errors.any? %>
        <div>
          <h2><%= pluralize(@user_telephone.errors.count, "error") %></h2>
          <ul>
            <% @user_telephone.errors.each do |error| %>
              <li><%= error.full_message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div>
        <%= form.label :pass_code, t("sign.app.registration.telephone.edit.code_label") %>
        <%= form.text_field :pass_code,
                            placeholder: t("sign.app.registration.telephone.edit.code_placeholder"),
                            autofocus: true,
                            autocomplete: "one-time-code",
                            inputmode: "numeric",
                            pattern: "[0-9]*" %>
      </div>

      <p><%= t("sign.app.registration.telephone.edit.delivery_help") %></p>

      <div>
        <%= render "shared/cloudflare_turnstile_stealth" %>
      </div>

      <div>
        <%= form.submit t("sign.app.registration.telephone.edit.submit") %>
      </div>
    <% end %>

    <div>
      <%= link_to t("actions.cancel"), sign_com_settings_telephones_path(ri: params[:ri]) %>
    </div>
  </div>
</div>
