<% content_for :page_title, 'Secrets' %>
<%= link_to 'Back', sign_com_settings_path(ri: params[:ri]) %>

<div>
  <%= link_to 'New', new_sign_com_settings_secret_credential_path(ri: params[:ri]) %>
</div>

<table>
  <thead>
  <tr>
    <th scope="col">Name</th>
    <th scope="col">Created</th>
    <th scope="col">Last used</th>
    <th scope="col">Actions</th>
  </tr>
  </thead>
  <tbody>
  <% @secret_credentials.each do |secret_credential| %>
    <tr>
      <td><%= secret_credential.name %></td>
      <td><%= l(secret_credential.created_at, format: :short) %></td>
      <td><%= secret_credential.last_used_at ? l(secret_credential.last_used_at, format: :short) : '-' %></td>
      <td>
        <%= link_to 'Show', sign_com_settings_secret_credential_path(secret_credential.public_id, ri: params[:ri]) %>
        <%= link_to t('actions.edit'), edit_sign_com_settings_secret_credential_path(secret_credential.public_id, ri: params[:ri]) %>
        <%= form_with(url: sign_com_settings_secret_credential_path(secret_credential.public_id, ri: params[:ri]),
                      method: :delete,
                      data: { turbo_confirm: t('messages.confirm_destroy') }) do |form| %>
          <%= render "shared/cloudflare_turnstile_stealth" %>
          <%= form.submit t('actions.destroy') %>
        <% end %>
      </td>
    </tr>
  <% end %>
  </tbody>
</table>
