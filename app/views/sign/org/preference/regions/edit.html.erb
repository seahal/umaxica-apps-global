<% content_for :page_title, t("acme.org.preferences.regions.title") %>
<section>
  <div>
    <div>
      <%= link_to t("acme.org.preferences.regions.back_link"),
                  sign_org_preference_path(lx: params[:lx], ri: params[:ri]) %>
    </div>

    <div></div>

    <div>
      <h1>
        <%= t("acme.org.preferences.regions.title") %>
      </h1>
      <p>
        <%= t("acme.org.preferences.regions.select_region_prompt") %>
      </p>
    </div>

    <%= form_with model: @preference_region, scope: :preference_region, url: sign_org_preference_region_url, method: :patch,
                  data: { controller: "unsaved-changes",
                          unsaved_changes_message_value: t("common.unsaved_changes") } do |f| %>

      <div>
        <h2>
          <%= t("acme.org.preferences.regions.region_section") %>
        </h2>
        <div>
          <%= f.label :option_id, t("acme.org.preferences.regions.select_region") %>
          <div>
            <%= f.select :option_id,
                         options_for_select(
                           OrgPreferenceRegionOption.all.order(:id).filter_map do |o|
                             next if o.name.blank?

                             [t("acme.org.preferences.regions.select_region_selector.#{o.name}"), o.id]
                           end,
                           @preference_region.option_id
                          ),
                         { include_blank: false } %>
          </div>
        </div>
      </div>

      <div>
        <%= f.submit t("acme.org.preferences.update_settings"),
                     data: { turbo_submits_with: t("acme.org.preferences.submitting") } %>
      </div>
    <% end %>

    <div>
      <div>
        <%= link_to edit_sign_org_preference_timezone_path(lx: params[:lx], ri: params[:ri]) do %>
          <div>
            <span><%= t("acme.org.preferences.region.timezone.link") %></span>
          </div>
        <% end %>

        <%= link_to edit_sign_org_preference_language_path(lx: params[:lx], ri: params[:ri]) do %>
          <div>
            <span><%= t("acme.org.preferences.region.language.link") %></span>
          </div>
        <% end %>

        <%= link_to edit_sign_org_preference_currency_path(lx: params[:lx], ri: params[:ri]) do %>
          <div>
            <span><%= t("acme.org.preferences.region.currency.link", default: "Currency") %></span>
          </div>
        <% end %>

        <%= link_to edit_sign_org_preference_date_path(lx: params[:lx], ri: params[:ri]) do %>
          <div>
            <span><%= t("acme.org.preferences.region.date_format.link", default: "Date format") %></span>
          </div>
        <% end %>

        <%= link_to edit_sign_org_preference_time_path(lx: params[:lx], ri: params[:ri]) do %>
          <div>
            <span><%= t("acme.org.preferences.region.time_format.link", default: "Time format") %></span>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</section>
