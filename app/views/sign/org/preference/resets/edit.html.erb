<% content_for :page_title, t('apex.org.preference.resets.title') %>

<section>
  <div>
    <%= link_to t("apex.org.preferences.regions.back_link"),
                sign_org_preference_path(lx: params[:lx], ri: params[:ri]) %>
  </div>

  <h1>
    <%= t("apex.org.preference.resets.title") %>
  </h1>

  <p>
    <%= t("apex.org.preference.resets.description") %>
  </p>

  <%= form_with url: sign_org_preference_reset_path, method: :delete do |f| %>
    <% if @preference&.errors&.any? %>
      <div>
        <ul>
          <% @preference.errors.each do |error| %>
            <li><%= error.full_message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div>
      <%= check_box_tag :confirm_reset, "1", @preference&.confirm_reset == "1", required: true %>
      <%= label_tag :confirm_reset, t("apex.org.preference.resets.confirm") %>
    </div>

    <div>
      <%= f.submit t("apex.org.preference.resets.button"),
                   data: { turbo_submits_with: t("apex.org.preferences.submitting") } %>
    </div>
  <% end %>
</section>
