<% content_for :page_title, t("sign.org.authentication.new.page_title") %>
<% pt = signed_pt_param %>
<div class="animate-fade-in-up">
  <div>
    <h1>
      <%= t("sign.org.authentication.new.page_title") %>
    </h1>
    <p>
      <%= t("sign.org.authentication.new.description") %>
    </p>
  </div>

  <div>
    <%= link_to new_sign_org_in_passkey_path(pt: pt, ri: params[:ri]) do %>
      <span><%= t("sign.org.authentication.new.links.passkey") %></span>
    <% end %>

    <%= link_to new_sign_org_in_secret_credential_path(pt: pt, ri: params[:ri]) do %>
      <span><%= t("sign.org.authentication.new.links.secret_credential") %></span>
    <% end %>

    <%= button_to continue_sign_org_social_authentication_path(provider: "google_org", ri: params[:ri]),
                  method: :post,
                  data: { turbo: false } do %>
      <span><%= t("sign.org.authentication.new.links.google") %></span>
    <% end %>

    <div>
      <%= link_to acme_org_root_path do %>
        <span><%= t("sign.org.authentication.new.back_to_root") %></span>
      <% end %>
    </div>
  </div>
</div>
