<% content_for :page_title, t("sign.app.authentication.email.edit.page_title") %>

<h1><%= t("sign.app.authentication.email.edit.page_title") %></h1>
<p><%= t("sign.app.authentication.email.edit.description") %></p>

<%= form_with model: @staff_email, url: sign_org_settings_emails_registration_path, method: :patch, scope: :staff_email do |form| %>
  <% if @staff_email.errors.any? %>
    <div>
      <ul role="list">
        <% @staff_email.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :pass_code, t("sign.app.authentication.email.edit.code_label") %>
    <%= form.text_field :pass_code,
                        placeholder: t("sign.app.authentication.email.edit.code_placeholder"),
                        autofocus: true,
                        autocomplete: "one-time-code",
                        inputmode: "numeric",
                        pattern: "[0-9]*" %>
  </div>

  <p><%= t("sign.app.authentication.email.edit.delivery_help") %></p>

  <div>
    <%= render "shared/cloudflare_turnstile_stealth" %>
  </div>

  <div>
    <%= form.submit t("sign.app.authentication.email.edit.submit") %>
  </div>
<% end %>

<div>
  <%= link_to t("sign.common.cancel"),
              acme_org_settings_emails_path(ri: params[:ri]) %>
</div>
