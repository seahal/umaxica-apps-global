<% content_for :page_title, t("sign.org.settings.show.page_title") %>

<h1><%= t("sign.org.settings.show.page_title") %></h1>
<p><%= t("sign.org.settings.show.description") %></p>

<section>
  <h2><%= t("sign.app.settings.show.security_settings") %></h2>
  <ul>
    <li><%= link_to t("controller.sign.app.setting.index.passkey"), sign_org_settings_passkeys_path %></li>
    <li><%= link_to t("controller.sign.app.setting.index.secret_credential"), sign_org_settings_secret_credentials_path %></li>
  </ul>
</section>

<section>
  <h2><%= t("sign.app.settings.show.account_settings") %></h2>
  <ul>
    <li><%= link_to t("controller.sign.app.setting.index.email"), sign_org_settings_emails_path %></li>
    <li><%= link_to t("controller.sign.app.setting.index.telephone"), acme_org_settings_telephones_path(ri: params[:ri]) %></li>
    <li><%= link_to t("controller.sign.app.setting.index.birthdate"), sign_org_settings_birthdate_path(ri: params[:ri]) %></li>
    <li><%= link_to t("controller.sign.app.setting.index.session"), sign_org_settings_sessions_path %></li>
    <li><%= link_to t("sign.settings.connections.index.page_title"), sign_org_settings_connections_path(ri: params[:ri]) %></li>
    <li><%= link_to t("controller.sign.app.setting.index.activity"), sign_org_settings_activities_path %></li>
  </ul>
</section>

<section>
  <h2><%= t("sign.app.settings.show.others") %></h2>
  <ul>
    <li><%= link_to t("sign.app.settings.show.logout"), edit_sign_org_sign_out_path(ri: params[:ri]) %></li>
    <li><%= link_to t("sign.org.settings.show.withdrawal"), sign_org_settings_withdrawal_path %></li>
    <li>
      <%= link_to t("sign.org.settings.show.operator_lifecycle_requests"),
                  sign_org_settings_operator_lifecycle_requests_path %>
    </li>
  </ul>
</section>
