<% content_for :page_title, t("sign.org.settings.operator_lifecycle_requests.index.title") %>

<h1><%= t("sign.org.settings.operator_lifecycle_requests.index.title") %></h1>

<p><%= t("sign.org.settings.operator_lifecycle_requests.index.description") %></p>

<p>
  <%= link_to t("sign.org.settings.operator_lifecycle_requests.index.new"),
              new_sign_org_settings_operator_lifecycle_request_path %>
</p>

<ul>
  <% @operator_lifecycle_requests.each do |request| %>
    <li>
      <%= link_to "#{request.action} / #{request.status}",
                  sign_org_settings_operator_lifecycle_request_path(request) %>
      <% if request.target_operator %>
        <span><%= request.target_operator.public_id %></span>
      <% elsif request.target_email.present? %>
        <span><%= request.target_email %></span>
      <% end %>
    </li>
  <% end %>
</ul>

<p>
  <%= link_to t("sign.org.settings.show.back"),
              sign_org_settings_path %>
</p>
