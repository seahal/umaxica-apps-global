<% content_for :page_title, t("sign.org.settings.telephone.edit.title") %>

<h1><%= t("sign.org.settings.telephone.edit.title") %></h1>

<p><%= @staff_telephone.number %></p>

<%= button_to t("sign.org.settings.telephone.index.delete"),
              acme_org_settings_telephone_url(
                @staff_telephone.id,
                ri: params[:ri],
                host: ENV.fetch("ACME_STAFF_URL", "www.org.localhost"),
              ),
              method: :delete,
              data: { turbo_confirm: t("sign.org.settings.telephone.index.delete_confirm") } %>

<div>
  <%= link_to t("sign.common.cancel"),
              acme_org_settings_telephones_path(ri: params[:ri]) %>
</div>
