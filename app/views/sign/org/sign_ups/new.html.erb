<% content_for :page_title, t("sign.org.ups.new.heading") %>
<div class="animate-fade-in-up">
  <div>
    <h1>
      <%= t("sign.org.ups.new.heading") %>
    </h1>
    <p>
      <%= t("sign.org.ups.new.description") %>
    </p>
  </div>

  <div>
    <% if @google_signup_enabled %>
      <%# TEMP(org-google-social-gateway): remove before production cleanup %>
      <%= button_to signup_sign_org_social_authentication_path(provider: "google_org", ri: params[:ri]),
                    method: :post,
                    data: { turbo: false } do %>
        <span><%= t("sign.org.authentication.new.links.google") %></span>
      <% end %>
    <% end %>

    <div>
      <p>
        <%= t("sign.org.ups.new.recruit_prompt") %>
      </p>
      <%= sign_org_recruit_contact_link %>
    </div>

    <div>
      <%= link_to acme_org_root_path do %>
        <span><%= t("sign.org.ups.new.back_to_root") %></span>
      <% end %>
    </div>
  </div>
</div>
