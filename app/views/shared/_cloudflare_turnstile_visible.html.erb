<% site_key = Rails.app.creds.option(:CLOUDFLARE_TURNSTILE_VISIBLE_SITE_KEY) %>
<% widget_id = "cf-turnstile-visible-#{SecureRandom.hex(8)}" %>
<% response_id = "#{widget_id}-response" %>

<div id="<%= widget_id %>" class="cf-turnstile" data-sitekey="<%= site_key %>"></div>
<input id="<%= response_id %>" type="hidden" name="cf-turnstile-response" autocomplete="off" />
<script>
  (function() {
    var rendered = false;
    var container = document.getElementById("<%= widget_id %>");
    var responseInput = document.getElementById("<%= response_id %>");

    function renderTurnstile() {
      if (rendered || !window.turnstile || !container || !responseInput) {
        return;
      }

      rendered = true;
      window.turnstile.render(container, {
        sitekey: container.dataset.sitekey,
        callback: function(token) {
          responseInput.value = token;
          window.dispatchEvent(
            new CustomEvent("turnstile:success", { detail: { widgetId: "<%= widget_id %>" } }),
          );
        },
        "error-callback": function(errorCode) {
          responseInput.value = "";
          console.error("Turnstile error occurred:", errorCode);
          window.dispatchEvent(
            new CustomEvent("turnstile:error", { detail: { errorCode: errorCode, widgetId: "<%= widget_id %>" } }),
          );
          return true;
        },
        "expired-callback": function() {
          responseInput.value = "";
          window.dispatchEvent(
            new CustomEvent("turnstile:expired", { detail: { widgetId: "<%= widget_id %>" } }),
          );
        },
        "timeout-callback": function() {
          responseInput.value = "";
          console.error("Turnstile challenge timed out");
          window.dispatchEvent(
            new CustomEvent("turnstile:timeout", { detail: { widgetId: "<%= widget_id %>" } }),
          );
        },
        "unsupported-callback": function() {
          responseInput.value = "";
          console.error("Turnstile client is unsupported");
          window.dispatchEvent(
            new CustomEvent("turnstile:unsupported", { detail: { widgetId: "<%= widget_id %>" } }),
          );
        },
      });
    }

    function scheduleRender() {
      if (rendered) {
        return;
      }

      renderTurnstile();
    }

    var apiScript = document.querySelector("script[src*='challenges.cloudflare.com/turnstile/v0/api.js']");
    if (apiScript) {
      apiScript.addEventListener("load", scheduleRender, { once: true });
      apiScript.addEventListener("error", function() {
        console.error("Turnstile script failed to load");
      }, { once: true });
    }

    document.addEventListener("turbo:load", scheduleRender, { once: true });

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", scheduleRender, { once: true });
    } else {
      scheduleRender();
    }
  })();
</script>
