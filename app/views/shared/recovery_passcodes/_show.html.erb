<h1><%= t("sign.recovery_passcodes.show.title", default: "Recovery passcodes") %></h1>

<% if @recovery_passcodes.present? %>
  <p><%= t("sign.recovery_passcodes.show.description", default: "Save these recovery passcodes now. They are shown only once.") %></p>
  <p><%= t("sign.recovery_passcodes.show.one_time_notice", default: "Only the newly generated passcodes are shown here.") %></p>
  <p><%= t("sign.recovery_passcodes.show.inventory_notice", default: "Existing saved recovery passcodes remain valid.") %></p>
  <ul>
    <% @recovery_passcodes.each do |recovery_passcode| %>
      <li><code><%= recovery_passcode %></code></li>
    <% end %>
  </ul>
<% else %>
  <p><%= t("sign.recovery_passcodes.show.missing", default: "These recovery passcodes are no longer available.") %></p>
<% end %>

<%= link_to t("sign.recovery_passcodes.show.back_to_settings", default: "Back to settings"), @back_to_settings_url %>
