<!DOCTYPE html>
<html lang="<%= get_language %>" data-theme="<%= theme_cookie_value %>" class="<%= theme_html_class %>">
<head>
  <meta charset="utf-8">
  <%= display_meta_tags site: "#{ENV.fetch("BRAND_NAME").upcase} (ORG)",
                        title: page_title(inertia_page&.dig(:props, :title)),
                        separator: "—",
                        reverse: true %>
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="turbo-refresh-method" content="morph">
  <meta name="turbo-refresh-scroll" content="preserve">
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <%# Inertia injects its progress bar as a <style> element built at runtime, and the Vite dev
      client injects its own. Both read the nonce from this tag, which is how they satisfy
      style-src-elem without the policy having to allow unsafe-inline. %>
  <meta property="csp-nonce" nonce="<%= content_security_policy_nonce %>">
  <%= vite_client_tag nonce: true %>
  <%= vite_react_refresh_tag nonce: true %>
  <%= vite_stylesheet_tag "~/styles/surfaces/auth_org.css", nonce: true %>
  <%= vite_typescript_tag "entrypoints/inertia/auth_org.tsx", nonce: content_security_policy_nonce, "data-turbo-eval": "false" %>
  <%= inertia_ssr_head %>
</head>
<body>
  <%= inertia_root %>
</body>
</html>
