<%
  tld = :com
  title_site = "#{ENV.fetch('BRAND_NAME', 'Umaxica')} (#{tld})"
%>
<!DOCTYPE html>
<html lang="<%= get_language %>" data-theme="<%= theme_cookie_value %>" class="<%= theme_html_class %>">
<head>
  <%= display_meta_tags site: title_site, title: page_title %>
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="turbo-refresh-method" content="morph">
  <meta name="turbo-refresh-scroll" content="preserve">
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <%= vite_client_tag %>
  <%= vite_typescript_tag "application", nonce: true, "data-turbo-eval": "false" %>
  <%= inertia_ssr_head %>
  <%= yield :head %>
</head>

<body class="font-mono bg-white text-black min-h-screen flex flex-col p-2">
  <div class="border-2 border-black flex-grow flex flex-col">
    <header class="border-b-2 border-black p-2">
      <nav class="flex flex-wrap gap-2 items-center justify-between mb-2 text-sm">
        <div class="flex gap-2">
          <%= render "layouts/shared/flash_messages" %>
          <%= render "layouts/shared/current_banner", tld: tld, domain: :sign, region: :global %>
        </div>
        <div class="flex gap-2">
          <% unless @hide_auth_navigation || content_for?(:nav_links) %>
            <% content_for :nav_links do %>
            <% if logged_in? %>
                <%= link_to t("sign.app.layout.nav.logout"), new_sign_com_sign_out_path %>
              <% else %>
                <%= link_to t("sign.app.layout.nav.sign_up"), sign_com_sign_up_url %>
                <%= link_to t("sign.app.layout.nav.log_in"), sign_com_sign_in_url %>
              <% end %>
            <% end %>
          <% end %>
          <%= yield :nav_links %>
        </div>
      </nav>
      <div class="flex items-center gap-2">
        <span class="bg-black text-white px-1 font-bold text-xs">SIGN</span>
        <h1 class="text-lg font-bold">
          <% content_for :root_link do %>
            <%= link_to ENV.fetch("BRAND_NAME", "Umaxica"), sign_com_root_path %>
          <% end %>
          <%= yield :root_link %>
          <span class="opacity-50 text-sm">(<%= tld %>)</span>
        </h1>
      </div>
    </header>

    <main class="p-2 flex-grow">
      <%= yield %>
    </main>

    <footer class="border-t-2 border-black p-2 text-xs">
      <nav class="mb-2">
        <% content_for :footer_links do %>
          <ul class="flex gap-4">
            <% if logged_in? %>
              <li><%= link_to t("sign.com.preferences.footer.dashboard"), sign_com_dashboard_url %></li>
            <% else %>
              <li><%= link_to t("sign.com.preferences.footer.home"), sign_com_root_url %></li>
            <% end %>
            <li><%= link_to t("sign.com.preferences.footer.preference"), acme_com_preference_url(host: ENV.fetch("ACME_CORPORATE_URL", "www.com.localhost")) %></li>
            <li><%= link_to t("sign.com.preferences.footer.settings"), sign_com_settings_url %></li>
          </ul>
        <% end %>
        <%= yield :footer_links %>
      </nav>
      <div class="flex flex-wrap justify-between items-end gap-2 border-t border-black pt-2">
        <div class="flex gap-4">
          <%= render "layouts/shared/footer_cookie_controls", scope: tld, acme_host: acme_authority_host %>
          <%= render "layouts/shared/footer_theme_controls", scope: tld %>
        </div>
        <div>
          <%= render "layouts/shared/copyright" %>
        </div>
      </div>
    </footer>
  </div>
</body>
</html>
