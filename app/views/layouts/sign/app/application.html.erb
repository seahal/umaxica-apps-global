<!DOCTYPE html>
<html lang="<%= get_language %>" data-theme="<%= theme_cookie_value %>" class="<%= theme_html_class %>">
<head>
  <%= display_meta_tags site: "#{ENV.fetch('BRAND_NAME', 'Umaxica')} (app)", title: page_title %>
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="turbo-refresh-method" content="morph">
  <meta name="turbo-refresh-scroll" content="preserve">
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
  <%= stylesheet_link_tag "sign/main", "data-turbo-track": "reload" %>
  <%= stylesheet_link_tag "sign/app/main", "data-turbo-track": "reload" %>
  <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
  <%= javascript_importmap_tags %>  <%= inertia_ssr_head %>
  <%= yield :head %>
</head>

<body>

<header>
  <nav>
    <%= render "layouts/shared/flash_messages" %>
    <%= render "layouts/shared/current_banner", tld: :app, domain: :sign, region: :global %>
    <% if logged_in? %>
      <%= link_to t("sign.app.layout.nav.logout"), edit_sign_app_configuration_out_url %>
    <% else %>
      <%= link_to t("sign.app.layout.nav.sign_up"), new_sign_app_up_url %>
      <%= link_to t("sign.app.layout.nav.log_in"), new_sign_app_in_url %>
    <% end %>
  </nav>
  <div>
    <span>Sign</span>
    <h1>
      <%= link_to ENV.fetch("BRAND_NAME", "Umaxica"), sign_app_root_path %>
      <span>(app)</span>
    </h1>
  </div>
</header>

<main>
  <%= yield %>
</main>

<footer>
  <nav>
    <ul>
      <li><%= link_to t("sign.app.preferences.footer.home"), sign_app_root_url %></li>
      <li><%= link_to t("sign.app.preferences.footer.preference"), sign_app_preference_url %></li>
      <li><%= link_to t("sign.app.preferences.footer.configuration"), sign_app_configuration_url %></li>
    </ul>
  </nav>
  <%= render "layouts/shared/footer_cookie_controls", scope: :app %>
  <%= render "layouts/shared/footer_theme_controls", scope: :app %>
  <div>
    <%= render "layouts/shared/copyright" %>
  </div>
</footer>
</body>
</html>
