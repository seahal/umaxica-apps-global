<!DOCTYPE html>
<html lang="<%= get_language %>" data-theme="<%= theme_cookie_value %>" class="<%= theme_html_class %>">
<head>
  <%= display_meta_tags site: "#{ENV.fetch('BRAND_NAME').upcase} (app)", title: page_title %>
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="turbo-refresh-method" content="morph">
  <meta name="turbo-refresh-scroll" content="preserve">
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <%= render "layouts/shared/cloudflare_turnstile_api" %>
  <%= vite_client_tag nonce: true %>
  <%= vite_react_refresh_tag nonce: true %>
  <%= vite_typescript_tag "entrypoints/acme/app", nonce: true, "data-turbo-eval": "false" %>
  <%= inertia_ssr_head %>
  <%= yield :head %>
</head>

<body>

<header>
  <nav>
    <%= render "layouts/shared/flash_messages" %>
    <%= render "layouts/shared/current_banner", tld: :app, domain: :acme, region: :global %>
    <% unless logged_in? %>
      <%= link_to t("sign.app.layout.nav.sign_up"),
                  acme_app_oidc_authorization_path(ri: params[:ri], screen_hint: "signup") %>
      <%= link_to t("sign.app.layout.nav.log_in"),
                  acme_app_oidc_authorization_path(ri: params[:ri], screen_hint: "signin") %>
    <% else %>
      <%= link_to t("sign.app.layout.nav.logout"), new_acme_app_sign_out_path %>
    <% end %>
  </nav>
  <div>
    <span>ACME</span>
    <h1>
      <a href="<%= "#{request.protocol}#{ENV.fetch('PUBLIC_BASE_SERVICE_URL')}#{request.port_string}/" %>"><%= ENV.fetch("BRAND_NAME") %></a>
      <span>(app)</span>
    </h1>
  </div>
</header>

<main>
  <%= yield %>
</main>

<footer>
  <nav>
    <ul>
      <li><a href="<%= "#{request.protocol}#{ENV.fetch('PUBLIC_BASE_SERVICE_URL')}#{request.port_string}/" %>"><%= t('acme.app.preferences.footer.home') %></a></li>
      <li><%= link_to t('acme.app.preferences.footer.preference'), acme_app_preference_url(host: ENV.fetch('PUBLIC_BASE_SERVICE_URL')) %></li>
    </ul>
  </nav>
  <%= render "layouts/shared/footer_cookie_controls", scope: :app %>
  <%= render "layouts/shared/footer_theme_controls", scope: :app %>
  <div>
    <%= render "layouts/shared/copyright" %>
  </div>
</footer>
</body>
</html>
