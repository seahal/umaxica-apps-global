<!DOCTYPE html>
<html lang="<%= get_language %>" data-theme="<%= theme_cookie_value %>" class="<%= theme_html_class %>">
<head>
  <%= display_meta_tags site: "#{ENV.fetch('BRAND_NAME', 'UMAXICA').upcase} (app)", title: page_title %>
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="turbo-refresh-method" content="morph">
  <meta name="turbo-refresh-scroll" content="preserve">
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
  <%= stylesheet_link_tag "acme/main", "data-turbo-track": "reload" %>
  <%= stylesheet_link_tag "acme/app/main", "data-turbo-track": "reload" %>
  <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
  <%= vite_javascript_tag "application", nonce: true, "data-turbo-eval": "false" %>
  <%= inertia_ssr_head %>
  <%= yield :head %>
</head>

<body>

<header>
  <nav>
    <%= render "layouts/shared/flash_messages" %>
    <%= render "layouts/shared/current_banner", tld: :app, domain: :acme, region: :global %>
    <% unless logged_in? %>
      <%= link_to "#{t('sign.app.layout.nav.sign_up')} / #{t('sign.app.layout.nav.log_in')}", acme_app_sso_authorization_path %>
    <% else %>
      <%= link_to t("sign.app.layout.nav.configuration"), sign_app_configuration_url(host: ENV.fetch('ID_SERVICE_URL', 'id.app.localhost')) %>
      <%= button_to t("sign.app.layout.nav.logout"), acme_app_sso_logout_path, method: :post %>
    <% end %>
  </nav>
  <div>
    <span>ACME</span>
    <h1>
      <a href="<%= "#{request.protocol}#{ENV.fetch('ACME_SERVICE_URL', 'app.localhost')}#{request.port_string}/" %>"><%= ENV.fetch("BRAND_NAME", "Umaxica") %></a>
      <span>(app)</span>
    </h1>
  </div>
</header>

<main>
  <%= yield %>
</main>

<footer>
  <nav>
    <ul>
      <li><a href="<%= "#{request.protocol}#{ENV.fetch('ACME_SERVICE_URL', 'app.localhost')}#{request.port_string}/" %>"><%= t('acme.app.preferences.footer.home') %></a></li>
      <li><%= link_to t('acme.app.preferences.footer.preference'), sign_app_preference_url(host: ENV.fetch('ID_SERVICE_URL', 'id.app.localhost')) %></li>
    </ul>
  </nav>
  <%= render "layouts/shared/footer_cookie_controls", scope: :app %>
  <%= render "layouts/shared/footer_theme_controls", scope: :app %>
  <div>
    <%= render "layouts/shared/copyright" %>
  </div>
</footer>
</body>
</html>
