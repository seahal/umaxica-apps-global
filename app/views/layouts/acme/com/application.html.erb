<!DOCTYPE html>
<html lang="<%= get_language %>" data-theme="<%= theme_cookie_value %>" class="<%= theme_html_class %>">
<head>
  <%= display_meta_tags site: "#{ENV.fetch('BRAND_NAME').upcase} (com)", title: page_title %>
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="turbo-refresh-method" content="morph">
  <meta name="turbo-refresh-scroll" content="preserve">
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <%= render "layouts/shared/cloudflare_turnstile_api" %>
  <%= vite_client_tag nonce: true %>
  <%= vite_react_refresh_tag nonce: true %>
  <%= vite_typescript_tag "entrypoints/acme/com", nonce: true, "data-turbo-eval": "false" %>
  <%= inertia_ssr_head %>
  <%= yield :head %>
</head>

<body>

<header>
  <nav>
    <%= render "layouts/shared/flash_messages" %>
    <%= render "layouts/shared/current_banner", tld: :com, domain: :acme, region: :global %>
    <% unless logged_in? %>
      <%= link_to "#{t('sign.app.layout.nav.sign_up')} / #{t('sign.app.layout.nav.log_in')}", acme_com_oidc_authorization_path %>
    <% else %>
      <%= link_to t("sign.app.layout.nav.logout"), new_acme_com_sign_out_path(ri: params[:ri]) %>
    <% end %>
  </nav>
  <div>
    <span>ACME</span>
    <h1>
      <a href="<%= "#{request.protocol}#{ENV.fetch('PUBLIC_BASE_CORPORATE_URL')}#{request.port_string}/" %>"><%= ENV.fetch("BRAND_NAME") %></a>
      <span>(com)</span>
    </h1>
  </div>
</header>

<main>
  <%= yield %>
</main>

<footer>
  <nav>
    <ul>
      <li><a href="<%= "#{request.protocol}#{ENV.fetch('PUBLIC_BASE_CORPORATE_URL')}#{request.port_string}/" %>"><%= t('acme.com.preferences.footer.home') %></a></li>
      <li><%= link_to t('acme.com.preferences.footer.preference'), acme_com_preference_url(host: ENV.fetch('PUBLIC_BASE_CORPORATE_URL')) %></li>
    </ul>
  </nav>
  <%= render "layouts/shared/footer_cookie_controls", scope: :com %>
  <%= render "layouts/shared/footer_theme_controls", scope: :com %>
  <div>
    <%= render "layouts/shared/copyright" %>
  </div>
</footer>
</body>
</html>
