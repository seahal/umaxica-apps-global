<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>Health Snapshot</title>
    <style>
      body { color: #202124; font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; line-height: 1.5; margin: 2rem; }
      main { max-width: 48rem; }
      dl { display: grid; grid-template-columns: max-content 1fr; gap: .5rem 1rem; }
      dt { font-weight: 700; }
      .checks { border-collapse: collapse; margin-top: 1rem; width: 100%; }
      .checks th, .checks td { border-bottom: 1px solid #d0d7de; padding: .5rem; text-align: left; }
    </style>
  </head>
  <body>
    <main>
      <h1>Health Snapshot</h1>
      <p>This page is a point-in-time health snapshot.</p>

      <dl>
        <dt>Status</dt>
        <dd><%= @health_report.status %></dd>
        <dt>Surface</dt>
        <dd><%= @health_report.profile.surface_label %></dd>
        <dt>Generated at</dt>
        <dd><time datetime="<%= @health_report.generated_at.iso8601(3) %>"><%= @health_report.generated_at.iso8601(3) %></time></dd>
        <% if @health_report.revision.present? %>
          <dt>Revision</dt>
          <dd><%= @health_report.revision %></dd>
        <% end %>
      </dl>

      <table class="checks">
        <thead>
          <tr>
            <th scope="col">Check</th>
            <th scope="col">Status</th>
          </tr>
        </thead>
        <tbody>
          <% @health_report.checks.each do |check| %>
            <tr>
              <td><%= check.kind %></td>
              <td><%= check.status %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </main>
  </body>
</html>
