#!/usr/bin/env ruby
# frozen_string_literal: true

require "pathname"

JAPANESE_TEXT = /[\u3040-\u30ff\u3400-\u4dbf\u4e00-\u9fff]/
PROSE_EXTENSIONS = %w[.md .mdc .txt .mmd].freeze
SOURCE_EXTENSIONS = %w[.rb .rake .js .jsx .ts .tsx].freeze
PROSE_ROOTS = %w[AGENTS.md .agents/harnesses adr docs plans notes memos].freeze
SOURCE_ROOTS = %w[app lib config db src spec test].freeze
ALLOW_NEXT_LINE = /\A\s*<!--\s*repository-language:\s*allow-next-line(?:\s+reason=(?<reason>[a-z0-9][a-z0-9-]*))?\s*-->\s*\z/
ALLOW_BEGIN = /\A\s*<!--\s*repository-language:\s*allow-begin(?:\s+reason=(?<reason>[a-z0-9][a-z0-9-]*))?\s*-->\s*\z/
ALLOW_END = /\A\s*<!--\s*repository-language:\s*allow-end\s*-->\s*\z/

def source_prose_line?(line)
  line.match?(/^\s*(?:#|\/\/|\/\*|\*)/) ||
    line.match?(/^\s*test\s+["'][^"']*[\u3040-\u30ff\u3400-\u4dbf\u4e00-\u9fff]/) ||
    line.match?(/^\s*(?:describe|context|it|test)\s*\(\s*["'][^"']*[\u3040-\u30ff\u3400-\u4dbf\u4e00-\u9fff]/)
end

def repository_files(root)
  prose = PROSE_ROOTS.flat_map do |entry|
    path = root.join(entry)
    path.file? ? [path] : path.glob("**/*").select(&:file?)
  end
  sources = SOURCE_ROOTS.flat_map do |entry|
    path = root.join(entry)
    path.directory? ? path.glob("**/*").select(&:file?) : []
  end

  (prose + sources).uniq.select do |path|
    PROSE_EXTENSIONS.include?(path.extname) || SOURCE_EXTENSIONS.include?(path.extname)
  end
end

root = Pathname.new(__dir__).join("..").expand_path
paths = if ARGV.empty?
  repository_files(root)
else
  ARGV.map { |argument| Pathname.new(argument).expand_path }
end

violations = []
configuration_errors = []

paths.sort.each do |path|
  unless path.file?
    configuration_errors << "#{path}: path is not a file"
    next
  end

  source_file = SOURCE_EXTENSIONS.include?(path.extname)
  allowed_block = false
  allow_next_line = false

  path.each_line.with_index(1) do |line, line_number|
    if (match = line.match(ALLOW_NEXT_LINE))
      configuration_errors << "#{path}:#{line_number}: exception requires a reason" unless match[:reason]
      allow_next_line = true
      next
    end

    if (match = line.match(ALLOW_BEGIN))
      configuration_errors << "#{path}:#{line_number}: exception requires a reason" unless match[:reason]
      configuration_errors << "#{path}:#{line_number}: nested exception block" if allowed_block
      allowed_block = true
      next
    end

    if line.match?(ALLOW_END)
      configuration_errors << "#{path}:#{line_number}: exception block is not open" unless allowed_block
      allowed_block = false
      next
    end

    allowed = allowed_block || allow_next_line
    allow_next_line = false
    next if allowed
    next unless line.match?(JAPANESE_TEXT)
    next if source_file && !source_prose_line?(line)

    violations << "#{path}:#{line_number}: #{line.strip}"
  end

  configuration_errors << "#{path}: exception block is not closed" if allowed_block
  configuration_errors << "#{path}: exception does not have a following line" if allow_next_line
end

if configuration_errors.any?
  puts configuration_errors
  exit 2
end

if violations.any?
  puts violations
  exit 1
end

exit 0
