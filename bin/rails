#!/usr/bin/env ruby
APP_PATH = File.expand_path("../config/application", __dir__)
require_relative "../config/boot"

if ENV["COVERAGE"] == "true" && ENV["SIMPLECOV_TEST_PROCESS"] != "true"
  ENV["SIMPLECOV_TEST_PROCESS"] = "true"

  require "simplecov"
  SimpleCov.start
end

require "rails/commands"
