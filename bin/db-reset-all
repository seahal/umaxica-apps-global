#!/usr/bin/env bash
# Drops, recreates, loads schema, and seeds all configured databases.
#
# Use this instead of `bin/rails db:migrate` while table renames or other
# schema-churn migrations are in flight. `db:migrate` runs incremental
# migrations against whatever state each DB happens to be in; if any
# migration left the DB in an unexpected intermediate state, the next
# migrate run silently drifts further. This script always rebuilds from
# the committed schema_dump files, so dev and test DBs match what CI sees.

set -euo pipefail

usage() {
  cat <<MSG
Usage: bin/db-reset-all [development|test|all]
  development  (default) reset dev DBs and seed
  test         reset test DBs (no seed)
  all          reset both dev and test
MSG
  exit 1
}

target="${1:-development}"

reset_env() {
  local env="$1"
  echo "==> RAILS_ENV=$env db:drop db:create db:schema:load"
  RAILS_ENV="$env" bin/rails db:drop db:create db:schema:load
  echo "==> RAILS_ENV=$env db:mark_schema_migrations"
  RAILS_ENV="$env" bin/rails db:mark_schema_migrations
  if [ "$env" = "development" ]; then
    echo "==> RAILS_ENV=$env db:seed"
    RAILS_ENV="$env" bin/rails db:seed
  fi
}

case "$target" in
  development|test)
    reset_env "$target"
    ;;
  all)
    reset_env development
    reset_env test
    ;;
  -h|--help)
    usage
    ;;
  *)
    echo "unknown target: $target" >&2
    usage
    ;;
esac

echo "done."
