#!/usr/bin/env bash
set -euo pipefail

readonly PROBE_IMAGE="docker.io/curlimages/curl:8.16.0@sha256:463eaf6072688fe96ac64fa623fe73e1dbe25d8ad6c34404a669ad3ce1f104b6"
readonly ORIGIN_PORT="${ORIGIN_PORT:-3000}"
readonly ORIGIN_HOSTS=(
  base.app.localhost
  base.com.localhost
  base.org.localhost
  base.net.localhost
  base.dev.localhost
  auth.app.localhost
  auth.com.localhost
  auth.org.localhost
  info.app.localhost
  info.com.localhost
  info.org.localhost
  core.app.localhost
  core.com.localhost
  core.org.localhost
  docs.app.localhost
  docs.com.localhost
  docs.org.localhost
  help.app.localhost
  help.com.localhost
  help.org.localhost
  news.app.localhost
  news.com.localhost
  news.org.localhost
  side.app.localhost
  side.com.localhost
  side.org.localhost
  palm.app.localhost
)

# cloudflare-tunnel is defined only in compose.custom.yaml (see
# docs/operations/cloudflare-private-origin.md); it does not exist in
# compose.yaml alone.
cloudflared_container="$(
  podman compose \
    -f compose.yaml \
    -f .devcontainer/compose.override.yml \
    -f compose.custom.yaml \
    ps -q cloudflare-tunnel
)"
if [[ -z "${cloudflared_container}" ]]; then
  echo "cloudflare-tunnel is not running; start the compose service before probing" >&2
  exit 1
fi

frontend_network="$(
  podman inspect "${cloudflared_container}" \
    --format '{{range $name, $_ := .NetworkSettings.Networks}}{{println $name}}{{end}}' |
    while IFS= read -r network; do
      logical_name="$(
        podman network inspect "${network}" \
          --format '{{index .Labels "com.docker.compose.network"}}'
      )"
      if [[ "${logical_name}" == "frontend" ]]; then
        printf '%s\n' "${network}"
      fi
    done
)"

if [[ -z "${frontend_network}" ]]; then
  echo "cloudflare-tunnel is not attached to the compose frontend network" >&2
  exit 1
fi

failures=0
for host in "${ORIGIN_HOSTS[@]}"; do
  if status="$(
    podman run --rm --network "${frontend_network}" "${PROBE_IMAGE}" \
      --fail --silent --show-error --output /dev/null --write-out '%{http_code}' \
      "http://${host}:${ORIGIN_PORT}/health"
  )" && [[ "${status}" == "200" ]]; then
    printf 'PASS transport %s -> HTTP %s\n' "${host}" "${status}"
  else
    printf 'FAIL transport %s -> HTTP %s\n' "${host}" "${status:-unreachable}" >&2
    failures=$((failures + 1))
  fi
done

if ((failures > 0)); then
  exit 1
fi
