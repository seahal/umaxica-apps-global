#!/usr/bin/env bash
set -euo pipefail

if (( EUID == 0 )) || [[ -n "${SUDO_UID:-}" || -n "${SUDO_USER:-}" ]]; then
  echo "error: run this command as the normal rootless Podman user" >&2
  exit 1
fi

umask 077
repo_root="$(git rev-parse --show-toplevel)"
secrets_dir="${repo_root}/.secrets"
mkdir -p "${secrets_dir}"
chmod 0700 "${secrets_dir}"

git check-ignore -q "${secrets_dir}/probe" || {
  echo "error: .secrets/ is not ignored by Git" >&2
  exit 1
}

for ignore_file in .containerignore .dockerignore; do
  grep -Fxq '.secrets/' "${repo_root}/${ignore_file}" || {
    echo "error: .secrets/ is missing from ${ignore_file}" >&2
    exit 1
  }
done

# Only locally generated, dev-only service passwords live here. User credentials for
# GitHub, Anthropic, and OpenAI are obtained through browser login and are not
# registered as Podman Secrets. The tunnel-scoped Cloudflare connector token is separate:
# it lives in the gitignored repository `.env` and is passed only to the tunnel sidecar.
declare -A generated=(
  [dev_postgres_writer]=postgres-writer
  [dev_postgres_reader]=postgres-reader
  [dev_postgres_replication]=postgres-replication
  [dev_email_hmac_salt]=email-hmac-salt
  [dev_telephone_hmac_salt]=telephone-hmac-salt
  [dev_enforcement_app_hmac]=enforcement-app-hmac
  [dev_enforcement_com_hmac]=enforcement-com-hmac
  [dev_enforcement_org_hmac]=enforcement-org-hmac
  [dev_flipper_ui_password]=flipper-ui-password
  [dev_rustfs_access_key]=rustfs-access-key
  [dev_rustfs_secret_key]=rustfs-secret-key
  [dev_rustfs_rpc_secret]=rustfs-rpc-secret
  [dev_tinyrdm_admin_password]=tinyrdm-admin-password
  [dev_grafana_admin_password]=grafana-admin-password
)

allowed='^(postgres-writer|postgres-reader|postgres-replication|email-hmac-salt|telephone-hmac-salt|enforcement-(app|com|org)-hmac|flipper-ui-password|rustfs-(access-key|secret-key|rpc-secret)|tinyrdm-admin-password|grafana-admin-password)$'
while IFS= read -r -d '' entry; do
  name="${entry##*/}"
  [[ "${name}" =~ ${allowed} ]] || {
    echo "error: unexpected entry in .secrets/: ${name}" >&2
    exit 1
  }
  [[ ! -L "${entry}" && -f "${entry}" ]] || {
    echo "error: ${name} must be a regular non-symbolic-link file" >&2
    exit 1
  }
done < <(find "${secrets_dir}" -mindepth 1 -maxdepth 1 -print0)

# 48 random bytes, base64. openssl is not a given: it is absent from a stock
# Fedora/RHEL workstation, and this script runs as the devcontainer
# initializeCommand on the *host*, so a missing binary aborts `devcontainer up`
# before anything is built. /dev/urandom and base64 (coreutils) are present
# wherever bash is, and are the same CSPRNG openssl would have read.
random_base64() {
  if command -v openssl >/dev/null 2>&1; then
    openssl rand -base64 48
  else
    head -c 48 /dev/urandom | base64
  fi
}

for secret_name in "${!generated[@]}"; do
  path="${secrets_dir}/${generated[${secret_name}]}"
  # -s, not -e: `openssl rand > path` (or any generator that fails after the
  # shell has already created the target) leaves a zero-byte file behind, and
  # an -e test would then accept it forever. `podman secret create` rejects an
  # empty file, so the failure resurfaces on every later run with a message
  # that says nothing about where the empty file came from.
  if [[ ! -s "${path}" ]]; then
    random_base64 >"${path}"
  fi
done

register_secret() {
  local secret_name="$1" path="$2"
  [[ ! -L "${path}" && -f "${path}" ]] || return 1
  chmod 0600 "${path}"
  podman secret create --replace "${secret_name}" "${path}" >/dev/null
  printf 'registered: %s\n' "${secret_name}"
}

for secret_name in "${!generated[@]}"; do
  register_secret "${secret_name}" "${secrets_dir}/${generated[${secret_name}]}"
done

# The Codex App's PUBLIC key for the opt-in remote-access path
# (docs/operations/remote-codex-over-tailscale.md). This is not a Podman Secret and
# not a credential -- it is created here only so the read-only bind mount in
# compose.custom.yaml always has a FILE as its source. Podman invents a directory
# when a bind source is missing, and every `up` then fails for developers who do
# not use remote access at all. Left empty, it is inert: core-entrypoint only reads
# it when REMOTE_SSHD=1, and refuses to start sshd while it is empty.
codex_authorized_keys="${secrets_dir}/codex_authorized_keys"
if [[ ! -e "${codex_authorized_keys}" ]]; then
  : >"${codex_authorized_keys}"
fi
chmod 0600 "${codex_authorized_keys}"
