#!/usr/bin/env ruby
# frozen_string_literal: true

ENV["RAILS_ENV"] = "test"

require_relative "../config/environment"
require "digest"
require "pg"
require "set"

unless ARGV.include?("--confirm")
  warn "This command drops and recreates only parallel test worker clone databases."
  warn "It never drops development, production, or base test databases."
  warn "Run with --confirm after reviewing the target list."
  warn
end

workers =
  if ENV["COVERAGE"] == "true"
    1
  else
    Integer(ENV.fetch("PARALLEL_WORKERS", "16"), 10)
  end
raise "PARALLEL_WORKERS must be positive" unless workers.positive?

configs = ActiveRecord::Base.configurations.configs_for(env_name: "test", include_hidden: true)
databases = configs.map(&:database).uniq.sort
targets = databases.flat_map { |database| workers.times.map { |worker| "#{database}_#{worker}" } }.sort
schema_sha_by_database = configs.to_h do |config|
  schema_path = ActiveRecord::Tasks::DatabaseTasks.schema_dump_path(config, config.schema_format)
  [config.database, File.exist?(schema_path) ? Digest::SHA1.file(schema_path).hexdigest : nil]
end

first_config = configs.first.configuration_hash

ActiveRecord::Base.connection_handler.clear_all_connections!

admin_connection = PG.connect(
  host: first_config.fetch(:host),
  port: first_config.fetch(:port, 5432),
  user: first_config.fetch(:username),
  password: first_config[:password],
  dbname: ENV.fetch("POSTGRESQL_DATABASE", "db"),
)

existing = admin_connection.exec("select datname from pg_database").map { |row| row.fetch("datname") }.to_set
missing_base = databases.reject { |database| existing.include?(database) }
unless missing_base.empty?
  abort "Missing base test DBs: #{missing_base.join(', ')}. Run RAILS_ENV=test bin/rails db:test:prepare first."
end

puts "parallel test worker clone rebuild targets:"
targets.each { |database| puts "  #{database}" }

unless ARGV.include?("--confirm")
  warn
  abort "No databases were changed. Re-run with --confirm to rebuild these test worker clones."
end

def quote(connection, identifier)
  connection.quote_ident(identifier)
end

def set_schema_sha(config, database, schema_sha)
  return unless schema_sha

  connection = PG.connect(
    host: config.fetch(:host),
    port: config.fetch(:port, 5432),
    user: config.fetch(:username),
    password: config[:password],
    dbname: database,
  )
  table_exists = connection.exec("select to_regclass('public.ar_internal_metadata') is not null as present").first.fetch("present")
  return unless table_exists == "t"

  connection.exec_params(<<~SQL, [schema_sha])
    insert into ar_internal_metadata (key, value, created_at, updated_at)
    values ('schema_sha1', $1, current_timestamp, current_timestamp)
    on conflict (key) do update set value = excluded.value, updated_at = excluded.updated_at
  SQL
ensure
  connection&.close
end

targets.each do |database|
  next unless existing.include?(database)

  admin_connection.exec_params(
    "select pg_terminate_backend(pid) from pg_stat_activity where datname = $1 and pid <> pg_backend_pid()",
    [database],
  )

  begin
    admin_connection.exec("drop database if exists #{quote(admin_connection, database)} with (force)")
  rescue PG::SyntaxError
    admin_connection.exec("drop database if exists #{quote(admin_connection, database)}")
  end
end

databases.each do |database|
  workers.times do |worker|
    clone = "#{database}_#{worker}"
    admin_connection.exec("create database #{quote(admin_connection, clone)} template #{quote(admin_connection, database)}")
    set_schema_sha(first_config, clone, schema_sha_by_database.fetch(database))
  end
end

admin_connection.close

puts "rebuilt #{targets.size} parallel test worker clone databases"
