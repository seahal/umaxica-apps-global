#!/usr/bin/env ruby
# frozen_string_literal: true

ENV["RAILS_ENV"] = "test"

require_relative "../config/environment"
require "resolv"
require "pg"

workers =
  if ENV["COVERAGE"] == "true"
    1
  else
    Integer(ENV.fetch("PARALLEL_WORKERS", "16"), 10)
  end

configs = ActiveRecord::Base.configurations.configs_for(env_name: "test", include_hidden: true)
first_config = configs.first.configuration_hash
pools = configs.map { |config| config.configuration_hash[:pool] }.uniq.sort
hosts = configs.map { |config| config.configuration_hash[:host] }.uniq.sort
databases = configs.map(&:database).uniq.sort
failures = []

def status(label, failures)
  print "#{label}: "
  yield
rescue StandardError => e
  failures << label
  puts "FAIL #{e.class}: #{e.message}"
end

puts "Rails test doctor"
puts "workers=#{workers} roles=#{configs.size} databases=#{databases.size} pools=#{pools.inspect}"

status("host resolution", failures) do
  hosts.each { |host| Resolv.getaddress(host) }
  puts "ok #{hosts.join(', ')}"
end

status("postgres connection", failures) do
  PG.connect(
    host: first_config.fetch(:host),
    port: first_config.fetch(:port, 5432),
    user: first_config.fetch(:username),
    password: first_config[:password],
    dbname: ENV.fetch("POSTGRESQL_DATABASE", "db"),
  ).close
  puts "ok"
end

status("tmp/log writable", failures) do
  %w[tmp log].each do |path|
    raise "#{path} is not writable" unless File.writable?(path)
  end
  puts "ok"
end

status("schema dump files", failures) do
  dump_paths = configs.filter_map(&:schema_dump).uniq
  missing = dump_paths.reject { |path| File.exist?(File.join("db", path)) }
  tiny = dump_paths.select do |path|
    full_path = File.join("db", path)
    File.exist?(full_path) && File.size(full_path) < 1024
  end
  raise "missing: #{missing.join(', ')}" unless missing.empty?
  raise "suspiciously small: #{tiny.join(', ')}" unless tiny.empty?
  puts "ok #{dump_paths.size}"
end

status("migration context", failures) do
  ActiveRecord::Tasks::DatabaseTasks.with_temporary_pool_for_each(env: "test") do |pool|
    next if pool.db_config.replica?

    pending = pool.migration_context.open.pending_migrations
    raise "#{pool.db_config.name}: #{pending.size} pending" unless pending.empty?
  end
  puts "ok"
end

status("parallel clone preflight", failures) do
  system({ "RAILS_ENV" => "test", "PARALLEL_WORKERS" => workers.to_s }, "bin/test-db-preflight")
  raise "bin/test-db-preflight failed" unless $?.success?
  puts "ok"
end

exit failures.empty? ? 0 : 1
