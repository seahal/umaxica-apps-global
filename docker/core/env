# Productivity
COLORTERM=truecolor
# App Configuration
BRAND_NAME=UMAXICA
# Ruby Configuration
RUBY_PATH=/usr/local/bin/ruby
# BUNDLE
BUNDLE_PATH=vendor/bundle
# Rails Configuration
RAILS_ENV=development
RACK_ENV=development
PORT=3000
BINDING=0.0.0.0
OPEN_TELEMETRY=false
# Node Environment
NODE_ENV=development
# Database Configuration
## Redis (use local Redis service inside Compose)
VALKEY_URL=redis://valkey:6379/0
RATE_LIMIT_REDIS_URL=redis://valkey:6379/1
REDIS_NORMAL_URL=redis://valkey:6379/7
## PostgreSQL (use local PostgreSQL services inside Compose)
# Compose injects POSTGRESQL_PASSWORD from the host environment, with a local-only default.
POSTGRESQL_USER=root
POSTGRESQL_PORT=5432
POSTGRESQL_HOST=primary
POSTGRESQL_OCCURRENCE_PUB=primary
POSTGRESQL_OCCURRENCE_SUB=replica
