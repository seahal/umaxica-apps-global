# User-level systemd unit TEMPLATE for Claude Code Remote Control inside `core`.
#
# NOT installed automatically. This file must never be placed under /etc or
# enabled as a system unit. Copy it to a real unit file, edit the two
# CHANGEME_ values below for your host, then follow the manual install steps in
# docs/operations/claude-remote-control.md — installing, reloading the user
# systemd manager, enabling the unit, enabling lingering, and performing the
# reboot test are all actions you run yourself, never automated from inside the
# container.
#
# WS3B only: deliberately independent of direct-core Tailscale access (WS3A) —
# Remote Control needs outbound HTTPS to api.anthropic.com only, no inbound SSH
# and no Tailscale network. Do not add a dependency on the development
# container here.
#
# No secrets belong in this file. Authentication is the OAuth session already
# established by `claude auth login` inside `core` (state lives under the
# existing bind-mounted ~/.claude and ~/.claude.json paths — see
# .devcontainer/devcontainer.json), referenced only, never embedded here.

[Unit]
Description=Claude Code Remote Control (Umaxica core devcontainer)
After=network-online.target
Wants=network-online.target
# If you also enable podman-restart.service for reboot recovery (see
# docs/operations/remote-codex-over-tailscale.md and
# plans/umaxica-rails-expressive-dewdrop.md), consider ordering after it too:
# After=network-online.target podman-restart.service

[Service]
Type=simple
Environment=UMAXICA_WORKSPACE_FOLDER=CHANGEME_ABSOLUTE_PATH_TO_REPO_ON_HOST
Environment=UMAXICA_REMOTE_CONTROL_HEALTH_TIMEOUT=180
# systemd --user services often start with a minimal PATH that does not include
# where the `devcontainer` CLI is installed (e.g. an npm global bin directory).
# If the unit fails with "devcontainer: command not found", uncomment and fix:
# Environment=PATH=CHANGEME_DIRECTORY_CONTAINING_DEVCONTAINER_CLI:/usr/bin:/bin
ExecStart=CHANGEME_ABSOLUTE_PATH_TO_REPO_ON_HOST/docker/remote-control/bin/start-remote-control.sh
Restart=always
RestartSec=10
# claude remote-control exits after roughly 10 minutes of unreachable network
# (documented upstream behavior) or when the local process is otherwise
# interrupted. Restart=always is required so the session recovers automatically
# instead of requiring a manual re-run.
StandardOutput=journal
StandardError=journal
SyslogIdentifier=claude-remote-control

[Install]
WantedBy=default.target
