{
  "name": "umaxica-app-jit",
  "private": true,
  "type": "module",
  "module": "index.ts",
  "scripts": {
    "prepare": "lefthook install",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt src spec vite.config.ts vitest.config.ts tsconfig.json tsconfig.app.json tsconfig.node.json package.json pnpm-workspace.yaml lefthook.yml .oxfmtrc.json .oxlintrc.json",
    "format:check": "oxfmt --check src spec vite.config.ts vitest.config.ts tsconfig.json tsconfig.app.json tsconfig.node.json package.json pnpm-workspace.yaml lefthook.yml .oxfmtrc.json .oxlintrc.json",
    "typecheck": "tsc --noEmit",
    "check": "pnpm -s format:check && pnpm -s lint && pnpm -s typecheck",
    "ci": "pnpm -s check && pnpm -s test:coverage",
    "ci:js": "pnpm -s run ci",
    "fix": "pnpm -s format && pnpm -s lint:fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@hotwired/stimulus": "^3.2.2",
    "@hotwired/turbo-rails": "^8.0.23",
    "@inertiajs/react": "^3.6.1",
    "@inertiajs/vite": "^3.6.1",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  },
  "devDependencies": {
    "@mermaid-js/mermaid-cli": "^11.16.0",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "dependency-cruiser": "^17.4.3",
    "jsdom": "^29.1.1",
    "lefthook": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "playwright": "^1.61.1",
    "vite": "8.1.4",
    "vite-plugin-ruby": "^5.2.2",
    "vitest": "4.1.10"
  },
  "packageManager": "pnpm@11.1.3"
}
