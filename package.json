{
  "name": "umaxica-app-jit",
  "private": true,
  "type": "module",
  "module": "index.ts",
  "scripts": {
    "prepare": "lefthook install",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt src spec e2e vite.config.ts vitest.config.ts playwright.config.ts tsconfig.json tsconfig.app.json tsconfig.node.json package.json pnpm-workspace.yaml lefthook.yml .oxfmtrc.json .oxlintrc.json",
    "format:check": "oxfmt --check src spec e2e vite.config.ts vitest.config.ts playwright.config.ts tsconfig.json tsconfig.app.json tsconfig.node.json package.json pnpm-workspace.yaml lefthook.yml .oxfmtrc.json .oxlintrc.json",
    "typecheck": "tsc --noEmit",
    "check": "pnpm -s format:check && pnpm -s lint && pnpm -s typecheck",
    "ci": "pnpm -s check && pnpm -s test:coverage",
    "ci:js": "pnpm -s run ci",
    "fix": "pnpm -s format && pnpm -s lint:fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@hotwired/stimulus": "^3.2.2",
    "@hotwired/turbo-rails": "^8.0.23",
    "@inertiajs/react": "^3.6.1",
    "@inertiajs/vite": "^3.6.1",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  },
  "devDependencies": {
    "@mermaid-js/mermaid-cli": "^11.16.0",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "dependency-cruiser": "^18.1.1",
    "jsdom": "^30.0.1",
    "lefthook": "catalog:",
    "linkinator": "^8.0.3",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "playwright": "^1.62.1",
    "vite": "8.2.0",
    "vite-plugin-ruby": "^5.2.2",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=24.19.0 <25",
    "pnpm": ">=11.20.0"
  },
  "packageManager": "pnpm@11.20.0+sha512.9a6f330a95b66446ea088faf1521405a8a01f07fde7124cc9958dfed52d4bb436737e65b08f85f37b46fcba375092558ac51262b816844b22f63406ed166bfee"
}
