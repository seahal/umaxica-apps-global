{
  "name": "umaxica-app-jit",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "lefthook install",
    "dev": "vite dev",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt src spec e2e app/views/pwa *.ts *.json *.yaml *.yml",
    "format:check": "oxfmt --check src spec e2e app/views/pwa *.ts *.json *.yaml *.yml",
    "typecheck": "tsc --build",
    "build": "NODE_ENV=production vite build --mode production",
    "check": "pnpm -s format:check && pnpm -s lint && pnpm -s typecheck:verify && pnpm -s typecheck && pnpm -s deadcode && pnpm -s openapi:lint && pnpm -s openapi:verify",
    "ci": "pnpm -s check && pnpm -s test:coverage && pnpm -s build",
    "ci:js": "pnpm -s run ci",
    "fix": "pnpm -s format && pnpm -s lint:fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "deadcode": "knip",
    "typecheck:verify": "tsc -p tsconfig.app.json --noEmit --listFiles | grep -q '/src/' || (echo 'typecheck covered no source files' >&2 && exit 1)",
    "openapi:lint": "redocly lint",
    "openapi:bundle": "redocly bundle",
    "openapi:verify": "pnpm -s openapi:bundle && git diff --exit-code -- public/openapi.app.yml public/openapi.com.yml public/openapi.org.yml"
  },
  "dependencies": {
    "@hotwired/stimulus": "^3.2.2",
    "@hotwired/turbo-rails": "^8.0.23",
    "@inertiajs/core": "3.7.0",
    "@inertiajs/react": "^3.7.0",
    "@inertiajs/vite": "^3.7.0",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "react": "^19.2.8",
    "react-aria-components": "^1.20.0",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  },
  "devDependencies": {
    "@redocly/cli": "^2.47.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.5",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "jsdom": "^30.0.1",
    "knip": "^6.32.2",
    "lefthook": "catalog:",
    "linkinator": "^8.0.4",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "playwright": "^1.62.1",
    "tailwindcss-react-aria-components": "^2.2.0",
    "vite": "8.2.1",
    "vite-plugin-ruby": "^5.2.2",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=24.19.0 <25",
    "pnpm": ">=11.22.0"
  },
  "packageManager": "pnpm@11.22.0+sha512.1ff870c4c6133dfd88fb2afc46dd13d47f09c9794b438c6fdb47ca98caf3bc16381ee0be93a091b8e3824cf01f889f46d7d9e20910fb0be1ab0fb5baa80dd621"
}
