---
# An EXAMPLE of the optional developer-local Compose override.
#
#   compose.yaml                      = the complete standard environment
#   .devcontainer/compose.yaml = tracked; the Dev Container's own overlay
#   compose.override.yaml             = optional, gitignored, yours
#   compose.override.yaml.example     = this file; documentation only
#
# You do NOT need to copy this file. A fresh clone starts without it:
#
#   git clone ...
#   cd umaxica-apps-global
#   docker compose config      # resolves as-is
#
# Copy it only if you want one of the machine-specific things below:
#
#   cp compose.override.yaml.example compose.override.yaml
#
# `docker compose` / `podman compose` auto-discover `compose.override.yaml` when
# no `-f` is given. `.devcontainer/devcontainer.json` names its files explicitly,
# so the Dev Containers CLI passes `-f` and this override is NOT loaded there.
#
# Never put a secret in here, and never a `${VAR:?}` -- Compose interpolates the
# whole file whichever service is named, so a required variable stops every
# command, including ones for services you never start.

# Must match `compose.yaml`'s `name:`. Compose takes the project name from the
# LAST file that sets one, so a different value forks the project: a second set
# of containers and, worse, a second set of named volumes -- the development
# PostgreSQL, Valkey, bundle and node_modules would all be orphaned.
name: umaxica-apps-global-dc

services: {}

# Root Compose intentionally has no Rails service. To customize Dev Container core,
# create a separate local overlay in the Dev Containers UI or edit the tracked
# .devcontainer/compose.yaml; do not add core back to this root override.

# The Cloudflare Tunnel connectors are NOT here. They live in `compose.yaml`.
# The primary connector (`cloudflare-tunnel`) starts with the stack and reads
# CLOUDFLARED_TOKEN from the gitignored root `.env`. The alternative tunnel
# stays opt-in:
#
#   docker compose --profile tunnel-edge up -d   # CLOUDFLARED_EDGE_TOKEN
#
# Remote SSH / Tailscale access is likewise a tracked, opt-in file rather than a
# local one: `compose.remote-access.yaml`.
