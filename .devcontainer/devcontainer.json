{
  "name": "umaxica-apps-global-dc",
  "dockerComposeFile": ["../compose.yaml", "./compose.override.yml", "../compose.custom.yaml"],
  "service": "core",
  "remoteUser": "global",
  "containerUser": "global",
  "workspaceFolder": "/home/global/workspace",
  "overrideCommand": false,
  "postCreateCommand": "bundle install && pnpm install && bin/rails db:prepare",
  "forwardPorts": [3000, 3036, 5050],
  "remoteEnv": {
    "EDITOR": "code --wait --reuse-window",
    "DEBUGGER_DISABLE": "1",
    "TERM": "xterm-256color",
    "COLORTERM": "${localEnv:COLORTERM}",
    "PATH": "/home/global/.local/bin:${containerEnv:PATH}"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "Shopify.ruby-lsp",
        "bradlc.vscode-tailwindcss",
        "ms-azuretools.vscode-docker",
        "GitHub.vscode-pull-request-github",
        "ms-vscode.remote-explorer",
        "rubocop.vscode-rubocop",
        "openai.chatgpt",
        "anthropic.claude-code",
        "anthropic.claude-code",
        "-sorbet.sorbet-vscode-extension",
        "-dbaeumer.vscode-eslint",
        "-esbenp.prettier-vscode",
        "-eamodio.gitlens",
        "-KoichiSasada.vscode-rdbg",
        "-sorbet.sorbet-vscode-extension",
        "-GitHub.copilot",
        "-GitHub.copilot-chat"
      ],
      "settings": {
        "extensions.verifySignature": false,
        "terminal.integrated.defaultProfile.linux": "bash",
        "terminal.integrated.profiles.linux": {
          "bash": { "path": "/bin/bash" },
          "zsh": { "path": "/bin/zsh" }
        },
        "editor.formatOnSave": true,
        "editor.tabSize": 2,
        "files.trimTrailingWhitespace": true,
        "files.insertFinalNewline": true,
        "editor.codeActionsOnSave": {
          "source.fixAll.eslint": "explicit",
          "source.fixAll": "explicit"
        },
        "files.associations": {
          "*.erb": "erb",
          "Procfile*": "shellscript",
          "compose.yaml": "yaml",
          "*.yml": "yaml"
        },
        "[ruby]": { "editor.defaultFormatter": "Shopify.ruby-lsp" },
        "[javascript]": { "editor.defaultFormatter": "voidzero.oxfmt" },
        "[typescript]": { "editor.defaultFormatter": "voidzero.oxfmt" },
        "ruby.lsp.enabledFeatures": {
          "codeActions": true,
          "diagnostics": true,
          "documentHighlights": true,
          "documentLink": true,
          "documentSymbols": true,
          "foldingRanges": true,
          "formatting": true,
          "hover": true,
          "inlayHint": true,
          "onTypeFormatting": true,
          "selectionRanges": true,
          "semanticHighlighting": true,
          "completion": true,
          "codeLens": true,
          "definition": true,
          "workspaceSymbol": true,
          "signatureHelp": true,
          "typeHierarchy": true
        },
        "ruby.lint": { "rubocop": true }
      }
    },
    "jetbrains": {
      "remoteId": "intellij",
      "backend": "intellij",
      "plugins": ["org.jetbrains.plugins.ruby"],
      "containerEnv": { "DEVCONTAINER_IDE": "jetbrains" }
    }
  },
  "shutdownAction": "stopCompose",
  "updateRemoteUserUID": false,
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/jsburckhardt/devcontainer-features/herdr:1": { "VERSION": "v0.8.0" },
    "ghcr.io/srzstephen/devcontainer-features/claude-code:1": {},
    "ghcr.io/nolanjx/devcontainer-features/codex:1": {}
  }
}
