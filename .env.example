# Optional local RustFS profile. Copy these examples to the ignored .env file
# and replace both secrets with distinct development-only values.
OBJECT_STORAGE_BUCKET=umaxica-development
OBJECT_STORAGE_ACCESS_KEY_ID=umaxica-development
OBJECT_STORAGE_SECRET_ACCESS_KEY=replace-with-a-local-development-secret
RUSTFS_RPC_SECRET=replace-with-a-different-local-rpc-secret

# Loopback ports published by the devcontainer Compose override.
RUSTFS_API_HOST_PORT=9000
RUSTFS_CONSOLE_HOST_PORT=9001
