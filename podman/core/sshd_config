# OpenSSH server configuration for the development container's remote-access path
# (Codex App -> tailscale sidecar -> tailnet TCP/22 -> core:2222). Loaded only when
# REMOTE_SSHD=1 (podman/core/entrypoint.sh); the production image has no sshd.
# See docs/operations/remote-codex-over-tailscale.md.

# 2222, not 22: this sshd runs as the unprivileged `global` user because `core` has
# no root and no sudo, and an unprivileged process cannot bind a privileged port. The
# tailnet-facing port is still 22; the sidecar's TCPForward bridges the two. This port
# is never published to the host and is reachable only on the `remote-access` network.
Port 2222
AddressFamily inet

# Every path below is owned by `global`. The host key lives on a named volume so the
# client's known_hosts entry survives container recreation; it is never baked into the
# image. PidFile sits under the already-normalized workspace tmp/pids directory.
HostKey /home/global/.local/state/umaxica-sshd/ssh_host_ed25519_key
PidFile /home/global/workspace/tmp/pids/sshd.pid

# Authentication: public key only, single user.
AllowUsers global
PermitRootLogin no
PubkeyAuthentication yes
AuthenticationMethods publickey
PasswordAuthentication no
KbdInteractiveAuthentication no
# PAM would require root to open a session, which this sshd does not have.
UsePAM no
# Read-only bind mount outside the workspace on purpose, so nothing writable from a
# development shell can grant new access to itself.
AuthorizedKeysFile /home/global/.config/umaxica/authorized_keys
StrictModes yes

# Surface reduction. The Codex App needs a shell and a filesystem, nothing else; in
# particular no forwarding, so this sshd can never become a pivot into the Podman
# networks that carry PostgreSQL, Valkey, and Kafka.
AllowAgentForwarding no
AllowTcpForwarding no
AllowStreamLocalForwarding no
X11Forwarding no
PermitTunnel no
GatewayPorts no
PermitUserEnvironment no
PermitTTY yes

# Never log the key material itself; VERBOSE records the key fingerprint and outcome,
# which is what identifies a session.
LogLevel VERBOSE
ClientAliveInterval 60
ClientAliveCountMax 3
