#!/usr/bin/env bash
set -euo pipefail

if (( EUID == 0 )) || [[ -n "${SUDO_UID:-}" || -n "${SUDO_USER:-}" ]]; then
  echo "error: run this command as the normal rootless Podman user" >&2
  exit 1
fi

repo_root="$(git rev-parse --show-toplevel)"
container_engine="/usr/bin/podman"
compose_provider="/usr/bin/podman-compose"

if [[ ! -x "${container_engine}" ]]; then
  echo "error: rootless container engine is not executable: ${container_engine}" >&2
  exit 1
fi

if [[ ! -x "${compose_provider}" ]]; then
  echo "error: Podman Compose provider is not executable: ${compose_provider}" >&2
  exit 1
fi

"${repo_root}/bin/setup-dev-secrets"

# A failed Compose start can leave the labeled Dev Container in Created or
# Exited state. The Dev Containers CLI otherwise treats that partial container
# as reusable and adds `compose up --no-recreate`, preventing corrected service
# and health-check configuration from taking effect. Remove only that partial
# Dev Container by its stable Compose name before invoking the CLI. Named
# volumes, other services, and a successfully running core are kept.
if "${container_engine}" container exists global-devcontainer-core; then
  core_running="$("${container_engine}" inspect --format '{{.State.Running}}' global-devcontainer-core)"
  if [[ "${core_running}" != "true" ]]; then
    echo "recovering incomplete Dev Container: global-devcontainer-core" >&2
    "${container_engine}" rm --force --ignore global-devcontainer-core >/dev/null
  fi
fi

export PODMAN_COMPOSE_PROVIDER="${compose_provider}"
exec devcontainer up \
  --docker-path "${container_engine}" \
  --docker-compose-path "${compose_provider}" \
  --workspace-folder "${repo_root}" \
  "$@"
