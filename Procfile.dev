web: rm -f tmp/pids/server.pid && OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318 exec bundle exec rails server -b 0.0.0.0 -p ${PORT:-3000}
css: BUNDLE_FORCE_RUBY_PLATFORM=false exec bin/rails "tailwindcss:watch[always]"
job: OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318 exec bin/jobs start
vite: exec ./node_modules/.bin/vite --host 0.0.0.0 --port 3036 --strictPort
